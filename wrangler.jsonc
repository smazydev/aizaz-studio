{
	"main": "dist/_worker.js/index.js",
	"name": "aizaz-studio",
  "compatibility_date": "2026-01-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aizaz-studio-blog",
			"database_id": "local-dev-placeholder"
		}
	],
	"r2_buckets": [
		{
			"binding": "BLOG_IMAGES",
			"bucket_name": "aizaz-blog-images"
		}
	],
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"routes": [
		{
			"pattern": "aizaz.studio",
			"custom_domain": true
		},
		{
			"pattern": "www.aizaz.studio",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"observability": {
    "enabled": true
  }
}
