{
	"main": "dist/_worker.js/index.js",
	"name": "aizaz-studio",
	"compatibility_date": "2026-01-06",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"html_handling": "drop-trailing-slash",
		// Asset-first for prerendered marketing HTML (fast edge serve).
		// Worker-first only for SSR/CMS routes that must not be shadowed by Assets.
		// Canonical www/http redirects for static HTML: configure at the Cloudflare zone
		// (Always Use HTTPS + www→apex Redirect Rule), not via run_worker_first.
		"run_worker_first": [
			"/blog",
			"/blog/*",
			"/case-studies",
			"/case-studies/*",
			"/api/*",
			"/sitemap.xml"
		]
	},
	"routes": [
		{
			"pattern": "aizaz.studio",
			"custom_domain": true
		},
		{
			"pattern": "www.aizaz.studio",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	// Workers Cache sits in front of the Worker. Required for Cache-Control on SSR
	// HTML to skip Worker/Sanity on subsequent anonymous requests.
	"cache": {
		"enabled": true
	},
	"observability": {
		"enabled": true
	}
}
