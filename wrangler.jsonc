{
	"main": "dist/_worker.js/index.js",
	"name": "aizaz-studio",
	"compatibility_date": "2026-01-06",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Astro sessions require a Cloudflare KV namespace bound as SESSION.
	// This project does not have a real SESSION namespace created yet.
	// Create it in Cloudflare, then replace the placeholder below with the namespace ID.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "7f940579e5d54a0481aef7c7b601497a"
		}
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"html_handling": "drop-trailing-slash"
		// Host normalization (www→apex, HTTP→HTTPS) is handled at Cloudflare zone level.
		// Do not set run_worker_first globally — prerendered Assets should serve directly.
	},
	"routes": [
		{
			"pattern": "aizaz.studio",
			"custom_domain": true
		},
		{
			"pattern": "www.aizaz.studio",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// Contact form — Cloudflare Email Service (Workers send() API).
	// The binding itself only permits the fixed contact sender and inbox; the
	// Worker must not be usable as a generic mail relay.
	// Cloudflare Email Service must have forms@aizaz.studio onboarded and
	// hello@aizaz.studio verified before deployment.
	// Local wrangler simulates send() unless "remote": true is set.
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "hello@aizaz.studio",
			"allowed_sender_addresses": [
				"forms@aizaz.studio"
			]
		}
	],
	// Contact form — ~5 attempts / 60s per hashed network identity (not path-only).
	// Requires Wrangler >= 4.36. Dashboard equivalent is not a substitute while this binding is live.
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "8701",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	]
	// Production vars/secrets (set in Cloudflare dashboard — never commit real values):
	// vars.PUBLIC_TURNSTILE_SITE_KEY
	// vars.PUBLIC_GOOGLE_ADS_SEND_TO   (AW-CONVERSION_ID/CONVERSION_LABEL)
	// vars.TURNSTILE_PREVIEW_HOST      (optional extra Siteverify hostname)
	// secrets.TURNSTILE_SECRET_KEY
}