{
	"main": "dist/_worker.js/index.js",
	"name": "aizaz-studio",
	// Production Cloudflare account (Workers → aizaz-studio dashboard URL).
	// Source of truth so a stale CLOUDFLARE_ACCOUNT_ID secret cannot retarget deploy.
	"account_id": "54d8ce3fa765fe69f73c366be3d98f69",
	"compatibility_date": "2026-01-06",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"html_handling": "drop-trailing-slash"
		// Host normalization (www→apex, HTTP→HTTPS) is handled at Cloudflare zone level.
		// Do not set run_worker_first globally — prerendered Assets should serve directly.
	},
	"routes": [
		{
			"pattern": "aizaz.studio",
			"custom_domain": true
		},
		{
			"pattern": "www.aizaz.studio",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	// Workers Cache sits in front of the Worker. Required for Cache-Control on SSR
	// HTML to skip Worker/Sanity on subsequent anonymous requests.
	"cache": {
		"enabled": true
	},
	"observability": {
		"enabled": true
	}
}
