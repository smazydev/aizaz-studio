{
	"main": "dist/_worker.js/index.js",
	"name": "aizaz-studio",
  "compatibility_date": "2026-01-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"routes": [
		{
			"pattern": "aizaz.studio",
			"custom_domain": true
		},
		{
			"pattern": "www.aizaz.studio",
			"custom_domain": true
		}
	],
	// Keep workers.dev available while custom domain DNS is being fixed
	"workers_dev": true,
	"observability": {
    "enabled": true
  }
}