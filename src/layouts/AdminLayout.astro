---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Aizaz Studio Admin</title>
    <style>
      :root {
        color-scheme: light;
        font-family: Inter, system-ui, sans-serif;
        background: #f4f4f5;
        color: #18181b;
      }
      * { box-sizing: border-box; }
      body { margin: 0; }
      a { color: #0369a1; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .admin-shell { min-height: 100vh; }
      .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        background: #fff;
        border-bottom: 1px solid #e4e4e7;
      }
      .admin-header h1 { font-size: 1.125rem; margin: 0; }
      .admin-nav { display: flex; gap: 1rem; align-items: center; font-size: 0.875rem; }
      .admin-main { max-width: 1100px; margin: 0 auto; padding: 1.5rem; }
      .card {
        background: #fff;
        border: 1px solid #e4e4e7;
        border-radius: 12px;
        padding: 1.25rem;
      }
      .grid { display: grid; gap: 1rem; }
      .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .stat-value { font-size: 1.75rem; font-weight: 700; }
      .stat-label { color: #71717a; font-size: 0.875rem; }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border: 1px solid #d4d4d8;
        background: #fff;
        color: #18181b;
        border-radius: 8px;
        padding: 0.625rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
      }
      .btn-primary { background: #18181b; color: #fff; border-color: #18181b; }
      .btn-danger { color: #b91c1c; border-color: #fecaca; background: #fff; }
      .field { display: grid; gap: 0.375rem; margin-bottom: 1rem; }
      .field label { font-size: 0.875rem; font-weight: 600; }
      .field input, .field textarea, .field select {
        width: 100%;
        border: 1px solid #d4d4d8;
        border-radius: 8px;
        padding: 0.625rem 0.75rem;
        font: inherit;
        background: #fff;
      }
      .field textarea { min-height: 220px; resize: vertical; }
      .field textarea.content-editor { min-height: 420px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
      .muted { color: #71717a; font-size: 0.875rem; }
      .table { width: 100%; border-collapse: collapse; }
      .table th, .table td {
        text-align: left;
        padding: 0.75rem;
        border-bottom: 1px solid #e4e4e7;
        font-size: 0.875rem;
      }
      .badge {
        display: inline-flex;
        padding: 0.125rem 0.5rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: capitalize;
        background: #f4f4f5;
      }
      .badge-published { background: #dcfce7; color: #166534; }
      .badge-scheduled { background: #dbeafe; color: #1d4ed8; }
      .badge-draft { background: #f4f4f5; color: #52525b; }
      .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .login-wrap {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
      }
      .login-card { width: 100%; max-width: 420px; }
      .error { color: #b91c1c; font-size: 0.875rem; margin-top: 0.5rem; }
      @media (max-width: 768px) {
        .grid-2, .grid-4 { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
