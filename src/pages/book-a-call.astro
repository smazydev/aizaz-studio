---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OutlinedCard from '../components/OutlinedCard.astro';
import FaqSection from '../components/FaqSection.astro';
import CalendarEmbed from '../components/CalendarEmbed.astro';
import { bookACall } from '../data/commercialPages';
import { siteFooter } from '../data/siteChrome';

const c = bookACall;
const s = c.sections;
const contact = siteFooter.studio;
---

<SiteShell title={c.metaTitle} description={c.metaDescription} canonical="/book-a-call">
  <PageHero eyebrow="Contact" title={c.title} description={c.heroSubtitle} />

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-grid">
        <OutlinedCard eyebrow="01" title={s.whoFor.heading}>
          <ul class="sp-list" style="margin-top: 14px">
            {s.whoFor.items.map((item) => <li>{item}</li>)}
          </ul>
        </OutlinedCard>
        <OutlinedCard eyebrow="02" title={s.whatWeCover.heading}>
          <ul class="sp-list" style="margin-top: 14px">
            {s.whatWeCover.items.map((item) => <li>{item}</li>)}
          </ul>
        </OutlinedCard>
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="Schedule"
        title="Pick a time"
        lede="Use the calendar below. Prefer email or phone? Reach us directly."
      />
      <CalendarEmbed />
      <div class="sp-contact">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.phoneHref}>{contact.phone}</a>
      </div>
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-grid">
        <OutlinedCard title={s.goodFit.heading}>
          <ul class="sp-list" style="margin-top: 14px">
            {s.goodFit.items.map((item) => <li>{item}</li>)}
          </ul>
        </OutlinedCard>
        <OutlinedCard title={s.notFit.heading}>
          <ul class="sp-list sp-list--mute" style="margin-top: 14px">
            {s.notFit.items.map((item) => <li>{item}</li>)}
          </ul>
        </OutlinedCard>
      </div>
      <p class="c-lede" style="margin-top: 24px; max-width: 40rem">
        Optional prep: a short problem note, tools you use today, and any hard deadlines. A Loom or bullet list is enough.
      </p>
    </div>
  </section>

  <FaqSection faqs={s.faqs} />
</SiteShell>
