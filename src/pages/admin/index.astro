---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { countPostsByStatus, listPosts, publishDueScheduledPosts } from '../../lib/blog-db';
import { formatDisplayDate } from '../../lib/blog-db';

export const prerender = false;

const db = Astro.locals.runtime.env.DB;
await publishDueScheduledPosts(db);
const counts = await countPostsByStatus(db);
const posts = await listPosts(db);
const recentPublished = posts
    .filter((post) => post.status === 'published')
    .sort((a, b) => new Date(b.published_at ?? b.updated_at).getTime() - new Date(a.published_at ?? a.updated_at).getTime())
    .slice(0, 8);
---

<AdminLayout title="Dashboard">
  <div class="admin-shell">
    <header class="admin-header">
      <h1>Blog Admin</h1>
      <nav class="admin-nav">
        <a href="/admin/blog/new" class="btn btn-primary">New Post</a>
        <button class="btn" type="button" id="logout-btn">Log out</button>
      </nav>
    </header>

    <main class="admin-main grid" style="gap:1.5rem;">
      <section class="grid grid-4">
        <div class="card">
          <div class="stat-value">{counts.published}</div>
          <div class="stat-label">Published posts</div>
        </div>
        <div class="card">
          <div class="stat-value">{counts.draft}</div>
          <div class="stat-label">Draft posts</div>
        </div>
        <div class="card">
          <div class="stat-value">{counts.scheduled}</div>
          <div class="stat-label">Scheduled posts</div>
        </div>
        <div class="card">
          <div class="stat-value">{posts.length}</div>
          <div class="stat-label">Total posts</div>
        </div>
      </section>

      <section class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1rem;">
          <h2 style="margin:0;font-size:1.125rem;">All posts</h2>
          <a href="/admin/blog/new" class="btn btn-primary">New Post</a>
        </div>
        <table class="table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Status</th>
              <th>Category</th>
              <th>Updated</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post) => (
              <tr>
                <td>
                  <div style="font-weight:600;">{post.title}</div>
                  <div class="muted">/blog/{post.slug}</div>
                </td>
                <td><span class={`badge badge-${post.status}`}>{post.status}</span></td>
                <td>{post.category}</td>
                <td>{formatDisplayDate(post.updated_at)}</td>
                <td>
                  <div class="actions">
                    <a href={`/admin/blog/${post.id}/edit`} class="btn">Edit</a>
                    {post.preview_token && (
                      <a href={`/blog/preview/${post.preview_token}`} class="btn" target="_blank" rel="noreferrer">
                        Preview
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      {recentPublished.length > 0 && (
        <section class="card">
          <h2 style="margin-top:0;font-size:1.125rem;">Recently published</h2>
          <ul class="grid" style="padding-left:1rem;">
            {recentPublished.map((post) => (
              <li>
                <a href={`/admin/blog/${post.id}/edit`}>{post.title}</a>
                <span class="muted"> · {formatDisplayDate(post.published_at)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
  </div>

  <script>
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.href = '/admin/login';
    });
  </script>
</AdminLayout>
