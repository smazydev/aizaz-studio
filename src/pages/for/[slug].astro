---
export const prerender = true;
import SiteShell from '../../components/SiteShell.astro';
import SeoLanding from '../../components/SeoLanding.astro';
import { industryPages, getServiceBySlug } from '../../data/seoPages';
import { buildSeoPageSchemas } from '../../lib/seoSchema';
import { getIndustryRelatedGroups } from '../../data/internalLinks';

export function getStaticPaths() {
  return industryPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const canonicalPath = `/for/${page.slug}`;
const relatedServices = (page.relatedSlugs ?? [])
  .map((slug) => getServiceBySlug(slug))
  .filter(Boolean);
const relatedGroups = getIndustryRelatedGroups(page.slug, page.relatedSlugs ?? []);
const schemas = buildSeoPageSchemas(
  page,
  [
    { label: 'Home', href: '/' },
    { label: 'Industries', href: '/services' },
  ],
  canonicalPath,
);
---

<SiteShell
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={canonicalPath}
  schemas={schemas}
>
  <SeoLanding
    page={page}
    badge="Industries We Serve"
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Industries', href: '/services' },
    ]}
    relatedServices={relatedServices}
    relatedGroups={relatedGroups}
  />
</SiteShell>
