---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import SeoLanding from '../../components/SeoLanding.astro';
import { industryPages } from '../../data/seoPages';
import { buildSeoPageSchemas } from '../../lib/seoSchema';

export function getStaticPaths() {
  return industryPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const canonicalPath = `/for/${page.slug}`;
const schemas = buildSeoPageSchemas(
  page,
  [
    { label: 'Home', href: '/' },
    { label: 'Industries', href: '/services' },
  ],
  canonicalPath,
);
---

<Layout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={canonicalPath}
  keywords={page.keywords}
  schemas={schemas}
>
  <div class="min-h-screen bg-black text-white selection:bg-primary-500/30 selection:text-primary-200 overflow-x-hidden">
    <Navbar client:load />
    <main>
      <SeoLanding
        page={page}
        badge="Industries We Serve"
        breadcrumb={[
          { label: 'Home', href: '/' },
          { label: 'Industries', href: '/services' },
        ]}
      />
    </main>
    <Footer client:visible />
  </div>
</Layout>
