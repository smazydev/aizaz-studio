---
import SiteShell from '../../components/SiteShell.astro';
import SeoLanding from '../../components/SeoLanding.astro';
import { industryPages } from '../../data/seoPages';

export function getStaticPaths() {
  return industryPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
---

<SiteShell title={page.metaTitle} description={page.metaDescription} canonical={`/for/${page.slug}`} keywords={page.keywords}>
  <SeoLanding
    page={page}
    badge="Industries We Serve"
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Industries', href: '/services' },
    ]}
  />
</SiteShell>
