---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import '../styles/home-local.css';
import ClonePage from '../components/home/ClonePage.astro';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { getHomepageContent } from '../lib/sanity/homepage';
import { getLeadershipProfiles } from '../lib/sanity/leadership';

const homepage = await getHomepageContent();
const leaders = await getLeadershipProfiles();
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'homepage']);
---

<Layout
  title="Aizaz.studio | AI, Cloud & Automation Engineering Studio"
  description="Give us a stuck workflow or a product that needs to ship. We build AI automation, SaaS, NetSuite, and AWS systems — one live in 14 days."
  canonical="/"
>
  <ClonePage homepage={homepage} leaders={leaders} />
</Layout>

<script>
  import { mountHomeMotion } from '../lib/home-motion';
  mountHomeMotion();
</script>
