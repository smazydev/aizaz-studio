---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageCTA from '../components/PageCTA.astro';
import { industryPages } from '../data/seoPages';
import { serviceGroups, servicesForGroup, ungroupedServices } from '../data/serviceGroups';
import { BOOKING_URL } from '../data/siteConfig';

const leftover = ungroupedServices();
---

<SiteShell
  title="Services | AI, Cloud & Automation Engineering | Aizaz.studio"
  description="AI automation, web app development, AWS DevOps, NetSuite integrations, business process automation, trading technology, and product enablement for growing businesses."
  canonical="/services"
>
  <PageHero
    eyebrow="Services"
    title="Systems we build"
    description="Senior engineering across AI & automation, product/SaaS, ERP integrations, and cloud, so manual workflows become reliable software."
  >
    <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a Call</a>
    <a class="c-btn c-btn--ghost" href="/ai-systems-sprint">AI Systems Sprint</a>
  </PageHero>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-promo">
        <div class="sp-promo__copy">
          <p class="c-micro c-red">Focused sprint</p>
          <h2 class="page-h2">AI Systems Sprint</h2>
          <p class="c-lede">
            In 14 days, we turn one manual workflow into a working AI-assisted system, automation, dashboard, or internal tool connected to your real stack.
          </p>
        </div>
        <a class="c-btn" href="/ai-systems-sprint">View the Sprint Offer</a>
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="Capabilities"
        title="Four groups. Full depth underneath."
        lede="Use this page to orient. Each link opens a dedicated service page that keeps its SEO intent and technical detail."
      />

      {serviceGroups.map((group) => {
        const items = servicesForGroup(group);
        return (
          <div class="sp-group">
            <div class="sp-group__head">
              <p class="c-micro c-red">{group.n}</p>
              <h3>{group.title}</h3>
              <p class="c-lede">{group.lede}</p>
            </div>
            <div class="sp-group__links">
              {items.map((service) => (
                <a class="sp-link" href={`/services/${service.slug}`}>
                  <strong>{service.title}</strong>
                  <span>{service.heroSubtitle}</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}

      {leftover.length > 0 && (
        <div class="sp-group">
          <div class="sp-group__head">
            <p class="c-micro c-red">More</p>
            <h3>Additional services</h3>
          </div>
          <div class="sp-group__links">
            {leftover.map((service) => (
              <a class="sp-link" href={`/services/${service.slug}`}>
                <strong>{service.title}</strong>
                <span>{service.heroSubtitle}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="Industries"
        title="Built for operations-heavy contexts"
        lede="Industry pages keep audience-specific framing. Same engineering standards."
      />
      <div class="sp-group__links">
        {industryPages.map((industry) => (
          <a class="sp-link" href={`/for/${industry.slug}`}>
            <p class="c-micro c-red">{industry.audienceLabel}</p>
            <strong>{industry.title}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <PageCTA />
</SiteShell>
