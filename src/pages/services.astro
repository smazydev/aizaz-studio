---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageCTA from '../components/PageCTA.astro';
import PageSentinel from '../components/PageSentinel.astro';
import { industryPages, servicePages, SITE_URL } from '../data/seoPages';
import { serviceGroups, servicesForGroup, ungroupedServices } from '../data/serviceGroups';
import { BOOKING_URL } from '../data/siteConfig';
import { buildListingPageSchemas } from '../lib/seoSchema';

const leftover = ungroupedServices();
const pageTitle = 'Engineering Services for AI, SaaS & Cloud | Aizaz';
const pageDescription =
  'Stuck workflows, a product that needs to ship, or systems that don’t talk. Senior engineers for AI automation, SaaS, NetSuite, and AWS.';
const schemas = buildListingPageSchemas({
  name: 'Engineering Services',
  description: pageDescription,
  canonicalPath: '/services',
  items: servicePages.map((page) => ({
    name: page.title,
    url: `${SITE_URL}/services/${page.slug}`,
  })),
});
---

<SiteShell
  title={pageTitle}
  description={pageDescription}
  canonical="/services"
  schemas={schemas}
>
  <PageSentinel>
    <PageHero
      eyebrow="Engineering services"
      title="Turn operational bottlenecks"
      highlight="into systems you can run."
      description="Hand us a manual process, a product that needs to ship, disconnected tools, or infrastructure that cannot keep up. We own it through production."
    >
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Discuss your build</a>
      <a class="c-btn c-btn--ghost" href="/case-studies">See the work</a>
    </PageHero>

    <aside class="c-wrap page-sentinel__offer">
      <div class="sp-promo sp-promo--offer">
        <div class="sp-promo__copy">
          <p class="c-micro c-red">Start small. Prove value fast.</p>
          <h2 class="page-h2">Ship one high-value AI workflow in 14 days.</h2>
          <p class="c-lede">
            Our AI Systems Sprint turns a costly manual process into a working system connected to your real tools, data, and team—before you commit to a larger build.
          </p>
        </div>
        <a class="c-btn" href="/ai-systems-sprint">Discuss a 14-day sprint</a>
      </div>
    </aside>
  </PageSentinel>

  <section class="sp-section">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="How we help"
        title="Senior engineering for the systems your business depends on"
        lede="Bring us a manual process, a product that needs to ship, disconnected business systems, or infrastructure that cannot keep up. We take ownership from technical direction through production."
      />

      {serviceGroups.map((group) => {
        const items = servicesForGroup(group);
        return (
          <div class="sp-group">
            <div class="sp-group__head">
              <p class="c-micro c-red">{group.n}</p>
              <h3>{group.title}</h3>
              <p class="c-lede">{group.lede}</p>
            </div>
            <div class="sp-group__links">
              {items.map((service) => (
                <a class="sp-link" href={`/services/${service.slug}`}>
                  <strong>{service.title}</strong>
                  <span>{service.heroSubtitle}</span>
                </a>
              ))}
            </div>
          </div>
        );
      })}

      {leftover.length > 0 && (
        <div class="sp-group">
          <div class="sp-group__head">
            <p class="c-micro c-red">More</p>
            <h3>Additional services</h3>
          </div>
          <div class="sp-group__links">
            {leftover.map((service) => (
              <a class="sp-link" href={`/services/${service.slug}`}>
                <strong>{service.title}</strong>
                <span>{service.heroSubtitle}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="Where we work"
        title="Built for businesses where software meets real operations"
        lede="We understand the constraints behind complex workflows, sensitive data, legacy systems, and teams that cannot pause while new software is introduced."
      />
      <div class="sp-group__links">
        {industryPages.map((industry) => (
          <a class="sp-link" href={`/for/${industry.slug}`}>
            <p class="c-micro c-red">{industry.audienceLabel}</p>
            <strong>{industry.title}</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <PageCTA
    eyebrow="Start a conversation"
    title="What is slowing your business down?"
    lede="Bring us the bottleneck, the broken integration, or the product that isn’t shipping. We’ll tell you the right first step."
  />
</SiteShell>
