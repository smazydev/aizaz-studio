---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OutlinedCard from '../components/OutlinedCard.astro';
import PageCTA from '../components/PageCTA.astro';
import TeamPortrait from '../components/TeamPortrait.astro';
import PageSentinel from '../components/PageSentinel.astro';
import { leadershipProfiles } from '../data/leadership';
import { caseStudies } from '../data/caseStudies';
import { filterPublicCaseStudies } from '../lib/case-study-visibility';
import { BOOKING_URL } from '../data/siteConfig';

const leaders = leadershipProfiles;
const proof = filterPublicCaseStudies(caseStudies).slice(0, 3);
---

<SiteShell
  title="About Aizaz Studio | Senior Systems Team"
  description="A senior systems team for stuck workflows, stalled products, and systems that don’t talk. AI automation, SaaS, NetSuite, and AWS — owned through production."
  canonical="/about"
>
  <PageSentinel>
    <PageHero
      eyebrow="About"
      title="A senior systems"
      highlight="team on demand"
      description="You shouldn’t have to manage the people building the system. Hand us the operational problem — we diagnose, build, and ship."
    >
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
      <a class="c-btn c-btn--ghost" href="/case-studies">See the work</a>
    </PageHero>

    <div class="c-wrap page-sentinel__intro">
      <SectionHeader
        eyebrow="What we are"
        title="Systems thinking, senior delivery"
        lede="We help founders and operations teams replace manual, scattered workflows with connected software, from a focused sprint to a full platform build."
      />
    </div>
  </PageSentinel>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-grid">
        <OutlinedCard
          eyebrow="Who we work with"
          title="Ops-heavy teams and product builders"
          body="SaaS founders, ecommerce operators, clinics, trading businesses, NetSuite users, and agencies that need senior engineering, not another layer of account management."
        />
        <OutlinedCard
          eyebrow="How we think"
          title="Across architecture, automation, and handoff"
          body="Isolated vendors create gaps. We design the technical layer so CRM, ERP, product, and cloud stay coherent, and your team can operate what we ship."
        />
      </div>
    </div>
  </section>

  <section class="sp-section sp-section--dark">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="Leadership"
        title="The people who own the work"
        lede="A small founding team. No fabricated headcount. Direct access to the engineers and operators shipping your system."
        tone="dark"
      />
      <div class="sp-people">
        {leaders.map((person) => (
          <article class="sp-person">
            <TeamPortrait
              person={person}
              class="sp-person__photo"
              width={192}
              height={192}
              widths={[96, 192]}
              sizes="96px"
            />
            <div>
              <h3 class="sp-person__name">{person.name}</h3>
              <p class="sp-person__role">{person.role}</p>
              <div class="sp-person__links">
                {person.linkedin && (
                  <a href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
                )}
                {person.githubUrl && (
                  <a href={person.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="How we work with clients"
        title="Clear ownership, production standards"
        lede="Every engagement starts with discovery and ends with software your team can run, with documentation, monitoring, and a sensible next step."
      />
      <div class="sp-grid sp-grid--3">
        <OutlinedCard eyebrow="01" title="Discover" body="Map the stack and pick the highest-leverage workflow or product milestone." />
        <OutlinedCard eyebrow="02" title="Build & integrate" body="Senior engineers ship against real systems, not isolated demos." />
        <OutlinedCard eyebrow="03" title="Ship & observe" body="Deploy with CI/CD, logging, and handoff so operations stay quiet after launch." />
      </div>
      <div class="page-hero__actions" style="margin-top: 28px">
        <a class="c-btn c-btn--ghost" href="/process">Full process</a>
        <a class="c-btn c-btn--ghost" href="/engagement-models">Engagement models</a>
      </div>
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="Proof"
        title="Real systems in production"
        lede="Selected public work. PropertyMatch shipped as a SaaS MVP in 14 days. 1Archiver was designed for tens of terabytes."
      />
      <div class="sp-grid sp-grid--3">
        {proof.map((study) => (
          <OutlinedCard
            href={`/case-studies/${study.slug}`}
            eyebrow={study.category}
            title={study.title.split(':')[0].trim()}
            body={study.subtitle}
          >
            <p class="sp-card__go">View case study ↗</p>
          </OutlinedCard>
        ))}
      </div>
    </div>
  </section>

  <PageCTA
    title="Ready to talk through a system?"
    lede="Tell us what needs fixing. We’ll map fit, scope, and a sensible first step."
  />
</SiteShell>
