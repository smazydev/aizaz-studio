---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OutlinedCard from '../components/OutlinedCard.astro';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { getCareersPage } from '../lib/sanity/sitePages';
import { getSiteSettings } from '../lib/sanity/siteSettings';

const [page, settings] = await Promise.all([getCareersPage(), getSiteSettings()]);
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages']);
---

<SiteShell
  title={page.metaTitle}
  description={page.metaDescription}
  canonical="/careers"
>
  <PageHero
    eyebrow={page.heroEyebrow ?? 'Careers'}
    title={page.title}
    highlight={page.heroHighlight}
    description={page.heroSubtitle}
  />

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <h2 class="visually-hidden">How we work</h2>
      <div class="sp-grid sp-grid--3">
        {page.values.map((value) => (
          <OutlinedCard title={value.title} body={value.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap seo-measure">
      <SectionHeader
        eyebrow={page.sectionEyebrow ?? 'Roles'}
        title={page.sectionTitle ?? 'Open roles'}
        lede={page.sectionLede}
      />
      <div class="sp-grid sp-grid--1" style="gap: 12px">
        {page.jobs.map((job) => (
          <article class="sp-card">
            <div class="sp-card__top">
              <p class="c-micro c-red">{job.department}</p>
              <span class="sp-card__meta">Paused · still say hi</span>
            </div>
            <h3 class="sp-card__title">{job.title}</h3>
            <p class="c-lede sp-card__body">{job.description}</p>
            <p class="c-micro" style="margin-top: 14px">{job.location} · {job.type}</p>
          </article>
        ))}
      </div>
      <div class="sp-promo" style="margin-top: 28px">
        <div class="sp-promo__copy">
          <p class="c-lede">
            Send your portfolio or GitHub to{' '}
            <a href={`mailto:${settings.studio.email}`}>{settings.studio.email}</a>
            — tell us what systems you have shipped and what you want to build next.
          </p>
        </div>
      </div>
    </div>
  </section>
</SiteShell>
