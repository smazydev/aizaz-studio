---
import SiteShell from '../../components/SiteShell.astro';
import SeoLanding from '../../components/SeoLanding.astro';
import { servicePages, getServiceBySlug } from '../../data/seoPages';

export function getStaticPaths() {
  return servicePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const relatedServices = (page.relatedSlugs ?? [])
  .map((slug) => getServiceBySlug(slug))
  .filter(Boolean);
---

<SiteShell title={page.metaTitle} description={page.metaDescription} canonical={`/services/${page.slug}`} keywords={page.keywords}>
  <SeoLanding
    page={page}
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
    ]}
    relatedServices={relatedServices}
  />
</SiteShell>
