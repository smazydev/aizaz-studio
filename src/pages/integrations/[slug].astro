---
export const prerender = false;

import SiteShell from '../../components/SiteShell.astro';
import SeoLanding from '../../components/SeoLanding.astro';
import BcNsIntegrationLanding from '../../components/BcNsIntegrationLanding.astro';
import { buildSeoPageSchemas } from '../../lib/seoSchema';
import { getServiceRelatedGroups } from '../../data/internalLinks';
import { applyCmsCacheHeaders } from '../../lib/cms-cache';
import { extrasForPage, getIntegrationBySlug } from '../../lib/sanity/landingPages';
import { bcNsMeta } from '../../data/bcNsIntegration';

const slug = Astro.params.slug;
const page = slug ? await getIntegrationBySlug(slug) : undefined;
if (!page) {
  return new Response(null, { status: 404 });
}

applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages', `landing:${page.slug}`]);

const canonicalPath = `/integrations/${page.slug}`;
const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'NetSuite Integration', href: '/services/netsuite-integration' },
];
const relatedGroups = getServiceRelatedGroups(page.slug, page.relatedSlugs ?? []);
const schemaPage =
  page.slug === 'netsuite-bigcommerce'
    ? {
        ...page,
        title: bcNsMeta.title,
        metaTitle: bcNsMeta.metaTitle,
        metaDescription: bcNsMeta.metaDescription,
        heroSubtitle: bcNsMeta.heroSubtitle,
        primaryCta: bcNsMeta.primaryCta,
        secondaryCta: bcNsMeta.secondaryCta,
      }
    : page;
const schemas = buildSeoPageSchemas(schemaPage, breadcrumb, canonicalPath);
---

<SiteShell
  title={page.slug === 'netsuite-bigcommerce' ? bcNsMeta.metaTitle : page.metaTitle}
  description={page.slug === 'netsuite-bigcommerce' ? bcNsMeta.metaDescription : page.metaDescription}
  canonical={canonicalPath}
  schemas={schemas}
>
  {page.slug === 'netsuite-bigcommerce' ? (
    <BcNsIntegrationLanding breadcrumb={breadcrumb} relatedGroups={relatedGroups} />
  ) : (
    <SeoLanding
      page={page}
      extras={extrasForPage(page)}
      breadcrumb={breadcrumb}
      badge="Integration"
      relatedGroups={relatedGroups}
    />
  )}
</SiteShell>
