---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import { portfolio } from '../data/commercialPages';
import { Image } from 'astro:assets';
import archiverCover from '../assets/1archiver-casestudy-cover.png';
import { HIDDEN_CASE_STUDY_SLUGS } from '../lib/case-study-visibility';

const c = portfolio;
const images: Record<string, typeof archiverCover> = {
  '1archiver-compliance-platform': archiverCover,
};
const projects = c.projects.filter((project) => !HIDDEN_CASE_STUDY_SLUGS.has(project.slug));
---

<SiteShell title={c.metaTitle} description={c.metaDescription} canonical="/portfolio">
  <PageHero eyebrow="Work" title={c.title} description={c.intro}>
    <a class="c-btn c-btn--ghost" href="/case-studies">Full Case Studies</a>
  </PageHero>

  <section class="sp-section">
    <div class="c-wrap">
      <div class="sp-grid">
        {projects.map((project) => (
          <article class="sp-card" style="padding: 0; overflow: hidden">
            {project.slug && images[project.slug] && (
              <div class="works-detail__hero" style="border:0; border-radius:0; aspect-ratio: 16/10">
                <Image src={images[project.slug]} alt={project.name} class="works-item__shot" />
              </div>
            )}
            <div style="padding: 22px 24px">
              <p class="c-micro c-red">{project.category}</p>
              <h2 class="sp-card__title" style="margin-top: 8px">{project.name}</h2>
              <p class="c-lede sp-card__body">{project.summary}</p>
              <p class="c-micro" style="margin-top: 16px">Stack</p>
              <p class="c-lede" style="margin-top: 6px; font-size: 0.9rem">{project.stack.join(' · ')}</p>
              <ul class="sp-list" style="margin-top: 16px">
                {project.outcomes.map((o) => <li>{o}</li>)}
              </ul>
              {project.href && (
                <a class="blog-card__more" href={project.href} style="display:inline-block; margin-top: 18px">View case study →</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</SiteShell>
