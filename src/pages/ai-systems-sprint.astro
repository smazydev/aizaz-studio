---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import FaqSection from '../components/FaqSection.astro';
import { deliverySteps } from '../data/siteContent';
import { BOOKING_URL } from '../data/siteConfig';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { getSprintPage } from '../lib/sanity/landingPages';

const page = await getSprintPage();
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages', 'landing:ai-systems-sprint']);
---

<SiteShell
  title={page.metaTitle}
  description={page.metaDescription}
  canonical="/ai-systems-sprint"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: page.title,
    description: page.metaDescription,
    brand: { '@type': 'Organization', name: 'Aizaz.studio' },
    offers: { '@type': 'Offer', availability: 'https://schema.org/InStock', url: 'https://aizaz.studio/ai-systems-sprint' },
  })} />

  <PageHero
    eyebrow="Flagship offer"
    title="AI Systems Sprint"
    highlight="One workflow. 14 days. Live system."
    description={page.heroSubtitle}
  >
    <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Discuss a 14-day sprint</a>
    <a class="c-btn c-btn--ghost" href="/start-a-project">Tell us what needs fixing</a>
  </PageHero>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-grid sp-grid--3">
        <div class="sp-card" style="text-align:center"><p class="sp-card__title" style="font-size:2rem">14</p><p class="c-micro">Days</p></div>
        <div class="sp-card" style="text-align:center"><p class="sp-card__title" style="font-size:2rem">1</p><p class="c-micro">Workflow</p></div>
        <div class="sp-card" style="text-align:center"><p class="sp-card__title" style="font-size:2rem">Live</p><p class="c-micro">Deployed</p></div>
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap seo-measure">
      <div class="sp-grid">
        <article class="sp-card">
          <h2 class="sp-card__title">Why teams stall</h2>
          <p class="c-lede sp-card__body">{page.problem}</p>
        </article>
        <article class="sp-card">
          <h2 class="sp-card__title">What you walk away with</h2>
          <p class="c-lede sp-card__body">{page.solution}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap seo-measure">
      <h2 class="page-h2">When one workflow is blocking everything</h2>
      <p class="c-lede" style="margin-top: 14px">
        Founders use the sprint to prove one workflow before a larger build. Ops leaders use it to fix one painful process before a bigger ERP or SaaS project.
      </p>
      <h3 class="sp-card__title" style="margin-top: 28px">What's included</h3>
      <ul class="sp-list" style="margin-top: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px">
        {page.capabilities.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap seo-measure">
      <h2 class="page-h2">Sprint examples we build</h2>
      <div class="works-detail__items" style="margin-top: 20px">
        {page.examples.map((item) => (
          <div class="sp-card seo-usecase">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap seo-measure">
      <h2 class="page-h2">Sprint timeline</h2>
      <div class="sp-grid sp-grid--3" style="margin-top: 24px">
        {deliverySteps.map((step) => (
          <article class="sp-card">
            <p class="c-micro c-red">{step.step}</p>
            <h3 class="sp-card__title">{step.title}</h3>
            <p class="c-lede sp-card__body">{step.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <FaqSection faqs={page.faqs} />
  <PageCTA
    title="Start with one workflow"
    lede="Tell us the workflow that needs to stop being manual. We’ll say if a 14-day sprint is the right first step."
  />
</SiteShell>
