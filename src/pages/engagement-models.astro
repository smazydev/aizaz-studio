---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import OutlinedCard from '../components/OutlinedCard.astro';
import FaqSection from '../components/FaqSection.astro';
import PageCTA from '../components/PageCTA.astro';
import { engagementModels } from '../data/commercialPages';

const c = engagementModels;
---

<SiteShell title={c.metaTitle} description={c.metaDescription} canonical="/engagement-models">
  <PageHero eyebrow="Commercial" title={c.title} description={c.heroSubtitle}>
    <a class="c-btn" href="/book-a-call">Book a Call</a>
    <a class="c-btn c-btn--ghost" href="/ai-systems-sprint">AI Systems Sprint</a>
  </PageHero>

  <section class="sp-section">
    <div class="c-wrap">
      <SectionHeader
        eyebrow="Models"
        title="How clients work with Aizaz"
        lede="No fictional price cards. Scope and ownership determine the model. Not every project fits every option."
      />
      <div class="sp-grid sp-grid--1" style="gap: 14px">
        {c.models.map((model) => (
          <article class="sp-card">
            <div class="sp-card__top">
              <p class="c-micro c-red">{model.name}</p>
              <span class="sp-card__meta">{model.duration}</span>
            </div>
            <p class="c-lede sp-card__body" style="margin-bottom: 18px">{model.summary}</p>
            <div class="sp-grid">
              <div>
                <p class="c-micro">Best for</p>
                <ul class="sp-list" style="margin-top: 12px">
                  {model.bestFor.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              <div>
                <p class="c-micro">What you get</p>
                <ul class="sp-list" style="margin-top: 12px">
                  {model.deliverables.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </div>
            <p class="c-micro" style="margin-top: 18px">Commercial · {model.startingFrom}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <SectionHeader eyebrow="Chooser" title="Which model is right?" />
      <div class="sp-grid">
        {c.selectorGuide.map((guide) => (
          <OutlinedCard title={guide.heading} body={guide.body} />
        ))}
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap">
      <SectionHeader eyebrow="Compare" title="At a glance" />
      <div class="sp-table-wrap">
        <table class="sp-table">
          <thead>
            <tr>
              {c.comparisonTable.headers.map((h) => (
                <th>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {c.comparisonTable.rows.map((row) => (
              <tr>
                <td>{row.feature}</td>
                <td>{row.sprint}</td>
                <td>{row.project}</td>
                <td>{row.dedicated}</td>
                <td>{row.retainer}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-grid">
        <div class="sp-card">
          <p class="c-micro c-red">Included</p>
          <ul class="sp-list" style="margin-top: 16px">
            {c.included.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="sp-card">
          <p class="c-micro">Not included</p>
          <ul class="sp-list sp-list--mute" style="margin-top: 16px">
            {c.notIncluded.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
      <div class="sp-group__links" style="margin-top: 28px">
        {c.relatedLinks.map((link) => (
          <a class="sp-link" href={link.href}><strong>{link.label}</strong></a>
        ))}
      </div>
    </div>
  </section>

  <FaqSection faqs={c.faqs} />
  <PageCTA title="Unsure which model fits?" lede="Book a discovery call. We will recommend a starting point without inventing a quote on the call." />
</SiteShell>
