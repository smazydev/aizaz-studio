---
export const prerender = true;
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import FaqSection from '../components/FaqSection.astro';
import { engagementModels } from '../data/commercialPages';

const c = engagementModels;
---

<SiteShell title={c.metaTitle} description={c.metaDescription} canonical="/engagement-models">
  <PageHero eyebrow="Commercial" title={c.title} description={c.heroSubtitle}>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/book-a-call" class="inline-flex justify-center px-8 py-4 rounded-full bg-white text-black font-semibold hover:bg-zinc-100 transition-colors">Book a Call</a>
      <a href="/ai-systems-sprint" class="inline-flex justify-center px-8 py-4 rounded-full border border-zinc-700 text-white font-medium hover:bg-zinc-900 transition-colors">AI Systems Sprint</a>
    </div>
  </PageHero>

  <section class="pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      {c.models.map((model) => (
        <article class="p-8 rounded-2xl glass-card">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
            <h2 class="text-2xl font-display font-bold text-white">{model.name}</h2>
            <span class="text-sm text-primary-400 font-semibold">{model.duration}</span>
          </div>
          <p class="text-zinc-400 leading-relaxed mb-6">{model.summary}</p>
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="text-sm font-bold text-zinc-300 uppercase tracking-wider mb-3">Best for</h3>
              <ul class="space-y-2">
                {model.bestFor.map((item) => (
                  <li class="text-sm text-zinc-400 flex gap-2"><span class="text-primary-500">•</span>{item}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-sm font-bold text-zinc-300 uppercase tracking-wider mb-3">Deliverables</h3>
              <ul class="space-y-2">
                {model.deliverables.map((item) => (
                  <li class="text-sm text-zinc-400 flex gap-2"><span class="text-primary-500">•</span>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-display font-bold text-white mb-8 text-center">Which model is right for you?</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {c.selectorGuide.map((guide) => (
          <div class="p-6 rounded-2xl glass-card">
            <h3 class="text-lg font-bold text-white mb-3">{guide.heading}</h3>
            <p class="text-zinc-400 text-sm leading-relaxed">{guide.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 overflow-x-auto">
      <h2 class="text-3xl font-display font-bold text-white mb-8">Comparison at a glance</h2>
      <table class="w-full min-w-[720px] text-sm border-collapse">
        <thead>
          <tr class="border-b border-zinc-800">
            {c.comparisonTable.headers.map((h) => (
              <th class="py-3 px-3 text-left text-zinc-400 font-semibold">{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {c.comparisonTable.rows.map((row) => (
            <tr class="border-b border-zinc-900">
              <td class="py-3 px-3 text-zinc-300 font-medium">{row.feature}</td>
              <td class="py-3 px-3 text-zinc-400">{row.sprint}</td>
              <td class="py-3 px-3 text-zinc-400">{row.project}</td>
              <td class="py-3 px-3 text-zinc-400">{row.dedicated}</td>
              <td class="py-3 px-3 text-zinc-400">{row.retainer}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="pb-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-8">
      <div class="p-8 rounded-2xl glass-card border-emerald-500/20">
        <h2 class="text-xl font-display font-bold text-white mb-4">What is included</h2>
        <ul class="space-y-2">
          {c.included.map((item) => (
            <li class="text-sm text-zinc-400 flex gap-2"><span class="text-emerald-400">✓</span>{item}</li>
          ))}
        </ul>
      </div>
      <div class="p-8 rounded-2xl glass-card border-zinc-700">
        <h2 class="text-xl font-display font-bold text-white mb-4">What is not included</h2>
        <ul class="space-y-2">
          {c.notIncluded.map((item) => (
            <li class="text-sm text-zinc-400 flex gap-2"><span class="text-zinc-600">×</span>{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-display font-bold text-white mb-6">Explore related pages</h2>
      <div class="flex flex-wrap gap-3">
        {c.relatedLinks.map((link) => (
          <a href={link.href} class="px-4 py-2 rounded-full border border-zinc-700 text-sm text-zinc-300 hover:border-primary-500/40 hover:text-white transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </section>

  <FaqSection faqs={c.faqs} />

  <section class="pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/book-a-call" class="inline-flex px-8 py-4 rounded-full bg-white text-black font-bold hover:bg-zinc-100 transition-colors">Book a Technical Discovery Call</a>
    </div>
  </section>
</SiteShell>
