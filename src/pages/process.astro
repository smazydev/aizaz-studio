---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import FaqSection from '../components/FaqSection.astro';
import PageCTA from '../components/PageCTA.astro';
import PageSentinel from '../components/PageSentinel.astro';
import { processPage } from '../data/commercialPages';
import { BOOKING_URL } from '../data/siteConfig';

const c = processPage;
---

<SiteShell title={c.metaTitle} description={c.metaDescription} canonical="/process">
  <PageSentinel>
    <PageHero
      eyebrow="How we work"
      title="Discover → Observe"
      highlight="a delivery discipline"
      description="Every engagement follows the same lifecycle: discover, design, build, integrate, ship, and observe. Timelines depend on scope. We do not invent universal delivery dates."
    >
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a Call</a>
      <a class="c-btn c-btn--ghost" href="/engagement-models">Engagement Models</a>
    </PageHero>
  </PageSentinel>

  <Process stepsOnly />

  <FaqSection faqs={[
    { question: 'Does every project use every stage?', answer: 'Yes in spirit. Discovery and design always happen, even on a focused sprint. Build, integrate, ship, and observe scale with the engagement model you choose.' },
    { question: 'Can we start with one stage only?', answer: 'Yes. Many clients start with discovery and a 14-day AI Systems Sprint before committing to a platform build or retainer.' },
    { question: 'Do you document everything for our team?', answer: 'Yes. Handoff includes architecture notes, runbooks, and access documentation so your team can operate and extend the system.' },
    { question: 'Who works on our project?', answer: 'Senior engineers and architects. We do not rotate junior staff onto production systems without senior oversight.' },
  ]} />

  <section class="sp-section sp-section--tight">
    <div class="c-wrap" style="text-align:center">
      <a class="c-btn c-btn--ghost" href="/engineering-transformation">Engineering transformation overview</a>
    </div>
  </section>

  <PageCTA
    title="Want this process on your next system?"
    lede="Book a call to map scope, or start with a focused sprint."
  />
</SiteShell>
