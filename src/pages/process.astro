---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import FaqSection from '../components/FaqSection.astro';
import PageCTA from '../components/PageCTA.astro';
import PageSentinel from '../components/PageSentinel.astro';
import { BOOKING_URL } from '../data/siteConfig';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { getProcessPage } from '../lib/sanity/sitePages';

const c = await getProcessPage();
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages']);
---

<SiteShell title={c.metaTitle} description={c.metaDescription} canonical="/process">
  <PageSentinel>
    <PageHero
      eyebrow={c.heroEyebrow ?? 'How we work'}
      title={c.heroTitle ?? 'Discover → Observe'}
      highlight={c.heroHighlight}
      description={c.heroSubtitle ?? c.intro}
    >
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
      <a class="c-btn c-btn--ghost" href="/engagement-models">Discuss a full build</a>
    </PageHero>
  </PageSentinel>

  <Process stepsOnly steps={c.steps} />

  <FaqSection faqs={c.faqs} />

  <section class="sp-section sp-section--tight">
    <div class="c-wrap" style="text-align:center">
      <a class="c-btn c-btn--ghost" href="/engineering-transformation">Engineering transformation overview</a>
    </div>
  </section>

  <PageCTA
    title="Want this process on your next system?"
    lede="Tell us what needs fixing. We’ll map scope, or start with a focused sprint if that fits."
  />
</SiteShell>
