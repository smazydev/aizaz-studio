---
export const prerender = false;

import SiteShell from '../../components/SiteShell.astro';
import CompareLanding from '../../components/CompareLanding.astro';
import { applyCmsCacheHeaders } from '../../lib/cms-cache';
import { getCompareBySlug } from '../../lib/sanity/comparePages';

const slug = Astro.params.slug;
const page = slug ? await getCompareBySlug(slug) : undefined;
if (!page) {
  return new Response(null, { status: 404 });
}

applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages', `compare:${page.slug}`]);
---

<SiteShell title={page.metaTitle} description={page.metaDescription} canonical={`/compare/${page.slug}`}>
  <CompareLanding page={page} />
</SiteShell>
