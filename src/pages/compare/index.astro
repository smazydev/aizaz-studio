---
import SiteShell from '../../components/SiteShell.astro';
import PageHero from '../../components/PageHero.astro';
import { comparePages } from '../../data/comparePages';
---

<SiteShell
  title="Compare Engagement Options | Aizaz Studio"
  description="Compare product engineering with staff augmentation, agencies vs freelancers, and AI Systems Sprint vs traditional automation projects."
  canonical="/compare"
>
  <PageHero
    eyebrow="Resources"
    title="Compare your options"
    description="Honest comparisons to help you choose the right model for AI, SaaS, cloud, and automation work."
  />

  <section class="pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-6">
      {comparePages.map((page) => (
        <a href={`/compare/${page.slug}`} class="block p-8 rounded-2xl glass-card hover:border-primary-500/30 transition-colors group">
          <h2 class="text-xl font-display font-bold text-white mb-2 group-hover:text-primary-400 transition-colors">{page.title}</h2>
          <p class="text-zinc-400 text-sm leading-relaxed">{page.heroSubtitle}</p>
        </a>
      ))}
    </div>
  </section>
</SiteShell>
