---
export const prerender = false;

import SiteShell from '../../components/SiteShell.astro';
import PageHero from '../../components/PageHero.astro';
import { BOOKING_URL } from '../../data/siteConfig';
import { applyCmsCacheHeaders } from '../../lib/cms-cache';
import { getComparePages } from '../../lib/sanity/comparePages';
import { getCompareIndex } from '../../lib/sanity/sitePages';

const [comparePages, index] = await Promise.all([getComparePages(), getCompareIndex()]);
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages']);
---

<SiteShell
  title={index.metaTitle}
  description={index.metaDescription}
  canonical="/compare"
>
  <PageHero
    eyebrow={index.heroEyebrow ?? 'Resources'}
    title={index.title}
    description={index.heroSubtitle}
  >
    <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
    <a class="c-btn c-btn--ghost" href="/start-a-project">Tell us what needs fixing</a>
  </PageHero>

  <section class="sp-section">
    <div class="c-wrap seo-measure">
      <div class="sp-grid sp-grid--1" style="gap: 12px">
        {comparePages.map((page) => (
          <a class="sp-card" href={`/compare/${page.slug}`}>
            <h2 class="sp-card__title">{page.title}</h2>
            <p class="c-lede sp-card__body">{page.heroSubtitle}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteShell>
