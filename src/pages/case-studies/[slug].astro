---
export const prerender = false;

import SiteShell from '../../components/SiteShell.astro';
import PageCTA from '../../components/PageCTA.astro';
import { SITE_URL } from '../../data/seoPages';
import { BOOKING_URL, isExternalHref } from '../../data/siteConfig';
import { getCaseStudyBySlug } from '../../lib/sanity/caseStudies';
import AuthorCard from '../../components/AuthorCard.astro';
import LocalImage from '../../components/LocalImage.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { applyCmsCacheHeaders } from '../../lib/cms-cache';
import { getCaseStudyRelatedGroups } from '../../data/internalLinks';

const { slug } = Astro.params;
const study = await getCaseStudyBySlug(slug!);

if (!study) {
  return new Response(null, { status: 404 });
}

applyCmsCacheHeaders(Astro.response.headers, ['cms', 'case-studies', `case-study:${study.slug}`]);
const relatedGroups = getCaseStudyRelatedGroups(study.slug);
const ctaHref =
  !study.cta?.buttonHref || study.cta.buttonHref === '/book-a-call'
    ? BOOKING_URL
    : study.cta.buttonHref;
const ctaExternal = isExternalHref(ctaHref);
const pageTitle = study.seoTitle ?? `${study.title} | Aizaz Studio`;
const pageDescription = study.seoDescription ?? study.description;
const canonicalPath = study.canonicalPath ?? `/case-studies/${study.slug}`;
const ogTitle = study.ogTitle ?? pageTitle;
const ogDescription = study.ogDescription ?? pageDescription;
const ogImage = study.ogImageUrl
  ? study.ogImageUrl.startsWith('http')
    ? study.ogImageUrl
    : `${SITE_URL}${study.ogImageUrl}`
  : study.imageUrl;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.title,
  description: pageDescription,
  ...(study.author
    ? {
        author: {
          '@type': 'Person',
          name: study.author.name,
          ...(study.author.role ? { jobTitle: study.author.role } : {}),
          ...(study.author.photoUrl ? { image: study.author.photoUrl } : {}),
          ...((() => {
            const sameAs = [
              study.author.linkedin,
              study.author.xUrl,
              study.author.githubUrl,
            ].filter((url): url is string => Boolean(url));
            return sameAs.length ? { sameAs } : {};
          })()),
        },
      }
    : {
        author: {
          '@type': 'Organization',
          name: 'Aizaz Studio',
          url: SITE_URL,
        },
      }),
  publisher: {
    '@type': 'Organization',
    name: 'Aizaz Studio',
    url: SITE_URL,
  },
  mainEntityOfPage: `${SITE_URL}${canonicalPath}`,
  ...(ogImage ? { image: ogImage } : {}),
};
const projectFacts = [
  { label: 'Client', value: study.client },
  { label: 'Location', value: study.location },
  { label: 'Industry', value: study.industry },
  { label: 'Engagement', value: study.projectValue },
  { label: 'Delivery', value: study.deliveryDuration },
].filter((fact): fact is { label: string; value: string } => Boolean(fact.value));
---

<SiteShell
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  noindex={study.noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="works-detail">
    <header class="works-detail__intro">
      <div class="c-wrap">
        <div class="works-detail__intro-grid">
          <div class="works-detail__heading">
            <p class="c-micro c-red">Case study <span aria-hidden="true">/</span> {study.category}</p>
            <h1>{study.title}</h1>
            <p class="works-detail__subtitle">{study.subtitle}</p>
          </div>
          <div class="works-detail__summary">
            <p>{study.description}</p>
            {study.author && (
              <div class="works-detail__author">
                <AuthorCard author={study.author} wrapperClass="text-left" />
              </div>
            )}
            {(study.deliveredBy || study.engagementNote) && (
              <div class="works-detail__provenance">
                {study.deliveredBy && <p>Delivered by {study.deliveredBy}</p>}
                {study.engagementNote && <p>{study.engagementNote}</p>}
              </div>
            )}
          </div>
        </div>
      </div>
    </header>

    <section class="works-detail__visual" aria-label={`${study.title} project preview`}>
      <div class="c-wrap">
        <figure class="works-detail__hero">
          {study.imageUrl ? (
            <img src={study.imageUrl} alt={study.title} loading="eager" fetchpriority="high" decoding="async" width="1600" height="900" />
          ) : (
            <LocalImage src={study.image} alt={study.title} loading="eager" fetchpriority="high" kind="hero" width={1600} />
          )}
          <figcaption>
            <span>{study.client ?? study.title}</span>
            <span>{study.category}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    {(projectFacts.length > 0 || (study.atAGlance && study.atAGlance.length > 0)) && (
      <section class="works-detail__snapshot" aria-labelledby="project-snapshot-title">
        <div class="c-wrap">
          <header class="works-detail__snapshot-header">
            <p class="c-micro c-red">Project snapshot</p>
            <h2 id="project-snapshot-title">The work at a glance</h2>
          </header>
          {projectFacts.length > 0 && (
            <dl class="works-detail__facts">
              {projectFacts.map((fact, index) => (
                <div>
                  <dt><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          )}
          {study.atAGlance && study.atAGlance.length > 0 && (
            <div class="works-detail__stats">
              {study.atAGlance.map((item) => (
                <article>
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                  {item.sublabel && <small>{item.sublabel}</small>}
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )}

    <div class="c-wrap works-detail__body">
      {study.testimonial && (
        <section class="works-detail__block works-detail__testimonial">
          <p class="c-micro c-red">Client perspective</p>
          {study.testimonial.rating && <p class="works-detail__rating">{study.testimonial.rating}</p>}
          <blockquote class="works-detail__quote">“{study.testimonial.quote}”</blockquote>
          <footer>
            <p>
              — {study.testimonial.author}{study.testimonial.role ? `, ${study.testimonial.role}` : ''}
              {study.testimonial.source ? ` · ${study.testimonial.source}` : ''}
            </p>
            {study.testimonial.engagementMeta && <p>{study.testimonial.engagementMeta}</p>}
          </footer>
        </section>
      )}

      {study.engagement && study.engagement.length > 0 && (
        <section class="works-detail__block">
          <header class="works-detail__section-heading">
            <p class="c-micro c-red">Engagement</p>
            <h2>Project details</h2>
          </header>
          <dl class="works-detail__detail-list">
            {study.engagement.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      {study.detailedContent?.map((section, sectionIndex) => (
        <section class="works-detail__block">
          <header class="works-detail__section-heading">
            <p class="works-detail__section-index" aria-hidden="true">
              {String(sectionIndex + 1).padStart(2, '0')}
            </p>
            <div>
              <h2>{section.title}</h2>
              {section.content && <p>{section.content}</p>}
            </div>
          </header>
          {section.items && (
            <div class="works-detail__items">
              {section.items.map((item) => (
                <article class="works-detail__card">
                  <div class="works-detail__card-copy">
                    <h3>{item.title}</h3>
                    {item.description && <p>{item.description}</p>}
                    {item.points && (
                      <ul>
                        {item.points.map((point) => <li>{point}</li>)}
                      </ul>
                    )}
                    {item.table && (
                      <div class="sp-table-wrap">
                        <table class="sp-table">
                          <thead>
                            <tr>
                              <th>{item.tableHeaders?.left ?? 'Item'}</th>
                              <th>{item.tableHeaders?.right ?? 'Value'}</th>
                            </tr>
                          </thead>
                          <tbody>
                            {item.table.map((row) => (
                              <tr>
                                <td>{row.label}</td>
                                <td>{row.value}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    )}
                    {item.tableCaption && <p class="works-detail__caption">{item.tableCaption}</p>}
                  </div>
                  {item.image ? (
                    <figure class="works-detail__media">
                      <LocalImage src={item.image} alt={item.title} kind="content" width={1200} />
                    </figure>
                  ) : item.imageUrl ? (
                    <figure class="works-detail__media">
                      <img src={item.imageUrl} alt={item.title} loading="lazy" decoding="async" width="1200" height="800" />
                    </figure>
                  ) : null}
                </article>
              ))}
            </div>
          )}
        </section>
      ))}

      {!study.detailedContent && (
        <>
          <section class="works-detail__block">
            <header class="works-detail__section-heading">
              <p class="works-detail__section-index" aria-hidden="true">01</p>
              <div><h2>The challenge</h2><p>{study.content.challenge}</p></div>
            </header>
          </section>
          {study.content.testimonial && (
            <section class="works-detail__block works-detail__testimonial">
              <p class="c-micro c-red">Client perspective</p>
              <blockquote class="works-detail__quote">“{study.content.testimonial.quote}”</blockquote>
              <footer><p>— {study.content.testimonial.author}, {study.content.testimonial.role}</p></footer>
            </section>
          )}
          <section class="works-detail__block">
            <header class="works-detail__section-heading">
              <p class="works-detail__section-index" aria-hidden="true">02</p>
              <div><h2>Our solution</h2><p>{study.content.solution}</p></div>
            </header>
            {study.gallery?.[0] && (
              <figure class="works-detail__media">
                <img src={study.gallery[0]} alt="Solution details" loading="lazy" decoding="async" />
              </figure>
            )}
          </section>
          <section class="works-detail__block">
            <header class="works-detail__section-heading">
              <p class="works-detail__section-index" aria-hidden="true">03</p>
              <div><h2>The outcome</h2><p>{study.content.outcome}</p></div>
            </header>
            {study.gallery?.[1] && (
              <figure class="works-detail__media">
                <img src={study.gallery[1]} alt="Outcome details" loading="lazy" decoding="async" />
              </figure>
            )}
          </section>
        </>
      )}
    </div>

    <RelatedContent groups={relatedGroups} />

    {study.cta && (
      <section class="sp-section">
        <div class="c-wrap">
          <div class="sp-promo">
            <div class="sp-promo__copy">
              <p class="c-lede">{study.cta.headline}</p>
            </div>
            <a
              class="c-btn"
              href={ctaHref}
              target={ctaExternal ? '_blank' : undefined}
              rel={ctaExternal ? 'noopener noreferrer' : undefined}
            >{study.cta.buttonText}</a>
          </div>
        </div>
      </section>
    )}

    <PageCTA />
  </article>
</SiteShell>
