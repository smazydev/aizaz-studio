---
export const prerender = false;

import SiteShell from '../../components/SiteShell.astro';
import PageCTA from '../../components/PageCTA.astro';
import { SITE_URL } from '../../data/seoPages';
import { BOOKING_URL, isExternalHref } from '../../data/siteConfig';
import { getCaseStudyBySlug } from '../../lib/sanity/caseStudies';
import AuthorCard from '../../components/AuthorCard.astro';
import { Image } from 'astro:assets';
import LocalImage from '../../components/LocalImage.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { applyCmsCacheHeaders } from '../../lib/cms-cache';
import { getCaseStudyRelatedGroups } from '../../data/internalLinks';

const { slug } = Astro.params;
const study = await getCaseStudyBySlug(slug!);

if (!study) {
  return new Response(null, { status: 404 });
}

applyCmsCacheHeaders(Astro.response.headers, ['cms', 'case-studies', `case-study:${study.slug}`]);
const relatedGroups = getCaseStudyRelatedGroups(study.slug);
const ctaHref =
  !study.cta?.buttonHref || study.cta.buttonHref === '/book-a-call'
    ? BOOKING_URL
    : study.cta.buttonHref;
const ctaExternal = isExternalHref(ctaHref);
const pageTitle = study.seoTitle ?? `${study.title} | Aizaz Studio`;
const pageDescription = study.seoDescription ?? study.description;
const canonicalPath = study.canonicalPath ?? `/case-studies/${study.slug}`;
const ogTitle = study.ogTitle ?? pageTitle;
const ogDescription = study.ogDescription ?? pageDescription;
const ogImage = study.ogImageUrl
  ? study.ogImageUrl.startsWith('http')
    ? study.ogImageUrl
    : `${SITE_URL}${study.ogImageUrl}`
  : study.imageUrl;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: study.title,
  description: pageDescription,
  ...(study.author
    ? {
        author: {
          '@type': 'Person',
          name: study.author.name,
          ...(study.author.role ? { jobTitle: study.author.role } : {}),
          ...(study.author.photoUrl ? { image: study.author.photoUrl } : {}),
          ...((() => {
            const sameAs = [
              study.author.linkedin,
              study.author.xUrl,
              study.author.githubUrl,
            ].filter((url): url is string => Boolean(url));
            return sameAs.length ? { sameAs } : {};
          })()),
        },
      }
    : {
        author: {
          '@type': 'Organization',
          name: 'Aizaz Studio',
          url: SITE_URL,
        },
      }),
  publisher: {
    '@type': 'Organization',
    name: 'Aizaz Studio',
    url: SITE_URL,
  },
  mainEntityOfPage: `${SITE_URL}${canonicalPath}`,
  ...(ogImage ? { image: ogImage } : {}),
};
---

<SiteShell
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalPath}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  noindex={study.noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="works-detail">
    <header class="page-hero">
      <div class="c-wrap">
        <p class="c-micro c-red">{study.category}</p>
        <h1 class="page-title">{study.subtitle}</h1>
        <p class="c-lede page-hero__lede">{study.description}</p>
        {study.author && (
          <div class="works-detail__author">
            <AuthorCard author={study.author} wrapperClass="text-left" />
          </div>
        )}
        {study.deliveredBy && <p class="c-lede works-detail__note">Delivered by {study.deliveredBy}</p>}
        {study.engagementNote && <p class="c-lede works-detail__note">{study.engagementNote}</p>}
      </div>
    </header>

    {(study.client || study.location || study.industry || study.projectValue || study.deliveryDuration) && (
      <section class="sp-section sp-section--tight">
        <div class="c-wrap">
          <div class="sp-grid sp-grid--3">
            {study.client && <div class="sp-card"><p class="c-micro">Client</p><p class="sp-card__title">{study.client}</p></div>}
            {study.location && <div class="sp-card"><p class="c-micro">Location</p><p class="sp-card__title">{study.location}</p></div>}
            {study.industry && <div class="sp-card"><p class="c-micro">Industry</p><p class="sp-card__title">{study.industry}</p></div>}
            {study.projectValue && <div class="sp-card"><p class="c-micro">Engagement</p><p class="sp-card__title">{study.projectValue}</p></div>}
            {study.deliveryDuration && <div class="sp-card"><p class="c-micro">Delivery</p><p class="sp-card__title">{study.deliveryDuration}</p></div>}
          </div>
        </div>
      </section>
    )}

    {study.atAGlance && study.atAGlance.length > 0 && (
      <section class="sp-section sp-section--tight">
        <div class="c-wrap">
          <div class="sp-grid sp-grid--3">
            {study.atAGlance.map((item) => (
              <div class="sp-card" style="text-align:center">
                <p class="sp-card__title" style="font-size: clamp(1.6rem, 3vw, 2.2rem)">{item.value}</p>
                <p class="c-lede sp-card__body">{item.label}</p>
                {item.sublabel && <p class="c-micro" style="margin-top:8px">{item.sublabel}</p>}
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="sp-section sp-section--tight">
      <div class="c-wrap">
        <div class:list={['works-detail__hero', 'cs-cover-frame', study.coverFit === 'contain' && 'works-detail__hero--contain']}>
          {study.imageUrl ? (
            <img
              src={study.imageUrl}
              alt={study.imageAlt ?? study.title}
              loading="eager"
              fetchpriority="high"
              width="2048"
              height="958"
              decoding="async"
            />
          ) : study.coverFit === 'contain' ? (
            <Image
              src={study.image}
              alt={study.imageAlt ?? study.title}
              width={1536}
              height={1024}
              widths={[640, 960, 1280, 1536]}
              sizes="(min-width: 1100px) min(1340px, 92vw), 92vw"
              quality={88}
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <Image
              src={study.image}
              alt={study.imageAlt ?? study.title}
              width={2048}
              height={958}
              widths={[960, 1280, 1600, 2048, 3008]}
              sizes="(min-width: 1100px) min(1340px, 92vw), 92vw"
              quality={88}
              loading="eager"
              fetchpriority="high"
            />
          )}
        </div>
      </div>
    </section>

    <div class="c-wrap works-detail__body">
      {study.testimonial && (
        <section class="works-detail__block">
          <div class="sp-card">
            {study.testimonial.rating && <p class="c-micro c-red">{study.testimonial.rating}</p>}
            <blockquote class="works-detail__quote">“{study.testimonial.quote}”</blockquote>
            <p class="c-lede">
              {study.testimonial.author}{study.testimonial.role ? `, ${study.testimonial.role}` : ''}
              {study.testimonial.source ? ` · ${study.testimonial.source}` : ''}
            </p>
            {study.testimonial.engagementMeta && <p class="c-micro" style="margin-top:12px">{study.testimonial.engagementMeta}</p>}
          </div>
        </section>
      )}

      {study.engagement && study.engagement.length > 0 && (
        <section class="works-detail__block">
          <h2 class="page-h2">Project details</h2>
          <div class="sp-grid" style="margin-top: 20px">
            {study.engagement.map((detail) => (
              <div class="sp-card">
                <p class="c-micro">{detail.label}</p>
                <p class="sp-card__title">{detail.value}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {study.detailedContent?.map((section) => (
        <section class="works-detail__block">
          <h2 class="page-h2">{section.title}</h2>
          {section.content && <p class="c-lede" style="margin-top: 16px">{section.content}</p>}
          {section.items && (
            <div class="works-detail__items">
              {section.items.map((item) => (
                <div class="sp-card">
                  <h3 class="sp-card__title">{item.title}</h3>
                  {item.description && <p class="c-lede sp-card__body">{item.description}</p>}
                  {item.points && (
                    <ul class="sp-list" style="margin-top: 14px">
                      {item.points.map((point) => <li>{point}</li>)}
                    </ul>
                  )}
                  {item.table && (
                    <div class="sp-table-wrap" style="margin-top: 16px">
                      <table class="sp-table">
                        <thead>
                          <tr>
                            <th>{item.tableHeaders?.left ?? 'Item'}</th>
                            <th>{item.tableHeaders?.right ?? 'Value'}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {item.table.map((row) => (
                            <tr>
                              <td>{row.label}</td>
                              <td>{row.value}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                  {item.tableCaption && <p class="c-micro" style="margin-top:10px">{item.tableCaption}</p>}
                  {item.image ? (
                    <div class="works-detail__media sp-media-frame sp-media-frame--21 sp-media-frame--contain">
                      <LocalImage src={item.image} alt={item.title} kind="content" width={1200} />
                    </div>
                  ) : item.imageUrl ? (
                    <div class="works-detail__media sp-media-frame sp-media-frame--21 sp-media-frame--contain">
                      <img src={item.imageUrl} alt={item.title} loading="lazy" width="1200" height="800" />
                    </div>
                  ) : null}
                </div>
              ))}
            </div>
          )}
        </section>
      ))}

      {!study.detailedContent && (
        <>
          <section class="works-detail__block">
            <h2 class="page-h2">The challenge</h2>
            <p class="c-lede" style="margin-top: 16px">{study.content.challenge}</p>
          </section>
          {study.content.testimonial && (
            <section class="works-detail__block">
              <div class="sp-card">
                <blockquote class="works-detail__quote">“{study.content.testimonial.quote}”</blockquote>
                <p class="c-lede">{study.content.testimonial.author}, {study.content.testimonial.role}</p>
              </div>
            </section>
          )}
          <section class="works-detail__block">
            <h2 class="page-h2">Our solution</h2>
            <p class="c-lede" style="margin-top: 16px">{study.content.solution}</p>
            {study.gallery?.[0] && (
              <div class="works-detail__media sp-media-frame sp-media-frame--21 sp-media-frame--contain">
                <img src={study.gallery[0]} alt="Solution details" loading="lazy" />
              </div>
            )}
          </section>
          <section class="works-detail__block">
            <h2 class="page-h2">The outcome</h2>
            <p class="c-lede" style="margin-top: 16px">{study.content.outcome}</p>
            {study.gallery?.[1] && (
              <div class="works-detail__media sp-media-frame sp-media-frame--21 sp-media-frame--contain">
                <img src={study.gallery[1]} alt="Outcome details" loading="lazy" />
              </div>
            )}
          </section>
        </>
      )}
    </div>

    <RelatedContent groups={relatedGroups} />

    {study.cta && (
      <section class="sp-section">
        <div class="c-wrap">
          <div class="sp-promo">
            <div class="sp-promo__copy">
              <p class="c-lede">{study.cta.headline}</p>
            </div>
            <a
              class="c-btn"
              href={ctaHref}
              target={ctaExternal ? '_blank' : undefined}
              rel={ctaExternal ? 'noopener noreferrer' : undefined}
            >{study.cta.buttonText}</a>
          </div>
        </div>
      </section>
    )}

    <PageCTA />
  </article>
</SiteShell>
