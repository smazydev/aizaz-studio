---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import BlogCard from '../components/BlogCard.astro';
import PageCTA from '../components/PageCTA.astro';
import { getLinkablePosts, getPublishedPosts } from '../lib/blog';
import { getBlogFilterCategories } from '../lib/blog-categories';
import { applyCmsCacheHeaders } from '../lib/cms-cache';

const blogs = getLinkablePosts(await getPublishedPosts());
const [featured, ...rest] = blogs;
const categories = getBlogFilterCategories();

applyCmsCacheHeaders(Astro.response.headers, ['cms', 'blog']);
---

<SiteShell
  title="Blog | AI, Automation & Engineering Insights | Aizaz.studio"
  description="Practical insights on AI automation, SaaS engineering, NetSuite integrations, and building systems that help businesses scale without operational chaos."
  canonical="/blog"
>
  <PageHero
    eyebrow="Insights"
    title="Playbooks for"
    highlight="smarter operations"
    description="What we've learned building, fixing, and operating real software systems — from AI and SaaS to NetSuite, integrations, and production failures."
  />

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-promo">
        <div class="sp-promo__copy">
          <p class="c-micro c-red">Short version</p>
          <p class="c-lede">Book a call and we will map one high-impact workflow you can automate in 14 days.</p>
        </div>
        <a class="c-btn" href="/ai-systems-sprint">AI Systems Sprint</a>
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap">
      {featured && (
        <div class="blog-index__featured">
          <p class="c-micro c-red">Featured</p>
          <BlogCard blog={featured} featured />
        </div>
      )}

      <div class="blog-filters" id="blog-filters">
        {categories.map((category, index) => (
          <button
            type="button"
            data-filter={category}
            class:list={['blog-filters__btn', index === 0 && 'is-active']}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="blog-index__grid" id="blog-grid">
        {rest.map((blog) => (
          <div data-category={blog.category} class="blog-item">
            <BlogCard blog={blog} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <PageCTA />
</SiteShell>

<script>
  const filters = document.querySelectorAll('#blog-filters button');
  const items = document.querySelectorAll('.blog-item');

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.getAttribute('data-filter');

      filters.forEach((btn) => {
        btn.classList.toggle('is-active', btn === filter);
      });

      items.forEach((item) => {
        const match = category === 'All' || item.getAttribute('data-category') === category;
        item.classList.toggle('hidden', !match);
      });
    });
  });
</script>
