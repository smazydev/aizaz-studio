---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import BlogCard from '../components/BlogCard.astro';
import PageCTA from '../components/PageCTA.astro';
import { SITE_URL } from '../data/seoPages';
import { getLinkablePosts, getPublishedPosts } from '../lib/blog';
import { getBlogFilterCategories } from '../lib/blog-categories';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { buildListingPageSchemas } from '../lib/seoSchema';

const blogs = getLinkablePosts(await getPublishedPosts());
const [featured, ...rest] = blogs;
const categories = getBlogFilterCategories();
const pageTitle = 'Blog | AI, Automation & Systems Notes | Aizaz';
const pageDescription =
  'Notes from shipping AI automation, SaaS, NetSuite integrations, and production systems — what broke, what we fixed, and what we would do again.';
const schemas = buildListingPageSchemas({
  name: 'Engineering Insights',
  description: pageDescription,
  canonicalPath: '/blog',
  items: blogs.map((post) => ({
    name: post.title,
    url: `${SITE_URL}/blog/${post.slug}`,
  })),
});

applyCmsCacheHeaders(Astro.response.headers, ['cms', 'blog']);
---

<SiteShell
  title={pageTitle}
  description={pageDescription}
  canonical="/blog"
  schemas={schemas}
>
  <PageHero
    eyebrow="Insights"
    title="Notes from"
    highlight="shipping systems"
    description="What we’ve learned building, fixing, and operating real software — AI, SaaS, NetSuite, integrations, and production failures."
  />

  <section class="sp-section sp-section--tight">
    <div class="c-wrap">
      <div class="sp-promo">
        <div class="sp-promo__copy">
          <p class="c-micro c-red">Short version</p>
          <p class="c-lede">If one workflow is eating the week, we can map whether a 14-day sprint is the right first step.</p>
        </div>
        <a class="c-btn" href="/ai-systems-sprint">Discuss a 14-day sprint</a>
      </div>
    </div>
  </section>

  <section class="sp-section">
    <div class="c-wrap">
      {featured && (
        <div class="blog-index__featured">
          <p class="c-micro c-red">Featured</p>
          <BlogCard blog={featured} featured />
        </div>
      )}

      <div class="blog-filters" id="blog-filters">
        {categories.map((category, index) => (
          <button
            type="button"
            data-filter={category}
            class:list={['blog-filters__btn', index === 0 && 'is-active']}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="blog-index__grid" id="blog-grid">
        {rest.map((blog) => (
          <div data-category={blog.category} class="blog-item">
            <BlogCard blog={blog} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <PageCTA />
</SiteShell>

<script>
  const filters = document.querySelectorAll('#blog-filters button');
  const items = document.querySelectorAll('.blog-item');

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      const category = filter.getAttribute('data-filter');

      filters.forEach((btn) => {
        btn.classList.toggle('is-active', btn === filter);
      });

      items.forEach((item) => {
        const match = category === 'All' || item.getAttribute('data-category') === category;
        item.classList.toggle('hidden', !match);
      });
    });
  });
</script>
