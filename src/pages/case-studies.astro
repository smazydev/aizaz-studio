---
import SiteShell from '../components/SiteShell.astro';
import { CTA } from '../components/CTA';
import PageHero from '../components/PageHero.astro';
import CaseStudyShowcase from '../components/CaseStudyShowcase.astro';
---

<SiteShell
  title="Case Studies | Aizaz.studio"
  description="See how Aizaz.studio builds compliance platforms, investment intelligence systems, and production-grade software for scaling businesses."
  canonical="/case-studies"
>
      <PageHero
        eyebrow="Case Studies"
        title="Systems built for"
        highlight="real world scale"
        description="Compliance platforms, fintech infrastructure, and production systems, designed for security, scale, and operations teams that cannot afford fragile software."
      />
      <CaseStudyShowcase showHeader={false} />
      <CTA client:visible />
</SiteShell>
