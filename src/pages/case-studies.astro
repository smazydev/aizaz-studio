---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import CaseStudyShowcase from '../components/CaseStudyShowcase.astro';
import PageCTA from '../components/PageCTA.astro';
import { getAllCaseStudies } from '../lib/sanity/caseStudies';
import { applyCmsCacheHeaders } from '../lib/cms-cache';

const caseStudies = await getAllCaseStudies();
/** Independent of Homepage CMS — full public listing order from getAllCaseStudies(). */
const showcaseItems = caseStudies.map((study) => ({
  study,
  tabLabel: study.category || study.title,
}));
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'case-studies']);
---

<SiteShell
  title="Case Studies | Aizaz.studio"
  description="See how Aizaz.studio builds compliance platforms, investment intelligence systems, and production-grade software for scaling businesses."
  canonical="/case-studies"
>
  <PageHero
    eyebrow="Works"
    title="Systems built for"
    highlight="real-world scale"
    description="Compliance platforms, SaaS products, and operational systems — designed for security, scale, and teams that cannot afford fragile software."
  >
    <a class="c-btn" href="/book-a-call">Book a Call</a>
    <a class="c-btn c-btn--ghost" href="/services">Services</a>
  </PageHero>

  <CaseStudyShowcase items={showcaseItems} showHeader={false} />
  <PageCTA title="Building something similar?" lede="Book a call to talk through scope, stack, and a sensible first step." />
</SiteShell>
