---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { Footer } from '../components/Footer';
import { CTA } from '../components/CTA';
import PageHero from '../components/PageHero.astro';
import CaseStudyShowcase from '../components/CaseStudyShowcase.astro';
import { getAllCaseStudies } from '../lib/sanity/caseStudies';

const caseStudies = await getAllCaseStudies();
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout
  title="Case Studies | Aizaz.studio"
  description="See how Aizaz.studio builds compliance platforms, investment intelligence systems, and production-grade software for scaling businesses."
  canonical="/case-studies"
>
  <div class="min-h-screen bg-black text-white selection:bg-primary-500/30 selection:text-primary-200 overflow-x-hidden">
    <Navbar client:load />
    <main>
      <PageHero
        eyebrow="Case Studies"
        title="Systems built for"
        highlight="real-world scale"
        description="Compliance platforms, fintech infrastructure, and production systems — designed for security, scale, and operations teams that cannot afford fragile software."
      />
      <CaseStudyShowcase studies={caseStudies} showHeader={false} />
      <CTA client:visible />
    </main>
    <Footer client:visible />
  </div>
</Layout>
