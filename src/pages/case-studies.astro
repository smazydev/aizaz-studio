---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import CaseStudyShowcase from '../components/CaseStudyShowcase.astro';
import PageCTA from '../components/PageCTA.astro';
import PageSentinel from '../components/PageSentinel.astro';
import ReviewCarousel from '../components/ReviewCarousel.astro';
import { SITE_URL } from '../data/seoPages';
import { getAllCaseStudies } from '../lib/sanity/caseStudies';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { BOOKING_URL } from '../data/siteConfig';
import { reviewsFromCaseStudies } from '../data/homeFeedback';
import { buildListingPageSchemas } from '../lib/seoSchema';

const caseStudies = await getAllCaseStudies();
const reviews = reviewsFromCaseStudies(caseStudies);
/** Independent of Homepage CMS — full public listing order from getAllCaseStudies(). */
const showcaseItems = caseStudies.map((study) => ({
  study,
  tabLabel: study.category || study.title,
}));
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'case-studies']);
const pageTitle = 'Case Studies | Aizaz.studio';
const pageDescription =
  'Public work you can inspect. PropertyMatch shipped as a SaaS MVP in 14 days. 1Archiver was designed for tens of terabytes of email.';
const schemas = buildListingPageSchemas({
  name: 'Case Studies',
  description: pageDescription,
  canonicalPath: '/case-studies',
  items: caseStudies.map((study) => ({
    name: study.title,
    url: `${SITE_URL}/case-studies/${study.slug}`,
  })),
});
---

<SiteShell
  title={pageTitle}
  description={pageDescription}
  canonical="/case-studies"
  schemas={schemas}
>
  <PageSentinel>
    <PageHero
      eyebrow="Works"
      title="Systems we shipped"
      highlight="for real operations"
      description="Compliance platforms, SaaS products, and operational systems. Every card opens the full case study — no invented metrics."
    >
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
      <a class="c-btn c-btn--ghost" href="/services">What we take on</a>
      <ReviewCarousel slot="below" items={reviews} />
    </PageHero>
  </PageSentinel>

  <CaseStudyShowcase items={showcaseItems} showHeader={false} />
  <PageCTA title="Building something similar?" lede="Tell us what needs fixing. We’ll map scope, stack, and a sensible first step." />
</SiteShell>
