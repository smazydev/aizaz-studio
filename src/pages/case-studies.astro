---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import CaseStudyShowcase from '../components/CaseStudyShowcase.astro';
import PageCTA from '../components/PageCTA.astro';
import PageSentinel from '../components/PageSentinel.astro';
import { getAllCaseStudies } from '../lib/sanity/caseStudies';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { BOOKING_URL } from '../data/siteConfig';

const caseStudies = await getAllCaseStudies();
/** Independent of Homepage CMS — full public listing order from getAllCaseStudies(). */
const showcaseItems = caseStudies.map((study) => ({
  study,
  tabLabel: study.category || study.title,
}));
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'case-studies']);
---

<SiteShell
  title="Case Studies | Aizaz Studio"
  description="Proof of systems Aizaz Studio designed, built, and shipped, from focused MVPs to production platforms still running today."
  canonical="/case-studies"
>
  <PageSentinel crop="works">
    <PageHero
      eyebrow="Case Studies"
      title="Systems built for real world scale"
      wide
      description="Proof of real systems our engineers designed, built, and shipped, from focused MVPs to production platforms still running today."
    >
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a Call</a>
      <a class="c-btn c-btn--ghost" href="/services">Services</a>
    </PageHero>
  </PageSentinel>

  <CaseStudyShowcase items={showcaseItems} showHeader={false} />
  <PageCTA title="Building something similar?" lede="Book a call to talk through scope, stack, and a sensible first step." />
</SiteShell>
