---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import { security } from '../data/commercialPages';

const c = security;
---

<SiteShell title={c.metaTitle} description={c.metaDescription} canonical="/security">
  <PageHero eyebrow="Trust" title={c.title} description={c.heroSubtitle} />

  <section class="sp-section">
    <div class="c-wrap seo-measure">
      {c.sections.map((section) => (
        <article class="seo-longform__block">
          <h2 class="page-h2">{section.heading}</h2>
          {section.paragraphs.map((p) => (
            <p class="c-lede">{p}</p>
          ))}
          {'bullets' in section && section.bullets && (
            <ul class="sp-list" style="margin-top: 16px">
              {section.bullets.map((point) => <li>{point}</li>)}
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <PageCTA
    title="Discuss your security requirements"
    lede="Book a call to talk through access, data handling, and delivery practices for your engagement."
  secondaryHref=""
  secondaryLabel=""
/>
</SiteShell>
