---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { CTA } from '../../components/CTA';
import BlogPostContent from '../../components/BlogPostContent.astro';
import { buildArticleSchema, getPublishedPostBySlug, getPublishedPosts, getRelatedPosts } from '../../lib/blog';
import { SITE_URL } from '../../data/seoPages';

const { slug } = Astro.params;
const blog = await getPublishedPostBySlug(slug!);

if (!blog) {
  return Astro.redirect('/blog', 302);
}

const allPosts = await getPublishedPosts();
const related = getRelatedPosts(allPosts, blog.slug);
const articleSchema = buildArticleSchema(blog, SITE_URL);
const pageTitle = blog.seoTitle ?? `${blog.title} | Aizaz.studio Blog`;
const pageDescription = blog.metaDescription ?? blog.excerpt;
const ogTitle = blog.ogTitle ?? pageTitle;
const ogDescription = blog.ogDescription ?? pageDescription;
const ogImage = blog.ogImage
  ? blog.ogImage.startsWith('http')
    ? blog.ogImage
    : `${SITE_URL}${blog.ogImage}`
  : undefined;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={blog.canonicalUrl ?? `/blog/${blog.slug}`}
  keywords={blog.focusKeyword ? [...blog.tags, blog.focusKeyword] : blog.tags}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  noindex={blog.noindex}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <div class="site-shell min-h-screen bg-black text-white selection:bg-primary-500/30 selection:text-primary-200 overflow-x-hidden">
    <Navbar client:load />

    <main class="pb-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-28">
        <a href="/blog" class="inline-flex items-center gap-2 text-zinc-500 hover:text-white transition-colors text-sm font-medium mb-10 group">
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          Back to Blog
        </a>

        <BlogPostContent blog={blog} related={related} />
      </div>

      <div class="mt-20">
        <CTA client:visible />
      </div>
    </main>
    <Footer client:visible />
  </div>
</Layout>
