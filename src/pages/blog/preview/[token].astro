---
import Layout from '../../../layouts/Layout.astro';
import { Navbar } from '../../../components/Navbar';
import { Footer } from '../../../components/Footer';
import BlogPostContent from '../../../components/BlogPostContent.astro';
import { getPreviewPostByToken } from '../../../lib/blog';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const token = Astro.params.token!;
const previewPost = await getPreviewPostByToken(db, token);

if (!previewPost) {
    return Astro.redirect('/blog');
}
---

<Layout
  title={`Preview: ${previewPost.title}`}
  description={previewPost.excerpt}
  noindex={true}
>
  <div class="site-shell min-h-screen bg-black text-white selection:bg-primary-500/30 selection:text-primary-200 overflow-x-hidden">
    <Navbar client:load />

    <main class="pb-24">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-28">
        <div class="mb-8 p-4 rounded-2xl border border-amber-500/20 bg-amber-500/10 text-amber-200 text-sm">
          Draft preview. This article is not published yet.
        </div>
        <BlogPostContent blog={previewPost} preview={true} />
      </div>
    </main>
    <Footer client:visible />
  </div>
</Layout>
