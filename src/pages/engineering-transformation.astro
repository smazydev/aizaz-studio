---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import Process from '../components/Process.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import { BOOKING_URL } from '../data/siteConfig';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { getEngineeringTransformationPage, getProcessPage } from '../lib/sanity/sitePages';

const [page, process] = await Promise.all([
  getEngineeringTransformationPage(),
  getProcessPage(),
]);
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages']);
---

<SiteShell
  title={page.metaTitle}
  description={page.metaDescription}
  canonical="/engineering-transformation"
>
  <PageHero
    eyebrow={page.heroEyebrow ?? 'How we work'}
    title={page.title}
    highlight={page.heroHighlight}
    description={page.heroSubtitle}
  >
    <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
    <a class="c-btn c-btn--ghost" href="/process">Process summary</a>
  </PageHero>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap seo-measure" style="text-align:center">
      <p class="c-lede">
        {page.intro ?? 'We do not assign random freelancers or disappear after a demo. One senior team maps your workflow, connects your tools, deploys to production, and documents everything your ops team needs to run it.'}
      </p>
    </div>
  </section>

  <Process stepsOnly steps={process.steps} />
  <PageCTA />
</SiteShell>
