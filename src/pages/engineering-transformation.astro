---
import SiteShell from '../components/SiteShell.astro';
import Process from '../components/Process.astro';
import PageHero from '../components/PageHero.astro';
---

<SiteShell
  title="How We Work | Aizaz.studio"
  description="Our process for discovery, architecture, build, deployment, and handoff, designed to ship reliable AI, automation, and software systems."
  canonical="/engineering-transformation"
>

    <div class="pb-24">
      <PageHero
        eyebrow="How We Work"
        title="From manual workflow"
        highlight="to production system"
        description="Discovery, architecture, build, deployment, and handoff, the same disciplined process whether you start with a 14 day sprint or a full platform engagement."
      />

      <section class="pb-8">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <p class="text-zinc-400 text-lg leading-relaxed text-center">
            We do not assign random freelancers or disappear after a demo. One senior team maps your workflow, connects your tools, deploys to production, and documents everything your ops team needs to run it.
          </p>
        </div>
      </section>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8">
        <Process stepsOnly />
      </div>
    </div>
</SiteShell>
