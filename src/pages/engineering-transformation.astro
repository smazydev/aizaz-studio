---
import SiteShell from '../components/SiteShell.astro';
import Process from '../components/Process.astro';
import PageHero from '../components/PageHero.astro';
import PageCTA from '../components/PageCTA.astro';
import { BOOKING_URL } from '../data/siteConfig';
---

<SiteShell
  title="How We Work | Aizaz.studio"
  description="Our process for discovery, architecture, build, deployment, and handoff, designed to ship reliable AI, automation, and software systems."
  canonical="/engineering-transformation"
>
  <PageHero
    eyebrow="How we work"
    title="From manual workflow"
    highlight="to production system"
    description="Discovery, design, build, integrate and ship, then observe. The same workflow whether you start with a 14-day sprint or a full platform engagement."
  >
    <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a Call</a>
    <a class="c-btn c-btn--ghost" href="/process">Process summary</a>
  </PageHero>

  <section class="sp-section sp-section--tight">
    <div class="c-wrap seo-measure">
      <p class="c-lede">
        We do not assign random freelancers or disappear after a demo. One senior team maps your workflow, connects your tools, deploys to production, and documents everything your ops team needs to run it.
      </p>
    </div>
  </section>

  <Process stepsOnly />
  <PageCTA />
</SiteShell>
