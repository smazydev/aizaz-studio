---
export const prerender = false;

import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { BOOKING_URL } from '../data/siteConfig';
import { applyCmsCacheHeaders } from '../lib/cms-cache';
import { getStartProjectPage } from '../lib/sanity/sitePages';
import { getSiteSettings } from '../lib/sanity/siteSettings';

const [page, settings] = await Promise.all([getStartProjectPage(), getSiteSettings()]);
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages']);
const contact = settings.studio;
---

<SiteShell
  title={page.metaTitle}
  description={page.metaDescription}
  canonical="/start-a-project"
  noindex={true}
>
  <PageHero
    eyebrow={page.heroEyebrow ?? 'Start a project'}
    title={page.title}
    description={page.heroSubtitle}
  >
    <a class="c-btn c-btn--ghost" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
  </PageHero>

  <section class="c-cta sp-section" aria-labelledby="start-project-heading">
    <div class="c-wrap">
        <div class="c-cta__panel">
          <div class="c-cta__art viz-ribbons" aria-hidden="true"></div>
        <div class="c-cta__copy">
          <p class="c-micro">Next step</p>
          <h2 class="c-h1" id="start-project-heading">Talk through<br />your<br />system</h2>
          <p class="c-cta__lede">
            Tell us what needs fixing.
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
            <span aria-hidden="true"> · </span>
            <a href={contact.phoneHref}>{contact.phone}</a>
          </p>
        </div>
        <ContactForm submitLabel="Tell us what needs fixing" />
      </div>
    </div>
  </section>
</SiteShell>
