---
import SiteShell from '../components/SiteShell.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteFooter } from '../data/siteChrome';
import { BOOKING_URL } from '../data/siteConfig';

const contact = siteFooter.studio;
---

<SiteShell
  title="Tell Us What Needs Fixing | Aizaz.studio"
  description="Send a short brief about the workflow, product, or system that needs fixing. Aizaz Studio reviews it and follows up by email — or talk to an engineer live."
  canonical="/start-a-project"
>
  <PageHero
    eyebrow="Start a project"
    title="Tell us what needs fixing"
    description="Share a short brief. We’ll review it and follow up on the email you provide. Prefer a live conversation? Talk through your system instead."
  >
    <a class="c-btn c-btn--ghost" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
  </PageHero>

  <section class="c-cta sp-section" aria-labelledby="start-project-heading">
    <div class="c-wrap">
        <div class="c-cta__panel">
          <div class="c-cta__art viz-ribbons" aria-hidden="true"></div>
        <div class="c-cta__copy">
          <p class="c-micro">Next step</p>
          <h2 class="c-h1" id="start-project-heading">Talk through<br />your<br />system</h2>
          <p class="c-cta__lede">
            Tell us what needs fixing.
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
            <span aria-hidden="true"> · </span>
            <a href={contact.phoneHref}>{contact.phone}</a>
          </p>
        </div>
        <ContactForm submitLabel="Tell us what needs fixing" />
      </div>
    </div>
  </section>
</SiteShell>
