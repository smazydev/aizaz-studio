---
export const prerender = false;

import SiteShell from '../../components/SiteShell.astro';
import TechnologyLanding from '../../components/TechnologyLanding.astro';
import { applyCmsCacheHeaders } from '../../lib/cms-cache';
import { getTechnologyBySlug } from '../../lib/sanity/technologyPages';

const slug = Astro.params.slug;
const page = slug ? await getTechnologyBySlug(slug) : undefined;
if (!page) {
  return new Response(null, { status: 404 });
}

applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages', `tech:${page.slug}`]);
---

<SiteShell title={page.metaTitle} description={page.metaDescription} canonical={`/technologies/${page.slug}`}>
  <TechnologyLanding page={page} />
</SiteShell>
