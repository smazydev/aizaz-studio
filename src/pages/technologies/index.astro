---
export const prerender = false;

import SiteShell from '../../components/SiteShell.astro';
import PageHero from '../../components/PageHero.astro';
import { BOOKING_URL } from '../../data/siteConfig';
import { applyCmsCacheHeaders } from '../../lib/cms-cache';
import { getTechnologyPages } from '../../lib/sanity/technologyPages';
import { getTechnologiesIndex } from '../../lib/sanity/sitePages';

const [technologyPages, index] = await Promise.all([getTechnologyPages(), getTechnologiesIndex()]);
applyCmsCacheHeaders(Astro.response.headers, ['cms', 'pages']);
---

<SiteShell
  title={index.metaTitle}
  description={index.metaDescription}
  canonical="/technologies"
>
  <PageHero
    eyebrow={index.heroEyebrow ?? 'Stack'}
    title={index.title}
    description={index.heroSubtitle}
  >
    <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
    <a class="c-btn c-btn--ghost" href="/start-a-project">Tell us what needs fixing</a>
  </PageHero>

  <section class="sp-section">
    <div class="c-wrap">
      <div class="sp-group__links">
        {technologyPages.map((page) => (
          <a class="sp-link" href={`/technologies/${page.slug}`}>
            <strong>{page.title}</strong>
            <span>{page.heroSubtitle}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteShell>
