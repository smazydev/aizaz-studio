---
import SiteShell from '../../components/SiteShell.astro';
import PageHero from '../../components/PageHero.astro';
import { technologyPages } from '../../data/technologyPages';
import { BOOKING_URL } from '../../data/siteConfig';
---

<SiteShell
  title="Technologies We Build With | Aizaz Studio"
  description="Node.js, Python, React, AWS, OpenAI, LangChain, and more, applied to SaaS, AI systems, automation, and cloud delivery."
  canonical="/technologies"
>
  <PageHero
    eyebrow="Stack"
    title="Technologies tied to business outcomes"
    description="We choose tools based on reliability, maintainability, and fit for your product, not resume-driven hype."
  >
    <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Talk through your system</a>
    <a class="c-btn c-btn--ghost" href="/start-a-project">Tell us what needs fixing</a>
  </PageHero>

  <section class="sp-section">
    <div class="c-wrap">
      <div class="sp-group__links">
        {technologyPages.map((page) => (
          <a class="sp-link" href={`/technologies/${page.slug}`}>
            <strong>{page.title}</strong>
            <span>{page.heroSubtitle}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteShell>
