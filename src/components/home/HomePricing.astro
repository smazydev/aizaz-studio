---
import { BOOKING_URL } from '../../data/siteConfig';
import { engagementModels } from '../../data/commercialPages';

const sprint = engagementModels.models[0];
const mvp = engagementModels.models[1];
---

<section class="rs-section rs-wrap" aria-labelledby="home-price-heading">
  <div class="rs-price__head">
    <div>
      <p class="rs-kicker" data-reveal>06 — Engagement</p>
      <h2 id="home-price-heading" class="rs-heading" data-reveal="clip">
        Ways to start without a twelve-month committee.
      </h2>
    </div>
    <p class="rs-body" data-reveal style="max-width: 28rem; margin: 0;">
      Fixed-scope sprints when you need one workflow live. Scoped product builds when the platform itself is the work.
    </p>
  </div>

  <div class="rs-price__grid">
    <article class="rs-price-card" data-reveal>
      <p class="rs-micro">{sprint.duration}</p>
      <h3 class="rs-heading-md" style="margin: 14px 0 0;">{sprint.name}</h3>
      <p class="rs-price-card__amount">{sprint.startingFrom}</p>
      <p class="rs-body" style="font-size: 1rem;">{sprint.summary}</p>
      <ul>
        {sprint.deliverables.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <a class="rs-btn" href="/ai-systems-sprint" style="margin-top: 32px;">See the sprint</a>
    </article>

    <article class="rs-price-card rs-price-card--dark" data-reveal data-reveal-delay="2">
      <p class="rs-micro">{mvp.duration}</p>
      <h3 class="rs-heading-md" style="margin: 14px 0 0;">{mvp.name}</h3>
      <p class="rs-price-card__amount">{mvp.startingFrom}</p>
      <p class="rs-body" style="font-size: 1rem; color: rgba(245,245,240,0.62);">{mvp.summary}</p>
      <ul>
        {mvp.deliverables.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <a class="rs-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer" style="margin-top: 32px;">Start a project</a>
    </article>
  </div>
</section>
