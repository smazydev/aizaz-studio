---
import '../../styles/home-hero.css';
---

<link rel="preload" as="image" href="/images/hero/aizaz-sentinel.webp" type="image/webp" />

<div class="hero-sentinel-tech" aria-hidden="true">
  <svg class="hero-sentinel-tech__svg" viewBox="0 0 1600 1100" preserveAspectRatio="xMidYMid slice">
    <g class="hero-sentinel-tech__arcs" fill="none" stroke="currentColor" stroke-width="1.15">
      <ellipse class="hero-sentinel-tech__draw" cx="1188" cy="360" rx="420" ry="420" />
      <ellipse class="hero-sentinel-tech__draw" cx="1188" cy="360" rx="292" ry="292" />
      <path class="hero-sentinel-tech__draw hero-sentinel-tech__draw--late" d="M720 210 A520 520 0 0 1 1588 640" />
    </g>
    <g class="hero-sentinel-tech__ticks" fill="none" stroke="currentColor" stroke-width="1.2">
      <path d="M1188 28 v14" />
      <path d="M1610 360 h14" />
      <path d="M1188 788 v14" />
      <path d="M766 360 h12" />
    </g>
    <path class="hero-sentinel-tech__route" d="M980 180 C1080 240 1120 320 1188 360" fill="none" />
    <circle class="hero-sentinel-tech__node" cx="1188" cy="360" r="3.2" />
  </svg>
</div>

<div class="hero-sentinel-stage" data-sentinel-stage>
  <div class="hero-sentinel-wrap" data-sentinel>
    <div class="hero-sentinel-backdrop" aria-hidden="true">
      <span class="hero-sentinel-backdrop__head"></span>
      <span class="hero-sentinel-backdrop__shoulder"></span>
    </div>
    <picture>
      <source srcset="/images/hero/aizaz-sentinel.avif" type="image/avif" />
      <source srcset="/images/hero/aizaz-sentinel.webp" type="image/webp" />
      <img
        class="hero-sentinel"
        src="/images/hero/aizaz-sentinel.png"
        alt=""
        width="768"
        height="1024"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-sentinel-light" aria-hidden="true"></div>
  </div>
</div>

<div class="hero-sentinel-hud" aria-hidden="true">
  <span class="hero-sentinel-hud__item">01 / SYNTHETIC SYSTEM</span>
  <span class="hero-sentinel-hud__item hero-sentinel-hud__item--live">CORE ONLINE</span>
  <span class="hero-sentinel-hud__item">AI / OPS · SYSTEM READY</span>
</div>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const wrap = document.querySelector<HTMLElement>('[data-sentinel]');
  if (hero && wrap && !hero.dataset.heroSentinel) {
    hero.dataset.heroSentinel = '1';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const setScroll = () => {
      const rect = hero.getBoundingClientRect();
      const span = Math.max(1, rect.height);
      const progress = Math.min(1, Math.max(0, -rect.top / span));
      hero.style.setProperty('--ss', (1 + progress * 0.025).toFixed(4));
    };
    setScroll();

    if (!reduce) {
      window.addEventListener('scroll', setScroll, { passive: true });

      if (fine) {
        let tx = 0;
        let ty = 0;
        let cx = 0;
        let cy = 0;
        let raf = 0;

        const tick = () => {
          cx += (tx - cx) * 0.08;
          cy += (ty - cy) * 0.08;
          wrap.style.setProperty('--px', `${(cx * 6).toFixed(2)}px`);
          wrap.style.setProperty('--py', `${(cy * 5).toFixed(2)}px`);
          wrap.style.setProperty('--ry', `${(cx * 1.2).toFixed(3)}deg`);
          wrap.style.setProperty('--rx', `${(-cy * 0.8).toFixed(3)}deg`);
          if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001) {
            raf = requestAnimationFrame(tick);
          } else {
            raf = 0;
          }
        };

        hero.addEventListener(
          'pointermove',
          (event) => {
            const r = hero.getBoundingClientRect();
            tx = (event.clientX - r.left) / r.width - 0.5;
            ty = (event.clientY - r.top) / r.height - 0.5;
            if (!raf) raf = requestAnimationFrame(tick);
          },
          { passive: true },
        );

        hero.addEventListener(
          'pointerleave',
          () => {
            tx = 0;
            ty = 0;
            if (!raf) raf = requestAnimationFrame(tick);
          },
          { passive: true },
        );
      }
    }
  }
</script>
