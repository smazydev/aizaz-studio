---
import { BOOKING_URL } from '../../data/siteConfig';
---

<section class="rs-hero" aria-label="Introduction">
  <div class="rs-hero__visual" data-hero-root>
    <div class="rs-hero__poster rs-poster" aria-hidden="true">
      <div class="rs-poster__mass" data-parallax="0.08">
        <div class="rs-poster__blob"></div>
        <div class="rs-poster__ring"></div>
        <div class="rs-poster__core"></div>
        <div class="rs-poster__glass"></div>
        <div class="rs-poster__shade"></div>
      </div>
    </div>
    <canvas class="rs-hero__canvas" data-hero-canvas></canvas>
  </div>

  <div class="rs-hero__copy">
    <p class="rs-hero__brand" data-reveal>AIZAZ.STUDIO</p>
    <h1 data-reveal="clip">
      WE BUILD SYSTEMS<br />THAT REMOVE WORK.
    </h1>
    <p class="rs-hero__lede" data-reveal data-reveal-delay="2">
      AI systems, software platforms and integrations built around how your business actually operates.
    </p>
    <div class="rs-hero__actions" data-reveal data-reveal-delay="3">
      <a class="rs-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Start a project →</a>
      <a class="rs-btn rs-btn--ghost" href="/case-studies">See our work</a>
    </div>
  </div>
</section>

<script>
  import { mountHeroWebgl } from '../../lib/hero-webgl';

  const root = document.querySelector<HTMLElement>('[data-hero-root]');
  if (root) {
    const boot = () => mountHeroWebgl(root);
    if ('requestIdleCallback' in window) {
      requestIdleCallback(boot, { timeout: 1400 });
    } else {
      window.setTimeout(boot, 400);
    }
  }
</script>
