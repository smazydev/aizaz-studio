---
interface Props {
  kind: 'optical' | 'product' | 'material' | 'mesh';
}
const { kind } = Astro.props;
---

{kind === 'optical' && (
  <div class="viz viz-optical">
    <span class="viz-optical__ticks"></span>
    <span class="viz-optical__ring r5"></span>
    <span class="viz-optical__ring r4"></span>
    <span class="viz-optical__ring r3"></span>
    <span class="viz-optical__ring r2"></span>
    <span class="viz-optical__ring r1"></span>
    <span class="viz-optical__flare"></span>
    <span class="viz-optical__dust"></span>
    <span class="viz-optical__core"></span>
    <span class="viz-optical__grain"></span>
  </div>
)}

{kind === 'product' && (
  <div class="viz viz-product">
    <div class="viz-product__stage">
      <div class="viz-product__body">
        <div class="viz-product__screws" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <div class="viz-product__face">
          <span>07:08</span>
          <small>CHANNEL 03 · LIVE</small>
        </div>
        <div class="viz-product__row">
          <i></i><i></i><i class="hot"></i>
        </div>
        <div class="viz-product__vents"></div>
        <div class="viz-product__dial"></div>
      </div>
      <div class="viz-product__shadow"></div>
    </div>
  </div>
)}

{kind === 'material' && (
  <div class="viz viz-material">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <radialGradient id="mat-a" cx="30%" cy="28%" r="70%">
          <stop offset="0" stop-color="#ffc8b4" />
          <stop offset="0.28" stop-color="#e31c12" />
          <stop offset="0.72" stop-color="#3a0806" />
          <stop offset="1" stop-color="#080403" />
        </radialGradient>
        <linearGradient id="mat-glass" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="rgba(255,255,255,0.35)" />
          <stop offset="1" stop-color="rgba(255,255,255,0)" />
        </linearGradient>
        <filter id="mat-soft">
          <feGaussianBlur stdDeviation="18" />
        </filter>
      </defs>
      <rect width="1600" height="900" fill="#080403" />
      <ellipse cx="1180" cy="480" rx="620" ry="420" fill="url(#mat-a)" />
      <path d="M520 80 C880 -40 1500 160 1540 520 C1570 820 1100 980 720 860 C380 740 280 240 520 80Z" fill="#c01810" opacity="0.55" />
      <path d="M640 120 C920 40 1320 180 1380 420 C1420 640 1100 760 820 700 C560 640 460 240 640 120Z" fill="url(#mat-glass)" />
      <ellipse cx="900" cy="280" rx="220" ry="70" fill="rgba(255,255,255,0.18)" filter="url(#mat-soft)" />
      <path d="M700 620 C980 700 1280 620 1420 480" fill="none" stroke="rgba(255,255,255,0.22)" stroke-width="2" />
    </svg>
    <span class="viz-material__layer"></span>
    <span class="viz-material__highlight"></span>
    <span class="viz-material__edge"></span>
  </div>
)}

{kind === 'mesh' && (
  <div class="viz viz-mesh">
    <canvas data-mesh width="1600" height="900"></canvas>
  </div>
)}
