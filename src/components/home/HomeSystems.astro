---
const nodes = [
  { label: 'ERP', href: '/services/netsuite-erp-automation', x: 180, y: 70 },
  { label: 'CRM', href: '/services/crm-integration', x: 420, y: 78 },
  { label: 'Email', href: '/services/ai-automation-systems', x: 520, y: 200 },
  { label: 'Spreadsheets', href: '/services/business-process-automation', x: 470, y: 360 },
  { label: 'Payments', href: '/technologies/stripe', x: 280, y: 430 },
  { label: 'Support', href: '/services/ai-chatbot-development', x: 90, y: 360 },
  { label: 'Data', href: '/technologies/postgresql', x: 40, y: 200 },
  { label: 'Internal tools', href: '/services/web-app-saas-development', x: 90, y: 90 },
];

const stages = [
  { id: 'discover', label: 'Discover' },
  { id: 'design', label: 'Design' },
  { id: 'build', label: 'Build' },
  { id: 'integrate', label: 'Integrate' },
];
---

<section class="rs-section rs-wrap" aria-labelledby="home-systems-heading">
  <div class="rs-systems__head">
    <p class="rs-kicker" data-reveal>04 — Systems</p>
    <h2 id="home-systems-heading" class="rs-heading" data-reveal="clip" style="margin: 16px 0 0;">
      Messy systems. One working flow.
    </h2>
  </div>

  <div class="rs-systems__grid">
    <div class="rs-ui-lab" data-reveal>
      <h3>Focus the build on the workflow that actually costs hours.</h3>
      {stages.map((stage, i) => (
        <div class="rs-control">
          <label for={`stage-${stage.id}`}>{String(i + 1).padStart(2, '0')} {stage.label}</label>
          <input id={`stage-${stage.id}`} type="range" min="0" max="100" value={String(28 + i * 18)} />
        </div>
      ))}
      <div class="rs-toggles">
        <label class="rs-switch">
          <input type="checkbox" checked />
          Monitoring
        </label>
        <label class="rs-switch">
          <input type="checkbox" checked />
          Handoff
        </label>
        <label class="rs-switch">
          <input type="checkbox" />
          Retainer
        </label>
      </div>
    </div>

    <div class="rs-hub" data-reveal data-reveal-delay="2">
      <svg viewBox="0 0 560 520" role="img" aria-label="Systems connecting through Aizaz">
        {nodes.map((node) => (
          <line
            x1="280"
            y1="250"
            x2={node.x}
            y2={node.y}
            stroke="#d4d0c6"
            stroke-width="1"
          />
        ))}
        {nodes.map((node) => (
          <a href={node.href}>
            <circle cx={node.x} cy={node.y} r="22" fill="#faf9f5" stroke="#d8d4cb" />
            <text x={node.x} y={node.y + 42} text-anchor="middle">{node.label}</text>
          </a>
        ))}
        <circle class="rs-hub__core" cx="280" cy="250" r="18" />
        <text x="280" y="282" text-anchor="middle" fill="#E85A32">Aizaz</text>
      </svg>
    </div>
  </div>
</section>
