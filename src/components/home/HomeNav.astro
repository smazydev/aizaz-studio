---
const links = [
  { href: '/services', label: 'Services' },
  { href: '/case-studies', label: 'Work' },
  { href: '/process', label: 'Process' },
  { href: '/blog', label: 'Journal' },
];
---

<header class="rs-nav">
  <input id="rs-nav-toggle" class="rs-nav__toggle" type="checkbox" aria-label="Open menu" />
  <div class="rs-nav__inner">
    <a class="rs-nav__logo" href="/">
      <img src="/aizaz-logo-white.png" alt="" width="22" height="22" />
      aizaz
    </a>
    <nav class="rs-nav__links" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <div class="rs-nav__cta">
      <a class="rs-btn" href="/book-a-call">Start a project</a>
      <label class="rs-nav__burger" for="rs-nav-toggle" aria-label="Open menu">
        <span></span>
      </label>
    </div>
  </div>
  <nav class="rs-nav__mobile" aria-label="Mobile">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a href="/about">About</a>
    <a href="/book-a-call">Start a project</a>
  </nav>
</header>
