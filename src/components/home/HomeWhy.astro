---
import '../../styles/home-why.css';
---

<section class="home-why">
  <div class="home-why__inner">
    <p class="home-why__mark">04 / Benefits</p>
    <h2 class="home-why__title">Why Choose Us</h2>
    <div class="home-why__grid">
      <article class="home-why__card home-why__card--sys">
        <div class="home-why__top">
          <p class="home-why__idx">01 / System</p>
          <p class="home-why__flag"><i></i> Active</p>
        </div>
        <div class="home-why__viz" aria-hidden="true">
          <svg class="home-why__svg" viewBox="0 0 520 118" preserveAspectRatio="xMidYMid meet">
            <rect class="box" x="8" y="8" width="86" height="22" rx="4" />
            <rect class="box" x="8" y="35" width="86" height="22" rx="4" />
            <rect class="box" x="8" y="62" width="86" height="22" rx="4" />
            <rect class="box" x="8" y="89" width="86" height="22" rx="4" />
            <text x="18" y="23">CRM</text>
            <text x="18" y="50">ERP</text>
            <text x="18" y="77">EMAIL</text>
            <text x="18" y="104">DATA</text>
            <path class="ln" d="M94 19 H150 V50 H188" />
            <path class="ln" d="M94 46 H150" />
            <path class="ln" d="M94 73 H150 V50" />
            <path class="ln hot" d="M94 100 H168 V50 H188" />
            <rect class="box hot" x="188" y="34" width="168" height="50" rx="6" />
            <text x="214" y="56">SYSTEM LAYER</text>
            <text x="226" y="72">controlled route</text>
            <path class="ln hot" d="M356 59 H402" />
            <rect class="box" x="402" y="42" width="110" height="34" rx="5" />
            <text x="418" y="63">WORKFLOW</text>
            <circle class="hot" cx="168" cy="100" r="3" />
          </svg>
        </div>
        <h3>Systems Thinking</h3>
        <p class="home-why__copy">We solve the workflow around the software, not just the screen in front of it.</p>
      </article>

      <article class="home-why__card home-why__card--eng">
        <div class="home-why__top">
          <p class="home-why__idx">02 / Build</p>
          <p class="home-why__flag"><i></i> Live</p>
        </div>
        <div class="home-why__viz" aria-hidden="true">
          <div class="home-why__pipe">
            <div class="home-why__step"><b>BUILD</b><span>Ready</span></div>
            <span class="home-why__join"></span>
            <div class="home-why__step"><b>API</b><span>Pass</span></div>
            <span class="home-why__join"></span>
            <div class="home-why__step"><b>TEST</b><span>Pass</span></div>
            <span class="home-why__join is-hot"></span>
            <div class="home-why__step"><b>DEPLOY</b><span>Ready</span></div>
            <span class="home-why__join is-hot"></span>
            <div class="home-why__step is-live"><b>OBSERVE</b><span>Live</span></div>
          </div>
        </div>
        <h3>Senior Engineering</h3>
        <p class="home-why__copy">Senior people stay close to the actual work.</p>
      </article>

      <article class="home-why__card home-why__card--int">
        <div class="home-why__top">
          <p class="home-why__idx">03 / Connect</p>
          <p class="home-why__flag"><i></i> Linked</p>
        </div>
        <div class="home-why__viz" aria-hidden="true">
          <svg class="home-why__svg" viewBox="0 0 520 118" preserveAspectRatio="xMidYMid meet">
            <rect class="box" x="10" y="10" width="92" height="26" rx="4" />
            <rect class="box" x="10" y="82" width="92" height="26" rx="4" />
            <rect class="box" x="418" y="10" width="92" height="26" rx="4" />
            <rect class="box" x="418" y="82" width="92" height="26" rx="4" />
            <text x="36" y="27">ERP</text>
            <text x="32" y="99">SHOP</text>
            <text x="442" y="27">CRM</text>
            <text x="440" y="99">DATA</text>
            <path class="ln" d="M102 23 H178 V46" />
            <path class="ln" d="M102 95 H178 V72" />
            <path class="ln" d="M418 23 H342 V46" />
            <path class="ln hot" d="M418 95 H342 V72" />
            <rect class="box hot" x="178" y="38" width="164" height="42" rx="6" />
            <text x="204" y="63">AIZAZ SYSTEM</text>
            <path class="ln hot" d="M260 80 V102" />
            <rect class="box" x="198" y="96" width="124" height="18" rx="3" />
            <text x="220" y="109">AUTOMATION</text>
            <circle class="hot" cx="342" cy="95" r="3" />
          </svg>
        </div>
        <h3>Work with what exists</h3>
        <p class="home-why__copy">We connect the stack you already operate instead of forcing unnecessary rebuilds.</p>
      </article>

      <article class="home-why__card home-why__card--ops">
        <div class="home-why__top">
          <p class="home-why__idx">04 / Run</p>
          <p class="home-why__flag"><i></i> Live</p>
        </div>
        <div class="home-why__viz" aria-hidden="true">
          <div class="home-why__ops">
            <div class="home-why__metrics">
              <p><small>Uptime</small><b>99.9</b></p>
              <p><small>Events</small><b>12.4K</b></p>
              <p><small>Queue</small><b>03</b></p>
              <p><small>Latency</small><b>84ms</b></p>
            </div>
            <svg class="home-why__svg home-why__wave" viewBox="0 0 220 118" preserveAspectRatio="none">
              <path class="ln" d="M6 78 C24 78 28 40 46 44 C64 48 68 90 86 74 C104 58 108 30 126 38 C144 46 148 86 166 70 C184 54 196 28 214 34" />
              <path class="ln hot" d="M126 38 C144 46 148 86 166 70 C184 54 196 28 214 34" />
              <circle class="hot" cx="214" cy="34" r="3.2" />
            </svg>
          </div>
        </div>
        <h3>Built to operate</h3>
        <p class="home-why__copy">Shipping matters when the system keeps working after launch.</p>
      </article>
    </div>
  </div>
</section>
