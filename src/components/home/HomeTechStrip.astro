---
import '../../styles/home-tech.css';
import { selectedTechGroups } from '../../data/selectedTechnologies';

const track = selectedTechGroups;
---

<section class="home-tech" aria-labelledby="home-tech-heading">
  <div class="c-wrap home-tech__head">
    <p class="c-micro c-red">Selected technologies</p>
    <h2 id="home-tech-heading" class="home-tech__title">Technologies we ship with</h2>
    <p class="c-lede home-tech__lede">
      The stack changes with the system. These are some of the technologies we regularly build and integrate with.
    </p>
  </div>

  <div class="home-tech__viewport" data-tech-strip>
    <div class="home-tech__track" data-tech-track>
      {[0, 1].map((copy) => (
        <div class="home-tech__copy" aria-hidden={copy === 1 ? 'true' : undefined}>
          {track.map((group) => (
            <div class="home-tech__group">
              <p class="home-tech__group-label">{group.label}</p>
              <ul class="home-tech__items">
                {group.items.map((item) => (
                  <li>
                    {item.href ? (
                      <a class="home-tech__chip" href={item.href} data-hint={item.hint}>
                        <span>{item.name}</span>
                        <small>{item.hint}</small>
                      </a>
                    ) : (
                      <span class="home-tech__chip" tabindex="0" data-hint={item.hint}>
                        <span>{item.name}</span>
                        <small>{item.hint}</small>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
