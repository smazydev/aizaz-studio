  .flatMap((study) => {
    const foci = study.category
      .split('•')
      .map((part) => part.trim())
      .filter(Boolean);
    const shots = [
      { image: study.image, kind: 'cinema' as const },
      ...(study.backgroundImages?.[0]
        ? [{ image: study.backgroundImages[0], kind: 'wide' as const }]
        : []),
      ...(study.backgroundImages?.[1]
        ? [{ image: study.backgroundImages[1], kind: 'square' as const }]
        : []),
    ];
    return shots.map((shot, index) => ({
      ...shot,
      href: `/case-studies/${study.slug}`,
      title: study.title,
      name: study.title.split(':')[0].trim(),
      focus: foci[index] ?? foci[0] ?? study.category,
      system: study.subtitle,
    }));
