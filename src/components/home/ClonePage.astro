            const radius = depth === 1 ? 30 : depth === 2 ? 38 : 44;
            const x = 50 + Math.cos(angle) * radius;
            const y = 50 + Math.sin(angle) * (radius * 0.82);
            return (
              <span
                class="c-orbit__pill"
                data-depth={String(depth)}
                style={`left: ${x}%; top: ${y}%;`}
