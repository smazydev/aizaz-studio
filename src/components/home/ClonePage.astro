const haiField = (() => {
  let s = 0xa12a2;
  const rng = () => {
    s |= 0;
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const gauss = () => {
    const u = rng() || 1e-6;
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(Math.PI * 2 * rng());
  };
  const W = 1000;
  const H = 720;
  type Pt = { x: number; y: number; r: number; hot: boolean; o: number };
  const pts: Pt[] = [];
  const add = (cx: number, cy: number, sx: number, sy: number, n: number, hotP: number) => {
    for (let i = 0; i < n; i++) {
      const z = rng();
      pts.push({
        x: +(Math.min(0.98, Math.max(0.02, cx + gauss() * sx)) * W).toFixed(1),
        y: +(Math.min(0.98, Math.max(0.02, cy + gauss() * sy)) * H).toFixed(1),
        r: +(0.7 + z * 1.15).toFixed(2),
        hot: rng() < hotP,
        o: +(0.28 + z * 0.58).toFixed(2),
      });
    }
  };
  add(0.3, 0.38, 0.13, 0.16, 460, 0.04);
  add(0.5, 0.47, 0.1, 0.12, 360, 0.1);
  add(0.68, 0.61, 0.1, 0.11, 440, 0.7);
  add(0.17, 0.71, 0.08, 0.09, 200, 0.07);
  add(0.79, 0.25, 0.07, 0.08, 170, 0.05);
  const bridge = (a: [number, number], b: [number, number], n: number, hotP: number) => {
    for (let i = 0; i <= n; i++) {
      const t = i / n;
      pts.push({
        x: +((a[0] + (b[0] - a[0]) * t + gauss() * 0.012) * W).toFixed(1),
        y: +((a[1] + (b[1] - a[1]) * t + Math.sin(t * Math.PI) * 0.045 + gauss() * 0.012) * H).toFixed(1),
        r: 0.95,
        hot: rng() < hotP,
        o: 0.45,
      });
    }
  };
  bridge([0.3, 0.38], [0.5, 0.47], 90, 0.1);
  bridge([0.5, 0.47], [0.68, 0.61], 100, 0.48);
  bridge([0.3, 0.38], [0.17, 0.71], 70, 0.06);
  bridge([0.5, 0.47], [0.79, 0.25], 55, 0.05);
  const links: { x1: number; y1: number; x2: number; y2: number; hot: boolean }[] = [];
  const cols = 28;
  const rows = 20;
  const bins: number[][] = Array.from({ length: cols * rows }, () => []);
  pts.forEach((p, i) => {
    const cx = Math.min(cols - 1, Math.floor((p.x / W) * cols));
    const cy = Math.min(rows - 1, Math.floor((p.y / H) * rows));
    bins[cy * cols + cx].push(i);
  });
  bins.forEach((bin) => {
    for (let i = 0; i < bin.length; i++) {
      if (rng() > 0.58 || bin.length < 2) continue;
      const a = pts[bin[i]];
      const b = pts[bin[(i + 1) % bin.length]];
      const dx = a.x - b.x;
      const dy = a.y - b.y;
      if (dx * dx + dy * dy < 1700) links.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, hot: a.hot && b.hot });
    }
  });
  return { pts, links };
})();
