            <span class="home-process__core-unit is-mid"></span>
            <span class="home-process__core-unit is-top"></span>
            <i></i>
          </div>
          {process.map((row, i) => (
            <article class:list={['home-process__stage', i === 0 && 'is-on']} data-process-node data-step={String(i)}>
              <span class="home-process__artifact" aria-hidden="true">
                {row.art === 'nodes' && (
                  <svg viewBox="0 0 48 28"><circle cx="8" cy="16" r="2.2" /><circle cx="18" cy="8" r="2" /><circle cx="28" cy="18" r="2.4" /><circle cx="38" cy="10" r="1.8" /><circle cx="22" cy="20" r="1.6" /></svg>
                )}
                {row.art === 'wire' && (
                  <svg viewBox="0 0 48 28"><rect x="4" y="8" width="18" height="12" rx="2" /><rect x="26" y="6" width="18" height="16" rx="2" /><path d="M22 14 H26" /></svg>
                )}
                {row.art === 'blocks' && (
                  <svg viewBox="0 0 48 28"><rect x="6" y="14" width="12" height="10" rx="1.5" /><rect x="18" y="8" width="12" height="16" rx="1.5" /><rect x="30" y="4" width="12" height="20" rx="1.5" /></svg>
                )}
                {row.art === 'join' && (
                  <svg viewBox="0 0 48 28"><path d="M4 8 H20 V20 H4" /><path d="M44 8 H28 V20 H44" /><path d="M20 14 H28" /></svg>
                )}
                {row.art === 'ship' && (
                  <svg viewBox="0 0 48 28"><path d="M6 14 H32" /><path d="M26 8 L36 14 L26 20" /></svg>
                )}
                {row.art === 'wave' && (
                  <svg viewBox="0 0 48 28"><path d="M4 18 C10 18 12 8 18 8 C24 8 24 20 30 20 C36 20 38 12 44 12" /></svg>
