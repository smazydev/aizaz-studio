          </div>
          <form data-home-form>
            <label class="c-cta__field">
              <span class="visually-hidden">Your name</span>
              <input name="name" placeholder="Your name" required autocomplete="name" />
            </label>
            <label class="c-cta__field">
              <span class="visually-hidden">Email</span>
              <input name="email" type="email" placeholder="Email" required autocomplete="email" />
            </label>
            <label class="c-cta__field">
              <span class="visually-hidden">What are you interested in</span>
              <select name="interest" required>
                <option value="" disabled selected>What are you interested in</option>
                <option value="AI Systems Sprint">AI Systems Sprint</option>
                <option value="Product / SaaS build">Product / SaaS build</option>
                <option value="ERP / NetSuite integration">ERP / NetSuite integration</option>
                <option value="Cloud / AWS">Cloud / AWS</option>
                <option value="Technical audit">Technical audit</option>
              </select>
            </label>
            <label class="c-cta__field">
              <span class="visually-hidden">Project details</span>
              <textarea name="message" placeholder="More about the project" required rows="4"></textarea>
            </label>
            <button class="c-btn c-btn--light" type="submit">Submit message</button>
