---
import { Image } from 'astro:assets';
import { caseStudies } from '../../data/caseStudies';
import Hero from './Hero.astro';
import HomeFeatures from './HomeFeatures.astro';
import TechLogoStrip from './TechLogoStrip.astro';
import SiteNav from '../site/SiteNav.astro';
import SiteFooter from '../site/SiteFooter.astro';
import { siteFooter } from '../../data/siteChrome';
import { leadershipProfiles } from '../../data/leadership';
import { featuredFeedback, secondaryFeedback } from '../../data/homeFeedback';
import { filterPublicCaseStudies } from '../../lib/case-study-visibility';
import TeamPortrait from '../TeamPortrait.astro';
import ContactForm from '../ContactForm.astro';

const publicCaseStudies = filterPublicCaseStudies(caseStudies);

const isDev = import.meta.env.DEV;
const services = [
  {
    n: '01',
    title: 'AI Automation',
    body: 'Agents and workflows that take work off your team, from intake to action, with evals and a human handoff.',
    items: ['Workflow mapping', 'Tool use & guardrails', 'Production evals'],
    href: '/services/ai-automation-systems',
  },
  {
    n: '02',
    title: 'Product Engineering',
    body: 'Web apps and SaaS products built to ship: architecture, UI, and the backend your users actually hit.',
    items: ['MVP to production', 'React / Node', 'Auth, billing, APIs'],
    href: '/services/web-app-saas-development',
  },
  {
    n: '03',
    title: 'Systems Integration',
    body: 'CRM, helpdesk, warehouse, and internal tools connected so data stops living in five places.',
    items: ['API connectors', 'Event buses', 'Idempotent sync'],
    href: '/services/api-integration',
  },
  {
    n: '04',
    title: 'ERP / NetSuite',
    body: 'NetSuite and operations systems wired to the rest of the stack: orders, inventory, and finance in one flow.',
    items: ['NetSuite REST / SuiteQL', 'Order sync', 'Custom records'],
    href: '/services/netsuite-erp-automation',
  },
  {
    n: '05',
    title: 'Cloud Infrastructure',
    body: 'AWS environments that stay up: CI/CD, observability, and the reliability work that makes shipping safe.',
    items: ['AWS landing zone', 'Pipelines & canaries', 'Logs, traces, alerts'],
    href: '/services/aws-devops',
  },
];

const process = [
  { n: '01', title: 'Discover', body: 'Understand the workflow, constraints and systems.', meta: 'INPUT / OPS / USERS', art: 'nodes' },
  { n: '02', title: 'Design', body: 'Map the experience, prompts, and handoff states.', meta: 'UX / PROMPTS / GUARDS', art: 'wire' },
  { n: '03', title: 'Build', body: 'Assemble the agent, pipeline, or product.', meta: 'APP / MODEL / API', art: 'blocks' },
  { n: '04', title: 'Integrate', body: 'Join CRM, ERP, warehouse, and internal tools.', meta: 'BUS / SYNC / AUTH', art: 'join' },
  { n: '05', title: 'Ship', body: 'Deploy with tracing, canaries, and rollback.', meta: 'CI / CANARY / PROD', art: 'ship' },
  { n: '06', title: 'Observe', body: 'Keep evals, cost, latency, and safety visible.', meta: 'EVAL / COST / P95', art: 'wave' },
];

const leaders = leadershipProfiles;

const contactEmail = siteFooter.studio.email;
const contactPhone = siteFooter.studio.phone;
const contactPhoneHref = siteFooter.studio.phoneHref;

const shippedStudies = publicCaseStudies.map((study) => {
  return {
    href: `/case-studies/${study.slug}`,
    name: study.title.split('—')[0]?.split(':')[0]?.trim() || study.title,
    category: (study.category.split('•')[0] || study.category).trim(),
    summary: study.subtitle.replace(/\s+/g, ' ').trim(),
    image: study.image,
  };
});

const faqs = [
  { q: 'What’s the typical timeline from idea to v1?', a: 'Typically 3–8 weeks depending on scope and complexity. We move from discovery to deployment with regular check-ins.' },
  { q: 'What do we need to start?', a: 'A clear problem statement, success metrics, access to sample data, and a stakeholder who can make decisions. We’ll run a kickoff workshop to align scope.' },
  { q: 'Which models/stack do you use?', a: 'Modern, scalable stacks like React, Node.js, and cloud services. We choose models/APIs based on the use case, performance, and cost.' },
  { q: 'How do engagements work?', a: 'Scoped sprints and project delivery, not opaque retainers. We align on outcomes, then ship with clear ownership through launch.' },
];

const homeQuote = featuredFeedback;
---

<div class="clone">
  {isDev && (
    <>
      <div class="ref-overlay" data-ref-overlay hidden>
        <img src="/dev/reference-home.jpg" alt="" />
      </div>
      <div class="ref-chip">Shift+R</div>
    </>
  )}

  <SiteNav />

  <main>
    <!-- 02 HERO -->
    <Hero />

    <!-- 03 HUMAN CENTERED -->
    <section class="home-human-ai">
      <div class="c-wrap home-human-ai__head">
        <div class="home-human-ai__heading">
          <p class="c-micro c-red">About Us</p>
          <h2 class="home-human-ai__title">Senior<br />engineering,<br />built for<br />production</h2>
        </div>
        <p class="c-lede home-human-ai__lede">
          AI, SaaS, integrations, and cloud systems for teams that need working software, not slide decks. Available for remote projects worldwide.
        </p>
      </div>
    </section>

    <!-- 04 SERVICES -->
    <section class="home-services" id="services" data-services>
      <div class="home-services__inner">
        <div class="home-services__head">
          <p class="c-micro c-red">Services</p>
          <h2 class="home-services__title">Engineering<br />services</h2>
        </div>
        <div class="home-services__stage">
          <div class="home-services__acc" role="list">
            {services.map((s, i) => (
              <a
                class:list={['home-services__item', i === 0 && 'is-on']}
                href={s.href}
                data-service={String(i)}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <span class="home-services__item-kicker">
                  <span class="home-services__idx">{s.n}</span>
                  <span class="home-services__mark"></span>
                </span>
                <span class="home-services__item-title">{s.title}</span>
                <span class="home-services__item-body">
                  <span class="home-services__item-inner">
                    {s.body}
                    <span class="home-services__tags">
                      {s.items.map((item) => (
                        <span>{item}</span>
                      ))}
                    </span>
                    <span class="home-services__go">View service <span aria-hidden="true">↗</span></span>
                  </span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 09 FROM IDEA -->
    <section class="home-process" data-process>
      <div class="home-process__inner">
        <p class="home-process__mark">03 / Process</p>
        <h2 class="home-process__title">From Idea<br />to Production.</h2>
        <div class="home-process__board">
          <svg class="home-process__rail home-process__rail--map" viewBox="0 0 1440 640" preserveAspectRatio="none" aria-hidden="true">
            <g class="home-process__grid">
              {Array.from({ length: 18 }).map((_, i) => <line x1={40 + i * 80} y1="16" x2={40 + i * 80} y2="624" />)}
              {Array.from({ length: 8 }).map((_, i) => <line x1="24" y1={40 + i * 80} x2="1416" y2={40 + i * 80} />)}
            </g>
            <text class="home-process__ann" x="40" y="36">LIFECYCLE · 06 STAGES</text>
            <text class="home-process__ann" x="1248" y="36">ROUTE / PROD</text>
            <path class="home-process__route" d="M120 168 C280 168 360 118 520 118 C700 118 840 148 1000 148 C1140 148 1260 210 1260 328 C1260 430 1080 508 760 508 C500 508 320 540 180 548" />
            <path class="home-process__route home-process__route--hot" data-process-fill pathLength="1" d="M120 168 C280 168 360 118 520 118 C700 118 840 148 1000 148 C1140 148 1260 210 1260 328 C1260 430 1080 508 760 508 C500 508 320 540 180 548" />
            <circle class="home-process__dot" cx="120" cy="168" r="5" />
            <circle class="home-process__dot" cx="520" cy="118" r="5" />
            <circle class="home-process__dot" cx="1000" cy="148" r="5" />
            <circle class="home-process__dot" cx="1260" cy="328" r="5" />
            <circle class="home-process__dot" cx="760" cy="508" r="5" />
            <circle class="home-process__dot" cx="180" cy="548" r="5" />
          </svg>
          <svg class="home-process__rail home-process__rail--col" viewBox="0 0 48 720" preserveAspectRatio="none" aria-hidden="true">
            <path class="home-process__route" d="M24 18 V702" />
            <path class="home-process__route home-process__route--hot" data-process-fill pathLength="1" d="M24 18 V702" />
            <circle class="home-process__dot" cx="24" cy="28" r="4" />
            <circle class="home-process__dot" cx="24" cy="148" r="4" />
            <circle class="home-process__dot" cx="24" cy="268" r="4" />
            <circle class="home-process__dot" cx="24" cy="388" r="4" />
            <circle class="home-process__dot" cx="24" cy="508" r="4" />
            <circle class="home-process__dot" cx="24" cy="628" r="4" />
          </svg>
          <div class="home-process__core" data-process-core aria-hidden="true">
            <span class="home-process__core-unit"></span>
            <span class="home-process__core-unit is-mid"></span>
            <span class="home-process__core-unit is-top"></span>
            <i></i>
          </div>
          {process.map((row, i) => (
            <article class:list={['home-process__stage', i === 0 && 'is-on']} data-process-node data-step={String(i)}>
              <span class="home-process__artifact" aria-hidden="true">
                {row.art === 'nodes' && (
                  <svg viewBox="0 0 48 28"><circle cx="8" cy="16" r="2.2" /><circle cx="18" cy="8" r="2" /><circle cx="28" cy="18" r="2.4" /><circle cx="38" cy="10" r="1.8" /><circle cx="22" cy="20" r="1.6" /></svg>
                )}
                {row.art === 'wire' && (
                  <svg viewBox="0 0 48 28"><rect x="4" y="8" width="18" height="12" rx="2" /><rect x="26" y="6" width="18" height="16" rx="2" /><path d="M22 14 H26" /></svg>
                )}
                {row.art === 'blocks' && (
                  <svg viewBox="0 0 48 28"><rect x="6" y="14" width="12" height="10" rx="1.5" /><rect x="18" y="8" width="12" height="16" rx="1.5" /><rect x="30" y="4" width="12" height="20" rx="1.5" /></svg>
                )}
                {row.art === 'join' && (
                  <svg viewBox="0 0 48 28"><path d="M4 8 H20 V20 H4" /><path d="M44 8 H28 V20 H44" /><path d="M20 14 H28" /></svg>
                )}
                {row.art === 'ship' && (
                  <svg viewBox="0 0 48 28"><path d="M6 14 H32" /><path d="M26 8 L36 14 L26 20" /></svg>
                )}
                {row.art === 'wave' && (
                  <svg viewBox="0 0 48 28"><path d="M4 18 C10 18 12 8 18 8 C24 8 24 20 30 20 C36 20 38 12 44 12" /></svg>
                )}
              </span>
              <p class="home-process__idx">{row.n}</p>
              <h3>{row.title}</h3>
              <p class="home-process__copy">{row.body}</p>
              <p class="home-process__meta">{row.meta}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 11 FEATURES -->
    <HomeFeatures />

    <!-- 12 SELECTED TECHNOLOGIES -->
    <TechLogoStrip />

    <!-- 13–15 DARK / METRIC / TESTIMONIAL -->
    <section class="c-dark">
      <div class="c-wrap">
        <div class="c-team" id="team">
          <div class="c-dark__intro">
            <p class="c-micro">Meet the team</p>
            <h2 class="c-h1">A studio built<br />to ship systems</h2>
            <p class="c-lede">Senior software engineering across AI &amp; automation, product/SaaS, ERP/NetSuite, and cloud production. A small founding team, direct ownership, no agency layer.</p>
          </div>

          <div class="c-roster" aria-label="Leadership">
            {leaders.map((p) => (
              <article class="c-member">
                <div class="c-member__media">
                  <TeamPortrait
                    person={{ ...p, image: p.founderImage, objectPosition: '50% 50%' }}
                    class="c-member__photo"
                    objectPosition="center center"
                    widths={[280, 340, 480, 640]}
                    sizes="(max-width: 768px) min(320px, 86vw), min(320px, 28vw)"
                    width={640}
                    height={640}
                  />
                </div>
                <div class="c-member__body">
                  <h3 class="c-member__name">{p.displayName}</h3>
                  <p class="c-member__role">{p.role}</p>
                  <p class="c-member__tags">{p.focus.slice(0, 3).join(' · ')}</p>
                  <div class="c-member__links">
                    {p.linkedin && (
                      <a href={p.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
                    )}
                    {p.githubUrl && (
                      <a href={p.githubUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
                    )}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>

        <div class="c-dark__growth">
          <div>
            <p class="c-micro">Case studies</p>
            <h2 class="c-dark__ship-title">Systems that ship</h2>
          </div>
          <p class="c-lede c-dark__ship-lede">Public work across compliance, SaaS, developer tooling, and sales platforms. Every card opens the full case study.</p>
        </div>

        <div class="c-proof">
          {shippedStudies.map((study) => (
            <a class="c-proof__card" href={study.href}>
              <div class="c-proof__media sp-media-frame sp-media-frame--43">
                <Image
                  class="c-proof__shot"
                  src={study.image}
                  alt={study.name}
                  width={720}
                  widths={[360, 720, 960]}
                  sizes="(min-width: 900px) 22vw, 90vw"
                  quality={72}
                />
              </div>
              <div class="c-proof__body">
                <p class="c-micro">{study.category}</p>
                <h3>{study.name}</h3>
                <p class="c-proof__summary">{study.summary}</p>
                <span class="c-proof__go">
                  View case study <span aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          ))}
        </div>

        {homeQuote && (
          <figure class="c-quote">
            <div class="c-quote__body">
              <p class="c-micro">Client feedback</p>
              <blockquote cite={homeQuote.href}>
                <p>“{homeQuote.quote}”</p>
              </blockquote>
              <figcaption>
                <cite>
                  {homeQuote.author}
                  {homeQuote.role ? `, ${homeQuote.role}` : ''}
                  {homeQuote.location ? ` · ${homeQuote.location}` : ''}
                </cite>
                {homeQuote.sourceIsUpwork ? (
                  <span class="c-quote__source">Client feedback from Upwork</span>
                ) : homeQuote.sourceLabel ? (
                  <span class="c-quote__source">{homeQuote.sourceLabel}</span>
                ) : null}
              </figcaption>
            </div>
            <aside class="c-quote__proof" aria-label="Case study snapshot">
              <p class="c-micro c-quote__proof-eyebrow">Case snapshot</p>
              <dl class="c-quote__meta">
                {homeQuote.project && (
                  <div>
                    <dt>Project</dt>
                    <dd>{homeQuote.project}</dd>
                  </div>
                )}
                {homeQuote.engagementLabel && (
                  <div>
                    <dt>Engagement</dt>
                    <dd>{homeQuote.engagementLabel}</dd>
                  </div>
                )}
                {homeQuote.problem && (
                  <div>
                    <dt>Main problem</dt>
                    <dd>{homeQuote.problem}</dd>
                  </div>
                )}
                {homeQuote.solved && (
                  <div>
                    <dt>What Aizaz solved</dt>
                    <dd>{homeQuote.solved}</dd>
                  </div>
                )}
                {homeQuote.deliveryTime && (
                  <div>
                    <dt>Delivery time</dt>
                    <dd>{homeQuote.deliveryTime}</dd>
                  </div>
                )}
                <div>
                  <dt>Source</dt>
                  <dd>
                    {homeQuote.sourceIsUpwork ? (
                      <span class="c-quote__upwork">
                        <svg class="c-quote__upwork-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                          <path fill="currentColor" d="M18.561 13.158c-1.102 0-2.135-.467-3.074-1.227l.228-1.076.008-.042c.207-1.143.849-3.06 2.839-3.06 1.492 0 2.703 1.212 2.703 2.703-.001 1.489-1.212 2.702-2.704 2.702zm0-8.14c-2.539 0-4.51 1.649-5.31 4.43-1.235-1.856-2.056-4.082-2.522-5.968h-2.522v7.168c0 1.4-1.14 2.54-2.54 2.54s-2.54-1.14-2.54-2.54V3.48H.615v7.168c0 2.854 2.32 5.174 5.174 5.174 2.855 0 5.175-2.32 5.175-5.174v-1.21c.529 1.118 1.182 2.185 1.974 3.118l-1.668 7.873h2.633l1.204-5.692c1.048.85 2.266 1.376 3.654 1.376 3.033 0 5.491-2.475 5.491-5.508 0-3.035-2.458-5.509-5.491-5.509z" />
                        </svg>
                        Upwork
                      </span>
                    ) : (
                      homeQuote.sourceLabel
                    )}
                  </dd>
                </div>
              </dl>
              {homeQuote.href && (
                <a class="c-quote__link" href={homeQuote.href}>
                  View full case study <span aria-hidden="true">↗</span>
                </a>
              )}
            </aside>
          </figure>
        )}

        {secondaryFeedback.length > 0 && (
          <div class="c-quote-rail" aria-label="More client feedback">
            {secondaryFeedback.map((item) => (
              <blockquote class="c-quote-card" cite={item.href}>
                <p>“{item.quote}”</p>
                <footer>
                  <cite>
                    {item.author}
                    {item.role ? `, ${item.role}` : ''}
                  </cite>
                  <span>
                    {item.project ? `${item.project} · ` : ''}
                    {item.sourceLabel}
                  </span>
                  {item.href && (
                    <a href={item.href}>
                      Case study <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </footer>
              </blockquote>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- 16 PRICING -->
    <section class="c-price" id="pricing">
      <div class="c-wrap">
        <div class="c-price__head">
          <div>
            <p class="c-micro c-red">Engagement</p>
            <h2 class="c-h1">Clear scope. Transparent delivery.</h2>
          </div>
        </div>
        <div class="c-price__grid">
          <article class="c-plan">
            <p class="c-micro">Sprint: focused delivery</p>
            <p class="c-plan__amount" style="font-size: clamp(1.8rem, 3vw, 2.4rem);">Scoped sprint</p>
            <p class="c-lede" style="margin-top: 18px">Prove value quickly with a working slice, clear go/no-go, and a path to production.</p>
            <ul>
              <li>Discovery workshop</li>
              <li>Opportunity brief</li>
              <li>Working prototype or spike</li>
              <li>Defined next-step roadmap</li>
            </ul>
            <a class="c-btn" href="/ai-systems-sprint" style="margin-top: 32px">AI Systems Sprint</a>
          </article>
          <article class="c-plan c-plan--dark">
            <p class="c-micro">Project: production systems</p>
            <p class="c-plan__amount" style="font-size: clamp(1.8rem, 3vw, 2.4rem); color: inherit;">Build &amp; ship</p>
            <p class="c-lede" style="margin-top: 18px; color: rgba(245,245,240,0.62)">
              Product, integrations, and cloud work owned through launch, with observability and handoff.
            </p>
            <ul>
              <li>Architecture and delivery plan</li>
              <li>CI/CD, tracing, alerts</li>
              <li>Integrations and data flows</li>
              <li>Production-ready ownership</li>
            </ul>
            <a class="c-btn" href="/engagement-models" style="margin-top: 32px">Engagement models</a>
          </article>
        </div>
      </div>
    </section>

    <!-- 17 FAQ -->
    <section class="c-faq">
      <div class="c-wrap">
        <p class="c-micro c-red">FAQs</p>
        <h2 class="c-h2">Frequently Asked Questions</h2>
        {faqs.map((f) => (
          <details>
            <summary>{f.q}<span>+</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- 18 CTA -->
    <section class="c-cta" id="contact">
      <div class="c-wrap">
        <div class="c-cta__panel" data-cta>
          <div class="c-cta__art viz-ribbons" aria-hidden="true"></div>
          <div class="c-cta__copy">
            <p class="c-micro">Contact</p>
            <h2 class="c-h1">Let’s build<br />the next<br />system</h2>
            <p class="c-cta__lede">
              Tell us what you need to ship.
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
              <span aria-hidden="true"> · </span>
              <a href={contactPhoneHref}>{contactPhone}</a>
            </p>
          </div>
          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</div>
