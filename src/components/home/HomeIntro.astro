<section class="rs-intro rs-wrap" aria-labelledby="home-intro-heading">
  <div class="rs-intro__head">
    <div>
      <p class="rs-kicker" data-reveal>01 — Studio</p>
      <h2 id="home-intro-heading" class="rs-heading" data-reveal="clip" style="margin: 18px 0 0; max-width: 11ch;">
        Engineering that sits inside the operation.
      </h2>
    </div>
    <p class="rs-body" data-reveal data-reveal-delay="2">
      We design and ship the systems behind your stack — AI automation, product platforms, ERP connections, and cloud infrastructure — so work moves without another layer of people in the middle.
    </p>
  </div>

  <div class="rs-bento">
    <article class="rs-card rs-card--dark rs-bento__main rs-bento__card rs-bento__card--dark" data-reveal>
      <div class="rs-globe" aria-hidden="true">
        <div class="rs-globe__sphere">
          <div class="rs-globe__nodes"></div>
          <div class="rs-globe__arc"></div>
        </div>
      </div>
      <p class="rs-bento__label rs-micro">01 / Network</p>
      <div class="rs-bento__copy">
        <p class="rs-micro">Systems integration</p>
        <h3>One working flow across the tools you already run.</h3>
      </div>
    </article>

    <div class="rs-bento__stack">
      <article class="rs-card rs-bento__card" data-reveal data-reveal-delay="2">
        <div class="rs-iface" aria-hidden="true">
          <div class="rs-iface__row">
            Ingest
            <div class="rs-iface__bar"><span></span></div>
          </div>
          <div class="rs-iface__row">
            Route
            <div class="rs-iface__bar"><span style="width: 41%"></span></div>
          </div>
          <div class="rs-iface__chart">
            <svg viewBox="0 0 200 80" preserveAspectRatio="none">
              <polyline
                fill="none"
                stroke="#E85A32"
                stroke-width="2"
                points="0,58 24,52 48,60 72,34 96,40 120,18 144,28 168,12 200,22"
              />
            </svg>
          </div>
        </div>
        <p class="rs-bento__label rs-micro" style="color: var(--aizaz-orange)">02 / Control</p>
      </article>

      <article class="rs-card rs-bento__card" data-reveal data-reveal-delay="3">
        <div class="rs-portrait" aria-hidden="true">
          <div class="rs-portrait__head"></div>
        </div>
        <p class="rs-bento__label rs-micro" style="color: #f5f5f0">03 / Senior delivery</p>
        <div class="rs-bento__copy">
          <h3 style="color: #f5f5f0">Operators, not rented seats.</h3>
        </div>
      </article>
    </div>
  </div>
</section>
