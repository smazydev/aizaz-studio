---
const rows = [
  { n: '01', t: 'Discover' },
  { n: '02', t: 'Design' },
  { n: '03', t: 'Build' },
  { n: '04', t: 'Integrate' },
  { n: '05', t: 'Ship' },
  { n: '06', t: 'Observe' },
];
---

<section class="rs-section rs-wrap" aria-labelledby="home-module-heading">
  <div class="rs-module">
    <div class="rs-module__copy">
      <p class="rs-kicker" data-reveal>02 — Method</p>
      <h2 id="home-module-heading" class="rs-heading" data-reveal="clip">From idea to production.</h2>
      <p class="rs-body" data-reveal>
        A short, explicit sequence. Architecture before code. Integrations against live systems. Monitoring on day one.
      </p>
      <ul class="rs-module__meta" data-reveal>
        {rows.map((row) => (
          <li>
            <span class="rs-micro">{row.n}</span>
            <strong>{row.t}</strong>
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal data-reveal-delay="2">
      <div class="rs-dash">
        <div class="rs-dash__top">
          <span class="rs-micro">Runtime / live</span>
          <span class="rs-dash__dot"></span>
        </div>
        <div class="rs-dash__grid">
          <div class="rs-dash__panel">
            <p class="rs-micro">Throughput</p>
            <div class="rs-dash__line">
              <svg viewBox="0 0 240 120" width="100%" height="100%" preserveAspectRatio="none">
                <polyline
                  fill="none"
                  stroke="#E85A32"
                  stroke-width="2"
                  points="0,90 30,86 60,70 90,74 120,42 150,48 180,28 210,36 240,18"
                />
                <polyline
                  fill="none"
                  stroke="rgba(245,245,240,0.25)"
                  stroke-width="1.5"
                  points="0,100 40,92 80,96 120,80 160,84 200,68 240,72"
                />
              </svg>
            </div>
          </div>
          <div class="rs-dash__panel">
            <p class="rs-dash__stat">14d</p>
            <p class="rs-micro" style="margin-top: 10px">Typical sprint</p>
            <div class="rs-dash__pills">
              <div class="rs-dash__pill">Queue <span>ok</span></div>
              <div class="rs-dash__pill">Deploy <span>ok</span></div>
              <div class="rs-dash__pill">Alerts <span>on</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="rs-hardware" aria-hidden="true">
        <span class="rs-hardware__knob rs-hardware__knob--a"></span>
        <span class="rs-hardware__knob rs-hardware__knob--b"></span>
        <span class="rs-hardware__led"></span>
      </div>
    </div>
  </div>
</section>
