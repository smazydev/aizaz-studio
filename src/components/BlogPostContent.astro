---
import type { PublicBlogPost } from '../lib/blog';
import AuthorCard from './AuthorCard.astro';
import BlogFAQ from './BlogFAQ.astro';
import BlogShareCard from './BlogShareCard.astro';
import LocalImage from './LocalImage.astro';
import RelatedContent from './RelatedContent.astro';
import { SITE_URL } from '../data/seoPages';
import { getArticleRelatedGroups } from '../data/internalLinks';
import { extractArticleHeadings, injectArticleHeadingIds } from '../lib/article-headings';
import { resolveArticleHtml } from '../lib/article-content';

interface Props {
  blog: PublicBlogPost;
  related?: PublicBlogPost[];
  preview?: boolean;
}

const { blog, related = [], preview = false } = Astro.props;
const rawContentHtml = resolveArticleHtml(blog.contentHtml, blog.content);
const contentHtml = injectArticleHeadingIds(rawContentHtml);
const headings = extractArticleHeadings(contentHtml);
const shareUrl = `${SITE_URL}${blog.canonicalUrl ?? `/blog/${blog.slug}`}`;
const commercialGroups = preview ? [] : getArticleRelatedGroups(blog.slug, blog.category);

const endGroups = [...commercialGroups];
const hasFurtherReading = endGroups.some((group) => /further|reading|related articles/i.test(group.title));
if (!preview && related.length > 0 && !hasFurtherReading) {
  endGroups.push({
    title: 'Further reading',
    links: related.map((post) => ({
      href: `/blog/${post.slug}`,
      label: post.title,
      description: post.excerpt,
    })),
  });
}
---

<article class="blog-article">
  <header class="blog-article__header">
    <div class="blog-article__meta">
      <span class="c-micro c-red">{blog.category}</span>
      <time datetime={blog.dateIso}>{blog.date}</time>
      <span>·</span>
      <span>{blog.readTime}</span>
      {preview && <span class="c-micro">Preview</span>}
    </div>

    <h1 class="page-title blog-article__title">{blog.title}</h1>

    {blog.excerpt && <p class="c-lede page-hero__lede">{blog.excerpt}</p>}

    <div class="blog-article__byline">
      {blog.author ? <AuthorCard author={blog.author} showBio /> : null}
    </div>
  </header>

  {(blog.image || blog.imageUrl) && (
    <div class="blog-article__hero">
      {blog.image ? (
        <LocalImage src={blog.image} alt={blog.title} class="blog-article__hero-img" loading="eager" fetchpriority="high" kind="hero" width={1400} />
      ) : (
        <img src={blog.imageUrl} alt={blog.title} class="blog-article__hero-img" loading="eager" fetchpriority="high" width="1400" height="600" decoding="async" />
      )}
    </div>
  )}

  <div class="blog-article__layout">
    <div class="blog-article__main">
      <div class="article-content" set:html={contentHtml} />

      <BlogFAQ faqs={blog.faqs ?? []} />

      {blog.tags.length > 0 && (
        <div class="blog-article__tags">
          <p class="c-micro">Topics</p>
          <div class="blog-article__taglist">
            {blog.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </div>
      )}

      {!preview && (
        <div class="sp-promo blog-article__cta">
          <div class="sp-promo__copy">
            <h3 class="sp-card__title">Want help implementing this?</h3>
            <p class="c-lede">
              We turn manual workflows into working systems, automations, and internal tools, often starting with a focused sprint.
            </p>
          </div>
          <div class="page-hero__actions" style="margin:0">
            <a class="c-btn" href="/book-a-call">Book a Free Call</a>
            <a class="c-btn c-btn--ghost" href="/ai-systems-sprint">AI Systems Sprint</a>
          </div>
        </div>
      )}
    </div>

    <aside class="blog-article__aside">
      {headings.length > 0 && (
        <nav class="blog-toc" aria-label="Table of contents">
          <details class="blog-toc__fold" data-blog-toc>
            <summary class="blog-toc__summary">On this page</summary>
            <ul>
              {headings.map((heading) => (
                <li class:list={[heading.level === 3 && 'is-h3']}>
                  <a href={`#${heading.id}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      )}

      {!preview && <BlogShareCard url={shareUrl} title={blog.title} />}
    </aside>
  </div>
</article>

{!preview && endGroups.length > 0 && <RelatedContent groups={endGroups} />}

<script>
  const toc = document.querySelector('[data-blog-toc]');
  if (toc instanceof HTMLDetailsElement) {
    const mq = window.matchMedia('(min-width: 961px)');
    const sync = () => {
      toc.open = mq.matches;
    };
    mq.addEventListener('change', sync);
    sync();
  }
</script>
