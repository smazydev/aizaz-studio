---
import PageSentinelPoster from './PageSentinelPoster.astro';
import '../styles/home-hero.css';

interface Props {
  crop?: 'about' | 'services' | 'works' | 'process';
}

const { crop = 'about' } = Astro.props;
---

<div class:list={['home-hero', 'page-sentinel', 'is-fallback', 'is-ready', 'is-settled', `page-sentinel--${crop}`]} data-hero>
  <slot />
  <PageSentinelPoster />
  <div class="hero3d__guard" aria-hidden="true"></div>
</div>
