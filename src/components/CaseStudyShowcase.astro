---
import type { HomepageFeaturedCaseStudy } from '../lib/sanity/homepage';
import LocalImage from './LocalImage.astro';

interface Props {
  items: HomepageFeaturedCaseStudy[];
  showHeader?: boolean;
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  items: featuredItems,
  showHeader = true,
  eyebrow = 'Works',
  title = 'Production systems, not portfolio filler',
  description = 'Compliance, SaaS, and operational software built for teams that need systems to hold up under real load.',
} = Astro.props;

const items = featuredItems.filter((item) => Boolean(item?.study?.slug));
const kinds = ['cinema', 'wide', 'square'] as const;
---

<section id="case-study-showcase" class="sp-section">
  <div class="c-wrap">
    {showHeader && (
      <header class="sp-header">
        <p class="c-micro c-red">{eyebrow}</p>
        <h2 class="page-h2">{title}</h2>
        <p class="c-lede sp-header__lede">{description}</p>
      </header>
    )}

    <div class="works-list">
      {items.map((item, index) => {
        const study = item.study;
        const kind = kinds[index % kinds.length];
        const name = study.title.split(':')[0].trim();
        const focus = (item.tabLabel || study.category || '').split('•')[0].trim();
        return (
          <article class:list={['works-item', `works-item--${kind}`, /1archiver/i.test(study.slug) && 'works-item--archiver']}>
            <a class="works-item__frame" href={`/case-studies/${study.slug}`}>
              {study.imageUrl ? (
                <img
                  src={study.imageUrl}
                  alt={study.title}
                  class="works-item__shot"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  width="1600"
                  height="900"
                  decoding="async"
                />
              ) : (
                <LocalImage
                  src={study.image}
                  alt={study.title}
                  class="works-item__shot"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  kind={index === 0 ? 'hero' : 'card'}
                  width={1600}
                />
              )}
            </a>
            <div class="works-item__meta">
              <div>
                <p class="c-micro">Project</p>
                <p class="works-item__val">
                  <a href={`/case-studies/${study.slug}`}>{name}</a>
                </p>
              </div>
              <div>
                <p class="c-micro">Focus</p>
                <p class="works-item__val">{focus || study.category}</p>
              </div>
              <div>
                <p class="c-micro">System</p>
                <p class="works-item__val">{study.subtitle}</p>
              </div>
              <div>
                <p class="c-micro">Case study</p>
                <p class="works-item__val">
                  <a href={`/case-studies/${study.slug}`}>View case study ↗</a>
                </p>
              </div>
            </div>
            {study.description && (
              <p class="c-lede works-item__lede">{study.description}</p>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>
