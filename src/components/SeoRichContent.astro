---
import type { SeoExtra } from '../data/seoExtras';
import { deliverySteps } from '../data/siteContent';

interface Props {
  extras?: SeoExtra;
  slug: string;
}

const { extras, slug } = Astro.props;
const steps = extras?.processSteps ?? deliverySteps.slice(0, 3);
---

{extras && extras.benefits.length > 0 && (
  <section class="pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-display font-bold text-white mb-8">Why teams choose us for this</h2>
      <div class="grid md:grid-cols-3 gap-4">
        {extras.benefits.map((benefit) => (
          <div class="p-6 rounded-2xl glass-card h-full">
            <h3 class="font-bold text-white mb-3">{benefit.title}</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">{benefit.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

{extras && extras.seoSections.length > 0 && (
  <section class="pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {extras.seoSections.map((section) => (
        <div>
          <h2 class="text-2xl md:text-3xl font-display font-bold text-white mb-5">{section.heading}</h2>
          <div class="space-y-4">
            {section.paragraphs.map((paragraph) => (
              <p class="text-zinc-400 leading-relaxed text-lg">{paragraph}</p>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<section class="pb-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-display font-bold text-white mb-8">How we deliver</h2>
    <div class="grid md:grid-cols-3 gap-4">
      {steps.map((step) => (
        <div class="relative p-6 rounded-2xl glass-card">
          <div class="text-primary-400 font-display font-bold text-sm mb-3">{step.step}</div>
          <h3 class="font-bold text-white mb-2">{step.title}</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="pb-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-8 rounded-2xl bg-zinc-900/30 border border-dashed border-zinc-700 text-center">
      <p class="text-zinc-400 mb-4">Not sure where to start?</p>
      <a href="/blog" class="text-primary-400 font-semibold hover:text-primary-300">Read our guides on automation & integrations →</a>
      <span class="text-zinc-600 mx-3">·</span>
      <a href={`/ai-systems-sprint`} class="text-primary-400 font-semibold hover:text-primary-300">Try the 14 day sprint →</a>
    </div>
  </div>
</section>
