---
import type { SeoExtra } from '../data/seoExtras';
import { deliverySteps } from '../data/siteContent';

interface Props {
  extras: SeoExtra;
  slug: string;
}

const { extras } = Astro.props;
const steps = extras.processSteps ?? deliverySteps.slice(0, 3);
---

{extras.benefits.length > 0 && (
  <section class="sp-section">
    <div class="c-wrap seo-measure">
      <h2 class="page-h2">Why teams choose us for this</h2>
      <div class="sp-grid sp-grid--3" style="margin-top: 24px">
        {extras.benefits.map((benefit) => (
          <article class="sp-card">
            <h3 class="sp-card__title">{benefit.title}</h3>
            <p class="c-lede sp-card__body">{benefit.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{extras.seoSections.length > 0 && (
  <section class="sp-section sp-section--tight">
    <div class="c-wrap seo-measure seo-longform">
      {extras.seoSections.map((section) => (
        <div class="seo-longform__block">
          <h2 class="page-h2">{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p class="c-lede">{paragraph}</p>
          ))}
        </div>
      ))}
    </div>
  </section>
)}

<section class="sp-section">
  <div class="c-wrap seo-measure">
    <h2 class="page-h2">How we deliver</h2>
    <div class="sp-grid sp-grid--3" style="margin-top: 24px">
      {steps.map((step) => (
        <article class="sp-card">
          <p class="c-micro c-red">{step.step}</p>
          <h3 class="sp-card__title">{step.title}</h3>
          <p class="c-lede sp-card__body">{step.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="sp-section sp-section--tight">
  <div class="c-wrap">
    <div class="sp-promo">
      <div class="sp-promo__copy">
        <p class="c-micro c-red">Next step</p>
        <p class="c-lede">Not sure where to start? Read the guides or try a focused sprint.</p>
      </div>
      <div class="page-hero__actions" style="margin:0">
        <a class="c-btn c-btn--ghost" href="/blog">Guides</a>
        <a class="c-btn" href="/ai-systems-sprint">14 day sprint</a>
      </div>
    </div>
  </div>
</section>
