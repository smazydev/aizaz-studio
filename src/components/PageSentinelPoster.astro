---
const poster = '/images/hero/aizaz-sentinel-poster.webp';
const png = '/images/hero/aizaz-sentinel.png';
---

<div class="hero3d hero3d--static" aria-hidden="true">
  <div class="hero3d__poster hero3d__poster--static">
    <picture>
      <source srcset={poster} type="image/webp" />
      <img
        class="hero-sentinel"
        src={png}
        alt=""
        width="768"
        height="1024"
        decoding="async"
        fetchpriority="low"
        loading="eager"
      />
    </picture>
  </div>
</div>
