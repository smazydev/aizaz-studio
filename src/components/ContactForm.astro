---
import {
  CONTACT_INTERESTS,
  CONTACT_LIMITS,
  TURNSTILE_DUMMY_SITE_KEY_PASS,
  TURNSTILE_SITE_KEY,
} from '../data/contact';

interface Props {
  submitLabel?: string;
}

const { submitLabel = 'Submit message' } = Astro.props;

const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ||
  (import.meta.env.DEV ? TURNSTILE_DUMMY_SITE_KEY_PASS : TURNSTILE_SITE_KEY);
---

<form
  class="c-contact-form"
  data-contact-form
  data-turnstile-sitekey={siteKey}
  action="/api/contact"
  method="post"
>
  <div class="c-contact-form__hp" aria-hidden="true">
    <label>
      Company website
      <input name="company_website" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <label class="c-cta__field">
    <span class="visually-hidden">Your name</span>
    <input
      name="name"
      placeholder="Your name"
      required
      autocomplete="name"
      maxlength={CONTACT_LIMITS.nameMax}
    />
  </label>
  <label class="c-cta__field">
    <span class="visually-hidden">Email</span>
    <input
      name="email"
      type="email"
      placeholder="Email"
      required
      autocomplete="email"
      maxlength={CONTACT_LIMITS.emailMax}
    />
  </label>
  <label class="c-cta__field">
    <span class="visually-hidden">What are you interested in</span>
    <select name="interest" required>
      <option value="" disabled selected>What are you interested in</option>
      {CONTACT_INTERESTS.map((interest) => <option value={interest}>{interest}</option>)}
    </select>
  </label>
  <label class="c-cta__field">
    <span class="visually-hidden">Project details</span>
    <textarea
      name="message"
      placeholder="More about the project"
      required
      rows="4"
      minlength={CONTACT_LIMITS.messageMin}
      maxlength={CONTACT_LIMITS.messageMax}
    ></textarea>
  </label>

  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_term" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="gclid" value="" />
  <input type="hidden" name="landing_url" value="" />
  <input type="hidden" name="referring_page" value="" />

  <input type="hidden" name="cf-turnstile-response" value="" />
  <div class="c-contact-form__turnstile" data-turnstile></div>
  <p class="c-contact-form__status" data-contact-status role="status" aria-live="polite" hidden></p>
  <button class="c-btn c-btn--light" type="submit" data-contact-submit>{submitLabel}</button>
</form>

<style>
  .c-contact-form {
    position: relative;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .c-contact-form__hp {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .c-contact-form__turnstile {
    min-height: 66px;
    max-width: 100%;
    overflow-x: auto;
  }

  .c-contact-form__status {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.4;
    color: #f3b4a8;
  }

  .c-contact-form__status[data-tone='idle'] {
    color: inherit;
  }

  .c-contact-form :global(.c-btn:disabled) {
    opacity: 0.7;
    cursor: wait;
    pointer-events: none;
  }
</style>

<script>
  import { bindContactForms } from '../lib/contact-form';
  bindContactForms();
</script>
