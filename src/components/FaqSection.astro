---
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  heading?: string;
}

const { faqs, heading = 'Frequently Asked Questions' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="c-faq">
    <div class="c-wrap">
      <p class="c-micro c-red">FAQs</p>
      <h2 class="page-h2">{heading}</h2>
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}<span>+</span></summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
})} />
