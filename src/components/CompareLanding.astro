---
import type { ComparePage } from '../data/comparePages';
import FaqSection from './FaqSection.astro';
import PageCTA from './PageCTA.astro';
import { BOOKING_URL } from '../data/siteConfig';

interface Props {
  page: ComparePage;
}

const { page } = Astro.props;
---

<section class="page-hero">
  <div class="c-wrap">
    <nav class="page-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/compare">Compare</a>
      <span>/</span>
      <span>{page.title}</span>
    </nav>
    <p class="c-micro c-red">Compare</p>
    <h1 class="page-title">{page.title}</h1>
    <p class="c-lede page-hero__lede">{page.heroSubtitle}</p>
    <p class="c-lede page-hero__lede">{page.intro}</p>
  </div>
</section>

<section class="sp-section">
  <div class="c-wrap">
    <div class="sp-table-wrap">
      <table class="sp-table">
        <thead>
          <tr>
            <th></th>
            <th>Aizaz Studio</th>
            <th>{page.optionBLabel ?? 'Alternative'}</th>
          </tr>
        </thead>
        <tbody>
          {page.comparisonRows.map((row) => (
            <tr>
              <td>{row.label}</td>
              <td>{row.optionA}</td>
              <td>{row.optionB}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

{page.sections.map((section) => (
  <section class="sp-section sp-section--tight">
    <div class="c-wrap seo-measure">
      <h2 class="page-h2">{section.heading}</h2>
      {section.paragraphs.map((p) => (
        <p class="c-lede" style="margin-top: 14px">{p}</p>
      ))}
    </div>
  </section>
))}

<section class="sp-section">
  <div class="c-wrap seo-measure">
    <h2 class="page-h2">Related reading</h2>
    <div class="sp-group__links" style="margin-top: 20px">
      {page.relatedLinks.map((link) => (
        <a class="sp-link" href={link.href}><strong>{link.label}</strong></a>
      ))}
    </div>
  </div>
</section>

{page.faqs?.length > 0 && <FaqSection faqs={page.faqs} />}

<section class="sp-section sp-section--tight">
  <div class="c-wrap">
    <div class="sp-promo">
      <div class="sp-promo__copy">
        <p class="c-lede">{page.ctaText}</p>
      </div>
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a Call</a>
    </div>
  </div>
</section>

<PageCTA />
