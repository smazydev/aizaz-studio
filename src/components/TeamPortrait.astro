---
import { Image } from 'astro:assets';
import type { LeadershipProfile } from '../data/leadership';

interface Props {
  person: LeadershipProfile;
  class?: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
}

const {
  person,
  class: className = '',
  widths = [240, 360, 480, 640],
  sizes = '(max-width: 800px) 28vw, 260px',
  width = 640,
  height = 640,
  loading = 'lazy',
} = Astro.props;
---

<Image
  class={className}
  src={person.image}
  alt={person.imageAlt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  quality={82}
  loading={loading}
  decoding="async"
  style={`--portrait-pos: ${person.objectPosition}; object-position: ${person.objectPosition}`}
/>
