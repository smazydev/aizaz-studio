---
const poster = '/images/hero/aizaz-sentinel-poster.webp';
const png = '/images/hero/aizaz-sentinel.png';
---

<link rel="preload" href="/models/aizaz-sentinel.glb?v=2" as="fetch" crossorigin="anonymous" media="(min-width: 769px)" />

<div class="hero3d" data-hero3d>
  <canvas class="hero3d__canvas" data-hero-canvas aria-hidden="true"></canvas>

  <div class="hero3d__load" data-hero-load aria-hidden="true">
    <span class="hero3d__load-mark">LOADING SYSTEM</span>
    <span class="hero3d__load-bar" aria-hidden="true"><i></i></span>
  </div>

  <div class="hero3d__poster" data-hero-poster hidden>
    <picture>
      <source srcset={poster} type="image/webp" />
      <img
        class="hero-sentinel"
        src={png}
        alt=""
        width="768"
        height="1024"
        decoding="async"
        fetchpriority="low"
        loading="eager"
      />
    </picture>
  </div>
</div>

<script>
  import { mountHeroSentinel, type HeroSentinelHandle } from './hero-sentinel';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero && !hero.dataset.hero3dMounted) {
    hero.dataset.hero3dMounted = '1';

    let handle: HeroSentinelHandle | undefined;
    const pending = mountHeroSentinel(hero).then((mounted) => {
      handle = mounted;
      return mounted;
    });

    const release = () => {
      if (hero.dataset.hero3dMounted !== '1') return;
      delete hero.dataset.hero3dMounted;
      if (handle) {
        handle.dispose();
        handle = undefined;
        return;
      }
      void pending.then((mounted) => mounted.dispose());
    };

    window.addEventListener('pagehide', release, { once: true });
    document.addEventListener('astro:before-swap', release, { once: true });
  }
</script>
