---
import type { SeoPage, IndustryPage } from '../data/seoPages';
import { getSeoExtras } from '../data/seoExtras';
import SeoRichContent from './SeoRichContent.astro';
import RelatedContent from './RelatedContent.astro';
import FaqSection from './FaqSection.astro';
import PageCTA from './PageCTA.astro';
import type { RelatedGroup } from '../data/internalLinks';

interface Props {
  page: SeoPage | IndustryPage;
  breadcrumb: { label: string; href: string }[];
  badge?: string;
  relatedServices?: SeoPage[];
  relatedGroups?: RelatedGroup[];
}

const { page, breadcrumb, badge = 'Service', relatedServices = [], relatedGroups = [] } = Astro.props;
const isIndustry = 'audienceLabel' in page;
const extras = getSeoExtras(page);
const showLegacyRelated = relatedGroups.length === 0 && relatedServices.length > 0;
---

<section class="page-hero">
  <div class="c-wrap">
    <nav class="page-crumbs" aria-label="Breadcrumb">
      {breadcrumb.map((item, index) => (
        <>
          {index > 0 && <span>/</span>}
          <a href={item.href}>{item.label}</a>
        </>
      ))}
      <span>/</span>
      <span>{page.title}</span>
    </nav>
    <p class="c-micro c-red">{isIndustry ? (page as IndustryPage).audienceLabel : badge}</p>
    <h1 class="page-title">{page.title}</h1>
    <p class="c-lede page-hero__lede">{page.heroSubtitle}</p>
    <div class="page-hero__actions">
      <a class="c-btn" href="/book-a-call">Book a Free Call</a>
      <a class="c-btn c-btn--ghost" href="/ai-systems-sprint">14 Day Sprint</a>
    </div>
  </div>
</section>

<section class="sp-section sp-section--tight">
  <div class="c-wrap seo-measure">
    <div class="sp-grid">
      <article class="sp-card">
        <h2 class="sp-card__title">The problem</h2>
        <p class="c-lede sp-card__body">{page.problem}</p>
      </article>
      <article class="sp-card">
        <h2 class="sp-card__title">How we help</h2>
        <p class="c-lede sp-card__body">{page.solution}</p>
      </article>
    </div>
  </div>
</section>

<section class="sp-section">
  <div class="c-wrap seo-measure">
    <p class="c-micro c-red">{isIndustry ? 'What we build' : 'Capabilities'}</p>
    <h2 class="page-h2">{isIndustry ? 'What we build' : 'Capabilities'}</h2>
    <ul class="sp-list" style="margin-top: 24px; grid-template-columns: 1fr 1fr; display: grid; gap: 12px 20px">
      {page.capabilities.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</section>

<section class="sp-section sp-section--tight">
  <div class="c-wrap seo-measure">
    <p class="c-micro c-red">Examples</p>
    <h2 class="page-h2">Example use cases</h2>
    <div class="works-detail__items" style="margin-top: 20px">
      {page.useCases.map((item) => (
        <div class="sp-card seo-usecase">{item}</div>
      ))}
    </div>
  </div>
</section>

<SeoRichContent extras={extras} slug={page.slug} />

{page.faqs.length > 0 && <FaqSection faqs={page.faqs} />}

{relatedGroups.length > 0 && <RelatedContent groups={relatedGroups} />}

{showLegacyRelated && (
  <RelatedContent
    groups={[{
      title: 'Related Services',
      links: relatedServices.map((service) => ({
        href: `/services/${service.slug}`,
        label: service.title,
        description: service.heroSubtitle,
      })),
    }]}
  />
)}

<PageCTA
  title="Ready to automate one workflow in 14 days?"
  lede="Start with our AI Systems Sprint: one manual workflow turned into a working system."
/>
