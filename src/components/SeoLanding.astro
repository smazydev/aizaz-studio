---
import type { SeoPage, IndustryPage } from '../data/seoPages';
import { getSeoExtras } from '../data/seoExtras';
import SeoRichContent from './SeoRichContent.astro';
import FaqSection from './FaqSection.astro';

interface Props {
  page: SeoPage | IndustryPage;
  breadcrumb: { label: string; href: string }[];
  badge?: string;
  relatedServices?: SeoPage[];
}

const { page, breadcrumb, badge = 'Service', relatedServices = [] } = Astro.props;
const isIndustry = 'audienceLabel' in page;
const extras = getSeoExtras(page.slug);
---

<section class="page-hero">
  <div class="c-wrap">
    <nav class="page-crumbs" aria-label="Breadcrumb">
      {breadcrumb.map((item, index) => (
        <>
          {index > 0 && <span>/</span>}
          <a href={item.href}>{item.label}</a>
        </>
      ))}
      <span>/</span>
      <span>{page.title}</span>
    </nav>
    <p class="c-micro c-red">{isIndustry ? (page as IndustryPage).audienceLabel : badge}</p>
    <h1 class="page-title">{page.title}</h1>
    <p class="c-lede page-hero__lede">{page.heroSubtitle}</p>
    <div class="page-hero__actions">
      <a class="c-btn" href="/book-a-call">Book a Free Call</a>
      <a class="c-btn c-btn--ghost" href="/ai-systems-sprint">14 Day Sprint</a>
    </div>
  </div>
</section>

<section class="pb-20">
  <div class="c-wrap page-grid">
    <article class="c-card page-card">
      <p class="c-micro">Problem</p>
      <h2 class="page-card__title">The Problem</h2>
      <p class="c-lede">{page.problem}</p>
    </article>
    <article class="c-card page-card">
      <p class="c-micro c-red">Approach</p>
      <h2 class="page-card__title">How We Help</h2>
      <p class="c-lede">{page.solution}</p>
    </article>
  </div>
</section>

<section class="pb-20">
  <div class="c-wrap">
    <p class="c-micro c-red">{isIndustry ? 'Build' : 'Capabilities'}</p>
    <h2 class="page-h2">{isIndustry ? 'What we build' : 'Capabilities'}</h2>
    <ul class="page-list">
      {page.capabilities.map((item) => (
        <li class="c-card page-card">{item}</li>
      ))}
    </ul>
  </div>
</section>

<section class="pb-20">
  <div class="c-wrap">
    <p class="c-micro">Use cases</p>
    <h2 class="page-h2">Example use cases</h2>
    <div class="page-stack">
      {page.useCases.map((item) => (
        <div class="c-card page-card">{item}</div>
      ))}
    </div>
  </div>
</section>

<SeoRichContent extras={extras} slug={page.slug} />

<FaqSection faqs={page.faqs} />

{relatedServices.length > 0 && (
  <section class="pb-20">
    <div class="c-wrap">
      <p class="c-micro">Next</p>
      <h2 class="page-h2">Related services</h2>
      <div class="page-list">
        {relatedServices.map((service) => (
          <a class="c-card page-card" href={`/services/${service.slug}`}>
            <h3 class="page-card__title">{service.title}</h3>
            <p class="c-lede">{service.heroSubtitle}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<section class="page-hero" style="padding-top: 0">
  <div class="c-wrap">
    <p class="c-micro c-red">Start</p>
    <h2 class="page-h2">Ready to automate one workflow?</h2>
    <p class="c-lede page-hero__lede">Start with a 14-day sprint: one manual workflow turned into a working system.</p>
    <div class="page-hero__actions">
      <a class="c-btn" href="/book-a-call">Book a Free Call</a>
      <a class="c-btn c-btn--ghost" href="/ai-systems-sprint">Learn about the sprint</a>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.title,
  description: page.metaDescription,
  provider: {
    '@type': 'Organization',
    name: 'Aizaz.studio',
    url: 'https://aizaz.studio',
  },
  areaServed: 'Worldwide',
  serviceType: page.title,
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    ...breadcrumb.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.label,
      item: `https://aizaz.studio${item.href === '/' ? '/' : item.href.replace(/\/$/, '')}`,
    })),
    {
      '@type': 'ListItem',
      position: breadcrumb.length + 1,
      name: page.title,
    },
  ],
})} />
