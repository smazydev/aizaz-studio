---
/**
 * Blog FAQs — semantic HTML only.
 * No FAQPage JSON-LD: Google no longer offers general FAQ rich results, and we
 * keep BlogPosting/Article structured data as the primary schema for posts.
 */
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  heading?: string;
}

const { faqs, heading = 'Frequently Asked Questions' } = Astro.props;
const items = (faqs ?? []).filter((faq) => faq?.question?.trim() && faq?.answer?.trim());
---

{items.length > 0 && (
  <section class="blog-faq" aria-labelledby="blog-faq-heading">
    <h2 id="blog-faq-heading" class="page-h2">{heading}</h2>
    <div class="blog-faq__list">
      {items.map((faq) => (
        <details>
          <summary>{faq.question}<span aria-hidden="true">+</span></summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
