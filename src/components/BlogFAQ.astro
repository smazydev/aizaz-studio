---
/**
 * Blog FAQs — semantic HTML only.
 * No FAQPage JSON-LD: Google no longer offers general FAQ rich results, and we
 * keep BlogPosting/Article structured data as the primary schema for posts.
 */
interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  heading?: string;
}

const { faqs, heading = 'Frequently Asked Questions' } = Astro.props;
const items = (faqs ?? []).filter((faq) => faq?.question?.trim() && faq?.answer?.trim());
---

{items.length > 0 && (
  <section class="mt-16 pt-12 border-t border-white/10" aria-labelledby="blog-faq-heading">
    <h2 id="blog-faq-heading" class="text-2xl md:text-3xl font-display font-bold text-white mb-8">
      {heading}
    </h2>
    <div class="space-y-3">
      {items.map((faq) => (
        <details class="group border border-white/10 rounded-xl bg-zinc-950/60 open:border-white/15">
          <summary class="cursor-pointer list-none px-5 py-4 text-base md:text-lg font-semibold text-white flex items-start justify-between gap-4">
            <span>{faq.question}</span>
            <span class="text-primary-400 group-open:rotate-45 transition-transform text-xl leading-none shrink-0" aria-hidden="true">+</span>
          </summary>
          <div class="px-5 pb-5">
            <p class="text-zinc-400 leading-relaxed">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
