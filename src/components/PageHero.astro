---
interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  size?: 'default' | 'large';
}

const {
  eyebrow,
  title,
  highlight,
  description,
} = Astro.props;
---

<section class="page-hero">
  <div class="c-wrap">
    {eyebrow && <p class="c-micro c-red">{eyebrow}</p>}
    <h1 class="page-title">
      {title}
      {highlight && (
        <>
          {' '}
          <span class="page-title__accent">{highlight}</span>
        </>
      )}
    </h1>
    {description && <p class="c-lede page-hero__lede">{description}</p>}
    {Astro.slots.has('default') && (
      <div class="page-hero__actions">
        <slot />
      </div>
    )}
    {Astro.slots.has('below') && (
      <div class="page-hero__below">
        <slot name="below" />
      </div>
    )}
  </div>
</section>
