---
import { isExternalHref } from '../../data/siteConfig';
import { getSiteSettings } from '../../lib/sanity/siteSettings';

const siteFooter = await getSiteSettings();
const year = new Date().getFullYear();
---

<footer class="c-foot">
  <img class="c-foot__mark" src="/aizaz-logo-white.png" alt="" width="520" height="520" aria-hidden="true" />
  <div class="c-wrap">
    <div class="c-foot__cols">
      <div>
        <p class="c-foot__heading">{siteFooter.studio.heading}</p>
        <a class="c-foot__brand" href="/">
          <img src="/aizaz-logo-white.png" alt="" width="40" height="40" />
          Aizaz Studio
        </a>
        <p>{siteFooter.studio.blurb}</p>
        <a href={`mailto:${siteFooter.studio.email}`}>{siteFooter.studio.email}</a>
        <a href={siteFooter.studio.phoneHref}>{siteFooter.studio.phone}</a>
      </div>
      {siteFooter.columns.map((col) => (
        <div>
          <p class="c-foot__heading">{col.heading}</p>
          {col.links.map((link) => (
            <a
              href={link.href}
              target={isExternalHref(link.href) ? '_blank' : undefined}
              rel={isExternalHref(link.href) ? 'noopener noreferrer' : undefined}
            >{link.label}</a>
          ))}
        </div>
      ))}
    </div>
    <div class="c-foot__base">
      <span>© {year} Aizaz Studio. All rights reserved.</span>
      <span>
        Karachi · Remote ·
        <a
          href="https://karmalinks.io/?verificationId=6ab931e8392c10b28b73c909"
          target="_blank"
          rel="noopener noreferrer"
        >Verified on Karmalinks</a>
      </span>
    </div>
  </div>
</footer>
