---
import { BOOKING_URL, BOOKING_EMBED_URL } from '../data/siteConfig';

interface Props {
  title?: string;
}

const { title = 'Schedule your strategy call' } = Astro.props;
---

<div class="rounded-2xl border border-white/10 bg-zinc-900/40 overflow-hidden">
  <div class="px-6 py-4 border-b border-white/5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
      <p class="text-primary-400 text-sm font-bold uppercase tracking-widest">{title}</p>
      <p class="text-zinc-400 text-sm mt-1">Pick a time that works for you. Strategy calls are typically 30 minutes.</p>
    </div>
    <a
      href={BOOKING_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex justify-center px-5 py-2.5 rounded-full bg-white text-black text-sm font-semibold hover:bg-zinc-100 transition-colors shrink-0"
    >
      Open in Google Calendar
    </a>
  </div>
  <iframe
    src={BOOKING_EMBED_URL}
    title="Book a strategy call with Aizaz Studio"
    class="w-full h-[680px] sm:h-[720px] bg-white"
    loading="lazy"
  />
</div>
