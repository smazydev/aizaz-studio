---
import type { ImageMetadata } from 'astro';
import { assetBasename, defaultSizes, optimizedSrc, optimizedSrcSet } from '../lib/optimized-image';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  kind?: 'card' | 'hero' | 'content';
  /** Max width hint for src selection */
  width?: number;
  /** Responsive rendered-width hint for srcset selection */
  sizes?: string;
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy',
  fetchpriority,
  kind = 'content',
  width,
  sizes: sizesHint,
} = Astro.props;
const basename = assetBasename(src);
const srcSet = basename ? optimizedSrcSet(basename) : undefined;
const primary = basename ? optimizedSrc(basename, width) : src.src;
const sizes = sizesHint ?? defaultSizes(kind);
const widthAttr = width ?? (kind === 'hero' ? 1200 : kind === 'card' ? 800 : 1000);
const heightAttr = src.height && src.width ? Math.round((widthAttr / src.width) * src.height) : undefined;
---

{basename ? (
  <img
    src={primary}
    srcset={srcSet}
    sizes={sizes}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    width={widthAttr}
    height={heightAttr}
    decoding="async"
  />
) : (
  <img
    src={src.src}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    width={src.width}
    height={src.height}
    decoding="async"
  />
)}
