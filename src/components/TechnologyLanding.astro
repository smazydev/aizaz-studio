---
import type { TechnologyPage } from '../data/technologyPages';
import FaqSection from './FaqSection.astro';

interface Props {
  page: TechnologyPage;
}

const { page } = Astro.props;
---

<section class="page-hero">
  <div class="c-wrap">
    <nav class="page-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/technologies">Technologies</a>
      <span>/</span>
      <span>{page.title}</span>
    </nav>
    <p class="c-micro c-red">Technology</p>
    <h1 class="page-title">{page.title}</h1>
    <p class="c-lede page-hero__lede">{page.heroSubtitle}</p>
    <div class="page-hero__actions">
      <a class="c-btn" href="/book-a-call">Book a Call</a>
      <a class="c-btn c-btn--ghost" href="/services">View Services</a>
    </div>
  </div>
</section>

<section class="pb-16">
  <div class="c-wrap">
    <p class="c-micro">Outcomes</p>
    <h2 class="page-h2">What we build with it</h2>
    <ul class="page-list">
      {page.outcomes.map((item) => (
        <li class="c-card page-card">{item}</li>
      ))}
    </ul>
  </div>
</section>

<section class="pb-16">
  <div class="c-wrap">
    <p class="c-micro">Use cases</p>
    <h2 class="page-h2">Example use cases</h2>
    <div class="page-stack">
      {page.useCases.map((item) => (
        <div class="c-card page-card">{item}</div>
      ))}
    </div>
  </div>
</section>

<section class="pb-16">
  <div class="c-wrap">
    <p class="c-micro">Production</p>
    <h2 class="page-h2">How we use it</h2>
    <ul class="page-stack">
      {page.stackNotes.map((note) => (
        <li class="c-lede" style="border-left: 1px solid var(--line); padding-left: 16px;">{note}</li>
      ))}
    </ul>
  </div>
</section>

<section class="pb-16">
  <div class="c-wrap">
    <p class="c-micro">Next</p>
    <h2 class="page-h2">Related services</h2>
    <div class="page-hero__actions">
      {page.relatedServices.map((link) => (
        <a class="c-btn c-btn--ghost" href={link.href}>{link.label}</a>
      ))}
    </div>
  </div>
</section>

<FaqSection faqs={page.faqs} />

<section class="page-hero" style="padding-top: 0">
  <div class="c-wrap">
    <a class="c-btn" href="/book-a-call">Discuss your stack</a>
  </div>
</section>
