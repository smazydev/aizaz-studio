---
import type { TechnologyPage } from '../data/technologyPages';
import FaqSection from './FaqSection.astro';
import RelatedContent from './RelatedContent.astro';
import PageCTA from './PageCTA.astro';
import { getTechnologyRelatedGroups } from '../data/internalLinks';
import { BOOKING_URL } from '../data/siteConfig';

interface Props {
  page: TechnologyPage;
}

const { page } = Astro.props;
const clusterGroups = getTechnologyRelatedGroups(page.slug).filter((g) => g.title !== 'Related Services');
const shortName = page.title.replace(' Development', '').replace(' Services', '');
---

<section class="page-hero">
  <div class="c-wrap">
    <nav class="page-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/technologies">Technologies</a>
      <span>/</span>
      <span>{page.title}</span>
    </nav>
    <p class="c-micro c-red">Technology</p>
    <h1 class="page-title">{page.title}</h1>
    <p class="c-lede page-hero__lede">{page.heroSubtitle}</p>
    <div class="page-hero__actions">
      <a class="c-btn" href={BOOKING_URL} target="_blank" rel="noopener noreferrer">Book a Call</a>
      <a class="c-btn c-btn--ghost" href="/services">View Services</a>
    </div>
  </div>
</section>

<section class="sp-section sp-section--tight">
  <div class="c-wrap seo-measure">
    <h2 class="page-h2">Business outcomes we build with {shortName}</h2>
    <ul class="sp-list sp-list--columns" style="margin-top: 24px">
      {page.outcomes.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<section class="sp-section">
  <div class="c-wrap seo-measure">
    <h2 class="page-h2">Example use cases</h2>
    <div class="works-detail__items" style="margin-top: 20px">
      {page.useCases.map((item) => (
        <div class="sp-card">{item}</div>
      ))}
    </div>
  </div>
</section>

<section class="sp-section sp-section--tight">
  <div class="c-wrap seo-measure">
    <h2 class="page-h2">How we use it in production</h2>
    <ul class="sp-list" style="margin-top: 20px">
      {page.stackNotes.map((note) => <li>{note}</li>)}
    </ul>
  </div>
</section>

<section class="sp-section">
  <div class="c-wrap seo-measure">
    <h2 class="page-h2">Related services</h2>
    <div class="sp-group__links" style="margin-top: 20px">
      {page.relatedServices.map((link) => (
        <a class="sp-link" href={link.href}><strong>{link.label}</strong></a>
      ))}
    </div>
  </div>
</section>

<RelatedContent groups={clusterGroups} />
<FaqSection faqs={page.faqs} />
<PageCTA
  title="Discuss your stack"
  lede="Book a call to map how this technology fits your product or operations system."
  secondaryHref="/services"
  secondaryLabel="View Services"
/>
