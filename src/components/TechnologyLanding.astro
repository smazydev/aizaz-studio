---
import type { TechnologyPage } from '../data/technologyPages';
import FaqSection from './FaqSection.astro';

interface Props {
  page: TechnologyPage;
}

const { page } = Astro.props;
---

<section class="pt-32 pb-16 relative overflow-hidden page-glow">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <nav class="flex flex-wrap items-center gap-2 text-sm text-zinc-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary-400 transition-colors">Home</a>
      <span>/</span>
      <a href="/technologies" class="hover:text-primary-400 transition-colors">Technologies</a>
      <span>/</span>
      <span class="text-zinc-300">{page.title}</span>
    </nav>
    <div class="text-primary-500 font-bold tracking-widest text-sm mb-4 uppercase">Technology</div>
    <h1 class="text-4xl md:text-5xl font-display font-bold text-white mb-6 leading-tight">{page.title}</h1>
    <p class="text-xl text-zinc-400 leading-relaxed mb-8">{page.heroSubtitle}</p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="/book-a-call" class="inline-flex justify-center px-6 py-3 rounded-full bg-white text-black font-semibold hover:bg-zinc-100 transition-colors">Book a Call</a>
      <a href="/services" class="inline-flex justify-center px-6 py-3 rounded-full border border-zinc-700 text-white font-medium hover:bg-zinc-900 transition-colors">View Services</a>
    </div>
  </div>
</section>

<section class="pb-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-display font-bold text-white mb-6">Business outcomes we build with {page.title.replace(' Development', '').replace(' Services', '')}</h2>
    <ul class="grid md:grid-cols-2 gap-4">
      {page.outcomes.map((item) => (
        <li class="flex items-start gap-3 p-4 rounded-xl glass-card">
          <span class="mt-1.5 w-2 h-2 rounded-full bg-primary-500 shrink-0"></span>
          <span class="text-zinc-300">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="pb-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-display font-bold text-white mb-6">Example use cases</h2>
    <div class="space-y-3">
      {page.useCases.map((item) => (
        <div class="p-4 rounded-xl glass-card text-zinc-300 text-sm md:text-base">{item}</div>
      ))}
    </div>
  </div>
</section>

<section class="pb-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-display font-bold text-white mb-6">How we use it in production</h2>
    <ul class="space-y-3">
      {page.stackNotes.map((note) => (
        <li class="text-zinc-400 leading-relaxed pl-4 border-l-2 border-primary-500/30">{note}</li>
      ))}
    </ul>
  </div>
</section>

<section class="pb-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-display font-bold text-white mb-6">Related services</h2>
    <div class="flex flex-wrap gap-3">
      {page.relatedServices.map((link) => (
        <a href={link.href} class="px-4 py-2 rounded-full border border-zinc-700 text-sm text-zinc-300 hover:border-primary-500/40 hover:text-white transition-colors">{link.label}</a>
      ))}
    </div>
  </div>
</section>

<FaqSection faqs={page.faqs} />

<section class="pb-24">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <a href="/book-a-call" class="inline-flex px-8 py-4 rounded-full bg-primary-600 text-white font-bold hover:bg-primary-500 transition-colors">Discuss your stack</a>
  </div>
</section>
