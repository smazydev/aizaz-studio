---
import ContactForm from './ContactForm.astro';
import { siteFooter } from '../data/siteChrome';

interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  /** @deprecated Buttons were replaced by the contact form. */
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  eyebrow = 'Contact',
  title = 'Let’s build the next system',
  lede = 'Tell us what you need to ship.',
} = Astro.props;

const contact = siteFooter.studio;
const defaultTitle = title === 'Let’s build the next system';
---

<section class="c-cta sp-section" id="contact">
  <div class="c-wrap">
    <div class="c-cta__panel">
      <div class="c-cta__art viz-ribbons" aria-hidden="true"></div>
      <div class="c-cta__copy">
        <p class="c-micro">{eyebrow}</p>
        <h2 class="c-h1">
          {defaultTitle ? (
            <>Let’s build<br />the next<br />system</>
          ) : (
            title
          )}
        </h2>
        <p class="c-cta__lede">
          {lede}
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <span aria-hidden="true"> · </span>
          <a href={contact.phoneHref}>{contact.phone}</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </div>
</section>
