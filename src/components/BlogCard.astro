---
import type { PublicBlogPost } from '../lib/blog';
import AuthorCard from './AuthorCard.astro';
import LocalImage from './LocalImage.astro';

interface Props {
  blog: PublicBlogPost;
  featured?: boolean;
}

const { blog, featured = false } = Astro.props;
---

<article class:list={['blog-card', featured && 'blog-card--featured']}>
  <a href={`/blog/${blog.slug}`} class="blog-card__media">
    {blog.image ? (
      <LocalImage
        src={blog.image}
        alt={blog.title}
        class="blog-card__shot"
        loading="lazy"
        kind="card"
        width={960}
      />
    ) : blog.imageUrl ? (
      <img
        src={blog.imageUrl}
        alt={blog.title}
        class="blog-card__shot"
        loading="lazy"
        width="960"
        height="600"
        decoding="async"
      />
    ) : (
      <div class="blog-card__fallback">
        <img src="/aizaz-logo-white.png" alt="" width="120" height="30" loading="lazy" decoding="async" />
      </div>
    )}
    <span class="c-micro c-red blog-card__cat">{blog.category}</span>
  </a>

  <div class="blog-card__body">
    <div class="blog-card__meta">
      <time datetime={blog.dateIso}>{blog.date}</time>
      <span>·</span>
      <span>{blog.readTime}</span>
    </div>
    <h2 class="blog-card__title">
      <a href={`/blog/${blog.slug}`}>{blog.title}</a>
    </h2>
    <p class="c-lede blog-card__excerpt">{blog.excerpt}</p>
    <div class="blog-card__foot">
      {blog.author ? <AuthorCard author={blog.author} compact /> : <span />}
      <a class="blog-card__more" href={`/blog/${blog.slug}`}>Read →</a>
    </div>
  </div>
</article>
