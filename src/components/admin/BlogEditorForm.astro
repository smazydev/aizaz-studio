---
import { BLOG_CATEGORIES } from '../../lib/blog-categories';
import type { BlogPostRow } from '../../lib/blog-db';

interface Props {
  post?: BlogPostRow;
  mode: 'create' | 'edit';
}

const { post, mode } = Astro.props;
const tagsValue = post ? JSON.parse(post.tags || '[]').join(', ') : '';
const scheduledValue = post?.scheduled_at ? post.scheduled_at.slice(0, 16) : '';
---

<form id="blog-editor-form" class="grid" style="gap:1.5rem;">
  <section class="card grid">
    <h2 style="margin-top:0;">Content</h2>
    <div class="field">
      <label for="title">Title</label>
      <input id="title" name="title" value={post?.title ?? ''} required />
    </div>
    <div class="field">
      <label for="slug">Slug</label>
      <input id="slug" name="slug" value={post?.slug ?? ''} required />
      <p class="muted">Public URL: /blog/[slug]</p>
    </div>
    <div class="field">
      <label for="excerpt">Excerpt</label>
      <textarea id="excerpt" name="excerpt" rows="3" required>{post?.excerpt ?? ''}</textarea>
    </div>
    <div class="field">
      <label for="content">Article content (Markdown)</label>
      <textarea id="content" name="content" class="content-editor" required>{post?.content ?? ''}</textarea>
    </div>
    <div class="grid grid-2">
      <div class="field">
        <label for="category">Category</label>
        <select id="category" name="category">
          {BLOG_CATEGORIES.map((category) => (
            <option value={category} selected={post?.category === category}>{category}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="tags">Tags</label>
        <input id="tags" name="tags" value={tagsValue} placeholder="AI, SaaS, Automation" />
      </div>
    </div>
    <div class="field">
      <label for="author">Author</label>
      <input id="author" name="author" value={post?.author ?? 'Aizaz K.'} />
    </div>
    <div class="field">
      <label for="featured_image">Featured image URL</label>
      <input id="featured_image" name="featured_image" value={post?.featured_image ?? ''} />
      <input id="featured_image_file" type="file" accept="image/*" />
      <p class="muted">Upload an image or paste a URL. Uploaded images are stored in R2 when configured.</p>
      {post?.featured_image && (
        <img src={post.featured_image} alt="Featured preview" style="max-width:320px;border-radius:12px;margin-top:0.75rem;" loading="lazy" />
      )}
    </div>
  </section>

  <section class="card grid">
    <h2 style="margin-top:0;">SEO</h2>
    <div class="field">
      <label for="seo_title">SEO title</label>
      <input id="seo_title" name="seo_title" value={post?.seo_title ?? ''} />
    </div>
    <div class="field">
      <label for="meta_description">Meta description</label>
      <textarea id="meta_description" name="meta_description" rows="3">{post?.meta_description ?? ''}</textarea>
    </div>
    <div class="grid grid-2">
      <div class="field">
        <label for="canonical_url">Canonical URL</label>
        <input id="canonical_url" name="canonical_url" value={post?.canonical_url ?? ''} placeholder="/blog/your-slug" />
      </div>
      <div class="field">
        <label for="og_image">Open Graph image URL</label>
        <input id="og_image" name="og_image" value={post?.og_image ?? ''} />
      </div>
    </div>
  </section>

  <section class="card grid">
    <h2 style="margin-top:0;">Publishing</h2>
    <div class="grid grid-2">
      <div class="field">
        <label for="publish_mode">Action</label>
        <select id="publish_mode" name="publish_mode">
          <option value="draft" selected={!post || post.status === 'draft'}>Save draft</option>
          <option value="publish" selected={post?.status === 'published'}>Publish now</option>
          <option value="schedule" selected={post?.status === 'scheduled'}>Schedule</option>
          {mode === 'edit' && post?.status === 'published' && <option value="unpublish">Unpublish</option>}
        </select>
      </div>
      <div class="field">
        <label for="scheduled_at">Schedule for</label>
        <input id="scheduled_at" name="scheduled_at" type="datetime-local" value={scheduledValue} />
      </div>
    </div>
    <div class="actions">
      <button class="btn btn-primary" type="submit">Save</button>
      {mode === 'edit' && post?.preview_token && (
        <a class="btn" href={`/blog/preview/${post.preview_token}`} target="_blank" rel="noreferrer">Preview</a>
      )}
      {mode === 'edit' && (
        <button class="btn btn-danger" type="button" id="delete-post-btn">Delete</button>
      )}
    </div>
    <p id="editor-message" class="muted"></p>
  </section>
</form>

<script define:vars={{ mode, postId: post?.id ?? null }}>
  const form = document.getElementById('blog-editor-form');
  const titleInput = document.getElementById('title');
  const slugInput = document.getElementById('slug');
  const messageEl = document.getElementById('editor-message');
  const fileInput = document.getElementById('featured_image_file');
  const featuredImageInput = document.getElementById('featured_image');

  let slugTouched = Boolean(slugInput.value);

  slugInput?.addEventListener('input', () => {
    slugTouched = true;
  });

  titleInput?.addEventListener('input', () => {
    if (!slugTouched) {
      slugInput.value = titleInput.value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
    }
  });

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    const formData = new FormData();
    formData.append('file', file);
    const response = await fetch('/api/admin/upload', { method: 'POST', body: formData });
    const data = await response.json();
    if (!response.ok) {
      messageEl.textContent = data.error || 'Image upload failed';
      return;
    }
    featuredImageInput.value = data.url;
    messageEl.textContent = 'Image uploaded.';
  });

  function collectPayload() {
    const formData = new FormData(form);
    return Object.fromEntries(formData.entries());
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    messageEl.textContent = 'Saving...';
    const payload = collectPayload();
    const url = mode === 'create' ? '/api/admin/posts' : `/api/admin/posts/${postId}`;
    const method = mode === 'create' ? 'POST' : 'PUT';
    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    const data = await response.json();
    if (!response.ok) {
      messageEl.textContent = data.error || 'Save failed';
      return;
    }
    messageEl.textContent = 'Saved.';
    if (mode === 'create') {
      window.location.href = `/admin/blog/${data.post.id}/edit`;
    }
  });

  document.getElementById('delete-post-btn')?.addEventListener('click', async () => {
    if (!postId || !confirm('Delete this post permanently?')) return;
    const response = await fetch(`/api/admin/posts/${postId}`, { method: 'DELETE' });
    if (!response.ok) {
      const data = await response.json();
      messageEl.textContent = data.error || 'Delete failed';
      return;
    }
    window.location.href = '/admin';
  });
</script>
