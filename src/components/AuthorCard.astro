---
import type { ContentAuthor } from '../lib/sanity/author';

interface Props {
  author: ContentAuthor;
  wrapperClass?: string;
  compact?: boolean;
}

const { author, wrapperClass = '', compact = false } = Astro.props;
const initials = author.name
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part.charAt(0))
  .join('');
---

<div class={`flex items-center gap-4 ${wrapperClass}`}>
  {author.photoUrl ? (
    <img
      src={author.photoUrl}
      alt={author.name}
      class={`rounded-full object-cover border border-white/10 ${compact ? 'w-9 h-9' : 'w-11 h-11'}`}
      loading="lazy"
    />
  ) : (
    <div
      class={`rounded-full bg-gradient-to-br from-primary-500/40 to-indigo-600/40 border border-white/10 flex items-center justify-center font-bold text-white ${
        compact ? 'w-9 h-9 text-xs' : 'w-11 h-11 text-sm'
      }`}
      aria-hidden="true"
    >
      {initials}
    </div>
  )}

  <div class="min-w-0">
    <div class={`font-semibold text-white ${compact ? 'text-sm' : 'text-base'}`}>{author.name}</div>
    <div class={`text-zinc-500 ${compact ? 'text-xs' : 'text-sm'}`}>{author.role}</div>
    {author.linkedin && (
      <a
        href={author.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 mt-1 text-xs font-medium text-primary-400 hover:text-primary-300 transition-colors"
      >
        LinkedIn →
      </a>
    )}
  </div>
</div>
