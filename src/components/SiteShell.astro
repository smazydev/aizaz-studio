---
import Layout from '../layouts/Layout.astro';
import SiteNav from './site/SiteNav.astro';
import SiteFooter from './site/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string[];
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
  noindex = false,
  schemas = [],
} = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  noindex={noindex}
  schemas={schemas}
>
  <div class="site">
    <SiteNav />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Layout>
