---
import Layout from '../layouts/Layout.astro';
import SiteNav from './site/SiteNav.astro';
import SiteFooter from './site/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string[];
  noindex?: boolean;
}

const { title, description, canonical, keywords = [], noindex = false } = Astro.props;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  noindex={noindex}
  theme="light"
>
  <div class="site">
    <SiteNav />
    <main class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </div>
</Layout>
