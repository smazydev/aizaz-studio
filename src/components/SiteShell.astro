---
import Layout from '../layouts/Layout.astro';
import { Navbar } from './Navbar';
import { Footer } from './Footer';

interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string[];
}

const { title, description, canonical, keywords = [] } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical} keywords={keywords}>
  <div class="site-shell min-h-screen bg-black text-white selection:bg-primary-500/30 selection:text-primary-200 overflow-x-hidden">
    <Navbar client:load />
    <main>
      <slot />
    </main>
    <Footer client:load />
  </div>
</Layout>
