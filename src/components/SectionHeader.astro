---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Visual variant for dark bands */
  tone?: 'default' | 'dark';
}

const { eyebrow, title, lede, tone = 'default' } = Astro.props;
---

<header class:list={['sp-header', tone === 'dark' && 'sp-header--dark']}>
  {eyebrow && <p class="c-micro c-red">{eyebrow}</p>}
  <h2 class="page-h2">{title}</h2>
  {lede && <p class="c-lede sp-header__lede">{lede}</p>}
</header>
