---
import { processSteps } from '../data/processSteps';

interface Props {
  stepsOnly?: boolean;
}

const { stepsOnly = false } = Astro.props;
---

<section id="process" class="sp-section">
  <div class="c-wrap">
    <div class:list={['sp-process', !stepsOnly && 'sp-process--split']}>
      {!stepsOnly && (
        <div class="sp-process__intro">
          <p class="c-micro c-red">How we work</p>
          <h2 class="page-h2">From messy workflow to live system</h2>
          <p class="c-lede sp-header__lede">
            Whether it is a focused sprint or a full platform build, we follow the same delivery discipline: discover, design, build, integrate, ship, and observe.
          </p>
          <div class="page-hero__actions">
            <a class="c-btn" href="/ai-systems-sprint">14 Day Sprint</a>
            <a class="c-btn c-btn--ghost" href="/engineering-transformation">Full process</a>
          </div>
        </div>
      )}

      <ol class="sp-process__list">
        {processSteps.map((item) => (
          <li class="sp-process__item">
            <span class="sp-process__n" aria-hidden="true">{item.step}</span>
            <div class="sp-process__body">
              <div class="sp-process__titles">
                <h3>{item.title}</h3>
                <p class="c-micro">{item.subtitle}</p>
              </div>
              <p class="c-lede">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
