---
import type { RelatedGroup } from '../data/internalLinks';

interface Props {
  groups: RelatedGroup[];
}

const { groups } = Astro.props;
const visible = groups.filter((g) => g.links.length > 0).slice(0, 3);
---

{visible.length > 0 && (
  <section class="sp-section">
    <div class="c-wrap seo-measure">
      {visible.map((group) => (
        <div class="related-block">
          <h2 class="page-h2">{group.title}</h2>
          <div class="sp-grid" style="margin-top: 20px">
            {group.links.map((link) => (
              <a class="sp-card" href={link.href}>
                <h3 class="sp-card__title">{link.label}</h3>
                {link.description && <p class="c-lede sp-card__body">{link.description}</p>}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
