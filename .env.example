# Google Analytics 4 measurement ID
# Optional override — defaults to G-KHTXT6863D in Layout.astro if unset
PUBLIC_GA_ID=G-KHTXT6863D

# Sanity CMS (server-only reads)
SANITY_PROJECT_ID=bmcdpga9
SANITY_DATASET=production

# Webhook secret for POST /api/revalidate
REVALIDATE_SECRET=change-me-to-a-long-random-string

# Optional Cloudflare cache purge (Cache Purge permission)
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
